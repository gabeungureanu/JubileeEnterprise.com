  "inputs": [
    {
      "id": "ingestSource",
      "type": "promptString",
      "description": "Source directory or file to ingest",
      "default": "${workspaceFolder}/.reactor/inspire_8.0/.pipeline/qdrant"
    },
    {
      "id": "ingestCollection",
      "type": "pickString",
      "description": "Target Qdrant collection for ingestion",
      "options": [
        "inspire_authority_foundation",
        "inspire_canonical_personas",
        "inspire_scripture_core",
        "inspire_theology_systematic",
        "inspire_theology_pastoral",
        "inspire_theology_apologetics"
      ],
      "default": "inspire_authority_foundation"
    },
    {
      "id": "personaId",
      "type": "pickString",
      "description": "Persona to activate or audit",
      "options": [
        "inspire_foundation",
        "inspire_pastor",
        "inspire_teacher",
        "inspire_counselor",
        "inspire_scholar"
      ],
      "default": "inspire_foundation"
    },
    {
      "id": "activationMode",
      "type": "pickString",
      "description": "Activation mode",
      "options": [
        "interactive",
        "single-shot",
        "test"
      ],
      "default": "interactive"
    },
    {
      "id": "auditFormat",
      "type": "pickString",
      "description": "Audit report format",
      "options": [
        "text",
        "json",
        "markdown"
      ],
      "default": "text"
    },
    {
      "id": "doctrineAuditFormat",
      "type": "pickString",
      "description": "Doctrine audit report format",
      "options": [
        "markdown",
        "html",
        "json",
        "text"
      ],
      "default": "markdown"
    }
  ]
}

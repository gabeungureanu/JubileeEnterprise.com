{
  "name": "jubilee-chat",
  "displayName": "JubileeChat",
  "description": "ChatGPT-powered assistant panel with one-click transfer to Claude Code",
  "version": "1.0.8",
  "publisher": "JubileeEnterprise",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jubilee-chat-container",
          "title": "JubileeChat",
          "icon": "resources/chat-icon.svg"
        }
      ]
    },
    "views": {
      "jubilee-chat-container": [
        {
          "type": "webview",
          "id": "jubileeChat.chatPanel",
          "name": "JubileeChat"
        }
      ]
    },
    "commands": [
      {
        "command": "jubileeChat.openPanel",
        "title": "Open JubileeChat Panel"
      },
      {
        "command": "jubileeChat.sendToClaudeCode",
        "title": "Send to Claude Code"
      }
    ],
    "configuration": {
      "title": "JubileeChat",
      "properties": {
        "jubileeChat.model": {
          "type": "string",
          "default": "gpt-4-turbo",
          "description": "OpenAI model to use for chat"
        },
        "jubileeChat.maxTokens": {
          "type": "number",
          "default": 2048,
          "description": "Maximum tokens for response"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npx esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "openai": "^4.77.0"
  }
}

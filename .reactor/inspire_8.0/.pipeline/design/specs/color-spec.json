  "usage": {
    "background": {
      "primary": "neutral.50",
      "secondary": "neutral.100",
      "tertiary": "neutral.200",
      "inverse": "neutral.900"
    },
    "text": {
      "primary": "neutral.900",
      "secondary": "neutral.600",
      "tertiary": "neutral.500",
      "inverse": "neutral.50",
      "link": "primary.600"
    },
    "border": {
      "default": "neutral.200",
      "strong": "neutral.300",
      "focus": "primary.500"
    }
  },
  "accessibility": {
    "min_contrast_ratio": 4.5,
    "large_text_contrast_ratio": 3.0,
    "notes": [
      "All text must meet WCAG 2.1 AA contrast requirements",
      "Primary text on white background must use neutral.900 or darker",
      "Interactive elements must have visible focus states"
    ]
  },
  "requirements": [
    {
      "requirement_id": "color-001",
      "description": "Body text must have minimum 4.5:1 contrast ratio",
      "severity": "error"
    },
    {
      "requirement_id": "color-002",
      "description": "Use semantic colors for status indicators",
      "severity": "warning"
    },
    {
      "requirement_id": "color-003",
      "description": "Do not use color as sole means of conveying information",
      "severity": "error"
    }
  ]

      "900": "#18181b"
    },
    "semantic": {
      "success": {"base": "#22c55e", "light": "#86efac", "dark": "#166534"},
      "warning": {"base": "#f59e0b", "light": "#fcd34d", "dark": "#b45309"},
      "error": {"base": "#ef4444", "light": "#fca5a5", "dark": "#b91c1c"},
      "info": {"base": "#3b82f6", "light": "#93c5fd", "dark": "#1d4ed8"}
    }

  "principles": {
    "clarity": {
      "description": "Design should communicate clearly and reduce cognitive load",
      "guidelines": [
        "Use clear visual hierarchy",
        "Minimize unnecessary decoration",
        "Prioritize readability over aesthetics"
      ]
    },
    "consistency": {
      "description": "Maintain visual consistency across all touchpoints",
      "guidelines": [
        "Use established component patterns",
        "Follow spacing and typography rules",
        "Apply color system uniformly"
      ]
    },
    "accessibility": {
      "description": "Design for all users regardless of ability",
      "guidelines": [
        "Meet WCAG 2.1 AA standards minimum",
        "Ensure sufficient color contrast",
        "Support keyboard navigation",
        "Provide text alternatives for non-text content"
      ]
    },
    "intentionality": {
      "description": "Every design decision should have purpose",
      "guidelines": [
        "Reference specs for all decisions",
        "Document rationale for deviations",
        "Avoid ad hoc or improvised solutions"
      ]
    }
  },
  "design_tokens": {
    "reference": "See typography-spec.json, color-spec.json, spacing-spec.json"
  }
}

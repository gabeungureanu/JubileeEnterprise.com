{
  "spec_id": "component-library",
  "spec_type": "component",
  "name": "Inspire Component Library",
  "description": "Core component definitions, variants, and usage guidelines",
  "version": "1.0.0",
  "created_at": "2026-01-21T00:00:00Z",
  "updated_at": "2026-01-21T00:00:00Z",
  "created_by": "design_governance",
  "source": {
    "collection": "inspire_design_canon",
    "document": "component-library",
    "path": "design/specs/component-spec.json"
  },
  "content_preview": "Core component library with variants, states, and usage guidelines",
  "scope": {
    "applies_to": ["inspire_designer", "inspire_frontend", "inspire_ui"],
    "task_types": ["component_design", "page_design"],
    "components": ["Button", "Input", "Card", "Modal", "Alert", "Badge", "Avatar"]
  },
  "authority": {
    "level": "primary",
    "mandatory": true,
    "supersedes": []
  },
  "status": {
    "current": "active",
    "deprecation_date": "",
    "replacement_spec_id": ""
  },
  "components": {
    "Button": {
      "variants": ["primary", "secondary", "ghost", "destructive"],
      "sizes": ["sm", "md", "lg"],
      "states": ["default", "hover", "active", "disabled", "loading"],
      "requirements": [
        "Must have visible focus state",
        "Loading state must show spinner",
        "Disabled state must have reduced opacity"
      ]
    },
    "Input": {
      "variants": ["default", "error", "success"],
      "sizes": ["sm", "md", "lg"],
      "states": ["default", "focus", "disabled", "readonly", "error"],
      "requirements": [
        "Must have associated label",
        "Error state must show error message",
        "Must support placeholder text"
      ]
    },
    "Card": {
      "variants": ["default", "elevated", "outlined"],
      "parts": ["header", "body", "footer", "media"],
      "requirements": [
        "Must have consistent border-radius",
        "Elevated variant must use shadow-md"
      ]
    },
    "Modal": {
      "variants": ["default", "fullscreen", "drawer"],
      "parts": ["overlay", "container", "header", "body", "footer"],
      "requirements": [
        "Must trap focus within modal",
        "Must close on Escape key",
        "Overlay must have backdrop blur or opacity"
      ]
    },
    "Alert": {
      "variants": ["info", "success", "warning", "error"],
      "parts": ["icon", "title", "description", "action"],
      "requirements": [
        "Must use semantic colors",
        "Must have appropriate icon per variant"
      ]
    }
  },
  "interaction_patterns": {
    "hover": "150ms ease-out transition",
    "focus": "2px offset ring with primary color",
    "active": "Scale 0.98 transform",
    "disabled": "0.5 opacity, cursor not-allowed"
  },
  "requirements": [
    {
      "requirement_id": "comp-001",
      "description": "All interactive components must have visible focus states",
      "severity": "error"
    },
    {
      "requirement_id": "comp-002",
      "description": "Use established component variants, do not create custom variants",
      "severity": "warning"
    },
    {
      "requirement_id": "comp-003",
      "description": "Destructive actions must use destructive variant",
      "severity": "error"
    }
  ]
}

# =============================================================================
# INSPIRE 8.0 PIPELINE - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure with your actual values.
#
# IMPORTANT: Never commit .env to version control. It should contain
# sensitive credentials and environment-specific configuration.
#
# USAGE:
#   cp .env.template .env
#   # Edit .env with your actual values
#   source activate_inspire.sh  # Will load .env automatically
#
# Version: 1.0.0
# =============================================================================

# -----------------------------------------------------------------------------
# INSPIRE ENVIRONMENT
# -----------------------------------------------------------------------------
# Environment identifier (development, staging, production)
INSPIRE_ENV=production

# Pipeline root directory (set automatically by activate_inspire.sh)
# INSPIRE_PIPELINE_DIR=/path/to/.reactor/inspire_8.0/.pipeline

# -----------------------------------------------------------------------------
# QDRANT CONFIGURATION
# Vector database for embeddings and semantic search
# -----------------------------------------------------------------------------
# Qdrant server host (localhost for native installation)
QDRANT_HOST=localhost

# Qdrant REST API port (default: 6333)
QDRANT_PORT=6333

# Qdrant gRPC port (optional, default: 6334)
QDRANT_GRPC_PORT=6334

# Qdrant API key (if authentication is enabled)
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# POSTGRESQL (CODEX DATABASE)
# Primary data storage via InspireCodex API
# -----------------------------------------------------------------------------
# Database host
CODEX_DB_HOST=localhost

# Database port (default: 5432)
CODEX_DB_PORT=5432

# Database name
CODEX_DB_NAME=codex

# Database user
CODEX_DB_USER=

# Database password
CODEX_DB_PASSWORD=

# Connection pool settings
CODEX_DB_POOL_MIN=2
CODEX_DB_POOL_MAX=10

# Alternative naming (both are supported)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=codex
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# INSPIRECODEX API
# Primary API for Codex and Inspire data operations
# -----------------------------------------------------------------------------
# API base URL
INSPIRECODEX_URL=https://www.inspirecodex.com

# API authentication key
INSPIRECODEX_API_KEY=

# API request timeout (seconds)
INSPIRECODEX_TIMEOUT=30

# -----------------------------------------------------------------------------
# INSPIRECONTINUUM API
# API for Continuum database operations
# -----------------------------------------------------------------------------
# API base URL
INSPIRECONTINUUM_URL=https://www.inspirecontinuum.com

# API authentication key
INSPIRECONTINUUM_API_KEY=

# -----------------------------------------------------------------------------
# OPENAI CONFIGURATION
# Embeddings generation and LLM execution
# -----------------------------------------------------------------------------
# OpenAI API key (required for embeddings and GPT models)
OPENAI_API_KEY=

# Organization ID (optional)
OPENAI_ORG_ID=

# Default model for embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Default model for completions
OPENAI_COMPLETION_MODEL=gpt-4o-mini

# Request timeout (seconds)
OPENAI_TIMEOUT=60

# Maximum retries
OPENAI_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log format (json, text)
LOG_FORMAT=text

# Log output directory
LOG_DIR=logs

# Enable structured logging
STRUCTURED_LOGGING=true

# -----------------------------------------------------------------------------
# CACHE CONFIGURATION
# -----------------------------------------------------------------------------
# Cache directory for retrieval caching
CACHE_DIR=cache

# Default cache TTL (seconds)
CACHE_TTL=300

# Maximum cache entries per session
CACHE_MAX_ENTRIES=100

# -----------------------------------------------------------------------------
# BACKUP CONFIGURATION
# -----------------------------------------------------------------------------
# Backup directory
BACKUP_DIR=backups

# Enable automatic backups
AUTO_BACKUP_ENABLED=true

# Backup interval (hours)
BACKUP_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# TOKEN BUDGET CONFIGURATION
# -----------------------------------------------------------------------------
# Enable token budget enforcement
TOKEN_BUDGET_ENABLED=true

# Daily token budget (across all models)
DAILY_TOKEN_BUDGET=500000

# Enable budget alerts
BUDGET_ALERTS_ENABLED=true

# Alert threshold (percentage)
BUDGET_ALERT_THRESHOLD=80

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Enable API authentication
API_AUTH_ENABLED=true

# JWT secret for token signing (generate a secure random value)
JWT_SECRET=

# Token expiration (seconds)
JWT_EXPIRATION=3600

# -----------------------------------------------------------------------------
# DEVELOPMENT/DEBUG
# -----------------------------------------------------------------------------
# Enable debug mode (additional logging, stack traces)
DEBUG=false

# Enable dry run mode (no actual API calls)
DRY_RUN=false

# Enable profiling
PROFILING_ENABLED=false

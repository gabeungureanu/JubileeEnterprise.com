# JubileeSearch.com Environment Configuration

NODE_ENV=development

# Server Port
JUBILEE_SEARCH_PORT=3010

# InspireCodex API
INSPIRE_CODEX_API_URL=https://api.inspirecodex.com

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3010,https://jubileesearch.com

# =============================================================================
# SerpAPI Configuration (Google/Yahoo/Bing search aggregation)
# =============================================================================
SERPAPI_API_KEY=your_serpapi_key_here
SERPAPI_RESULTS_PER_ENGINE=10

# =============================================================================
# Search Ranking Weights (must sum to 1.0)
# =============================================================================
RANKING_RELEVANCE_WEIGHT=0.6
RANKING_SENTIMENT_WEIGHT=0.3
RANKING_POSITION_WEIGHT=0.1

# =============================================================================
# Cache Configuration
# =============================================================================
CACHE_EXPIRATION_HOURS=24

<UserControl x:Class="JubileeFlywheel.Controls.StockChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{StaticResource PrimaryBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Chart Header with Symbol/Resolution -->
            <RowDefinition Height="48"/>
            <!-- Main Chart Area -->
            <RowDefinition Height="*"/>
            <!-- Volume Chart -->
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Chart Header -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Symbol Input with Autocomplete -->
                <Grid Grid.Column="0" Width="160" Margin="0,0,8,0">
                    <TextBox x:Name="SymbolTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding CurrentSymbol, UpdateSourceTrigger=PropertyChanged}"
                             FontWeight="Bold" FontSize="14"
                             VerticalAlignment="Center"
                             KeyDown="SymbolTextBox_KeyDown"
                             TextChanged="SymbolTextBox_TextChanged"
                             GotFocus="SymbolTextBox_GotFocus"
                             LostFocus="SymbolTextBox_LostFocus"/>

                    <!-- Autocomplete Popup -->
                    <Popup x:Name="AutocompletePopup"
                           PlacementTarget="{Binding ElementName=SymbolTextBox}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{StaticResource SecondaryBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                MaxHeight="300" Width="250">
                            <ListBox x:Name="AutocompleteListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource StockListItemStyle}"
                                     SelectionChanged="AutocompleteListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Symbol}"
                                                       FontWeight="Bold" Width="60"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Exchange Display -->
                <Border Grid.Column="1" Background="{StaticResource TertiaryBackgroundBrush}"
                        CornerRadius="4" Padding="8,4" Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="ExchangeText" Text="NASDAQ"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"/>
                </Border>

                <!-- Resolution Selector -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="Res1m" Content="1m" GroupName="Resolution"
                                 Style="{StaticResource NavTabStyle}" Padding="8,4"
                                 IsChecked="True" Checked="Resolution_Checked"/>
                    <RadioButton x:Name="Res5m" Content="5m" GroupName="Resolution"
                                 Style="{StaticResource NavTabStyle}" Padding="8,4"
                                 Checked="Resolution_Checked"/>
                    <RadioButton x:Name="Res15m" Content="15m" GroupName="Resolution"
                                 Style="{StaticResource NavTabStyle}" Padding="8,4"
                                 Checked="Resolution_Checked"/>
                    <RadioButton x:Name="Res1h" Content="1H" GroupName="Resolution"
                                 Style="{StaticResource NavTabStyle}" Padding="8,4"
                                 Checked="Resolution_Checked"/>
                    <RadioButton x:Name="Res4h" Content="4H" GroupName="Resolution"
                                 Style="{StaticResource NavTabStyle}" Padding="8,4"
                                 Checked="Resolution_Checked"/>
                    <RadioButton x:Name="ResD" Content="D" GroupName="Resolution"
                                 Style="{StaticResource NavTabStyle}" Padding="8,4"
                                 Checked="Resolution_Checked"/>
                    <RadioButton x:Name="ResW" Content="W" GroupName="Resolution"
                                 Style="{StaticResource NavTabStyle}" Padding="8,4"
                                 Checked="Resolution_Checked"/>
                </StackPanel>

                <!-- Price Info Panel -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left"
                            Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="OpenLabel" Text="O:" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,2,0"/>
                    <TextBlock x:Name="OpenValue" Text="0.00" FontSize="11"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0"/>

                    <TextBlock x:Name="HighLabel" Text="H:" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,2,0"/>
                    <TextBlock x:Name="HighValue" Text="0.00" FontSize="11"
                               Foreground="{StaticResource BullishBrush}" Margin="0,0,12,0"/>

                    <TextBlock x:Name="LowLabel" Text="L:" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,2,0"/>
                    <TextBlock x:Name="LowValue" Text="0.00" FontSize="11"
                               Foreground="{StaticResource BearishBrush}" Margin="0,0,12,0"/>

                    <TextBlock x:Name="CloseLabel" Text="C:" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,2,0"/>
                    <TextBlock x:Name="CloseValue" Text="0.00" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0"/>

                    <TextBlock x:Name="ChangeValue" Text="+0.00%" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BullishBrush}"/>
                </StackPanel>

                <!-- Chart Tools -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Indicators" Click="IndicatorsButton_Click">
                        <TextBlock Text="{StaticResource IconShowChart}"
                                   FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Zoom In" Click="ZoomInButton_Click">
                        <TextBlock Text="{StaticResource IconZoomIn}"
                                   FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Zoom Out" Click="ZoomOutButton_Click">
                        <TextBlock Text="{StaticResource IconZoomOut}"
                                   FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Reset View" Click="ResetViewButton_Click">
                        <TextBlock Text="{StaticResource IconRefresh}"
                                   FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Fullscreen" Click="FullscreenButton_Click">
                        <TextBlock Text="{StaticResource IconFullscreen}"
                                   FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Price Chart -->
        <Grid Grid.Row="1">
            <lvc:CartesianChart x:Name="PriceChart"
                                ZoomMode="X"
                                TooltipPosition="Hidden"
                                MouseMove="PriceChart_MouseMove"
                                MouseWheel="PriceChart_MouseWheel"/>

            <!-- Crosshair -->
            <Canvas x:Name="CrosshairCanvas" IsHitTestVisible="False">
                <Line x:Name="CrosshairVertical" Stroke="#40FFFFFF" StrokeThickness="1"
                      StrokeDashArray="2,2" Visibility="Collapsed"/>
                <Line x:Name="CrosshairHorizontal" Stroke="#40FFFFFF" StrokeThickness="1"
                      StrokeDashArray="2,2" Visibility="Collapsed"/>
                <Border x:Name="PriceLabel" Background="{StaticResource GoldBrandBrush}"
                        CornerRadius="2" Padding="4,2" Visibility="Collapsed">
                    <TextBlock x:Name="PriceLabelText" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBackgroundBrush}"/>
                </Border>
            </Canvas>

            <!-- Loading Indicator -->
            <Border x:Name="LoadingOverlay" Background="#80000000" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="4"
                                 Foreground="{StaticResource GoldBrandBrush}"/>
                    <TextBlock Text="Loading data..." Margin="0,8,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Volume Chart -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <lvc:CartesianChart x:Name="VolumeChart"
                                ZoomMode="X"
                                TooltipPosition="Hidden"/>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="JubileeFlywheel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JubileeFlywheel"
        xmlns:views="clr-namespace:JubileeFlywheel.Views"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="Jubilee Flywheel - Data Visualization Dashboard"
        Height="900" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="J" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource JubileeAccentBrush}"
                               Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Jubilee Flywheel" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Data Visualization Dashboard" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="DashboardTab" Content="Dashboard"
                                 Style="{StaticResource NavTabStyle}" IsChecked="True"
                                 Checked="NavTab_Checked"/>
                    <RadioButton x:Name="DataGridTab" Content="Data Grid"
                                 Style="{StaticResource NavTabStyle}"
                                 Checked="NavTab_Checked"/>
                    <RadioButton x:Name="ApiConfigTab" Content="API Config"
                                 Style="{StaticResource NavTabStyle}"
                                 Checked="NavTab_Checked"/>
                    <RadioButton x:Name="SettingsTab" Content="Settings"
                                 Style="{StaticResource NavTabStyle}"
                                 Checked="NavTab_Checked"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Refresh" Click="RefreshButton_Click" Margin="0,0,8,0"
                            ToolTip="Refresh all data"/>
                    <Button Content="Add Widget" Click="AddWidgetButton_Click"
                            ToolTip="Add a new widget to the dashboard"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Dashboard View -->
            <views:DashboardView x:Name="DashboardViewControl"
                                 Visibility="Visible"/>

            <!-- Data Grid View -->
            <views:DataGridView x:Name="DataGridViewControl"
                                Visibility="Collapsed"/>

            <!-- API Config View -->
            <views:ApiConfigView x:Name="ApiConfigViewControl"
                                 Visibility="Collapsed"/>

            <!-- Settings View -->
            <views:SettingsView x:Name="SettingsViewControl"
                                Visibility="Collapsed"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="v1.0.0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="16,0"/>

                <TextBlock x:Name="ClockText" Grid.Column="2"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

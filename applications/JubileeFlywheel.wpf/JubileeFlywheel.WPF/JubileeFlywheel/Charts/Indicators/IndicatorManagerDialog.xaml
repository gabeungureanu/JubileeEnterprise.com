<Window x:Class="JubileeFlywheel.Charts.Indicators.IndicatorManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Indicator Manager"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="CanResize"
        MinWidth="500" MinHeight="400">

    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078D4"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="DialogButton">
            <Setter Property="Background" Value="#3D3D3D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4D4D4D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1084D8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Available Indicators -->
            <GroupBox Grid.Column="0" Header="Available Indicators"
                      BorderBrush="#555555" Foreground="#E0E0E0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="CategoryCombo" Grid.Row="0" Margin="0,0,0,8"
                              Background="#2D2D2D" Foreground="#E0E0E0"
                              SelectionChanged="CategoryCombo_SelectionChanged">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Trend"/>
                        <ComboBoxItem Content="Momentum"/>
                        <ComboBoxItem Content="Volatility"/>
                        <ComboBoxItem Content="Volume"/>
                    </ComboBox>

                    <ListBox x:Name="AvailableIndicatorsList" Grid.Row="1"
                             Background="#2D2D2D" BorderBrush="#555555"
                             MouseDoubleClick="AvailableIndicatorsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="#888888" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- Add/Remove Buttons -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8">
                <Button Content="Add" Width="70" Margin="0,4"
                        Style="{StaticResource DialogButton}"
                        Click="AddButton_Click"/>
                <Button Content="Remove" Width="70" Margin="0,4"
                        Style="{StaticResource DialogButton}"
                        Click="RemoveButton_Click"/>
            </StackPanel>

            <!-- Active Indicators -->
            <GroupBox Grid.Column="2" Header="Active Indicators"
                      BorderBrush="#555555" Foreground="#E0E0E0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="ActiveIndicatorsList" Grid.Row="0"
                             Background="#2D2D2D" BorderBrush="#555555"
                             SelectionChanged="ActiveIndicatorsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ShortName}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Parameter Editor -->
                    <Border Grid.Row="1" Background="#252525"
                            BorderBrush="#555555" BorderThickness="1"
                            Margin="0,8,0,0" Padding="8"
                            Visibility="{Binding ParameterVisibility}">
                        <StackPanel x:Name="ParameterPanel"/>
                    </Border>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Dialog Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80"
                    Style="{StaticResource PrimaryButton}"
                    Click="OkButton_Click"/>
            <Button Content="Cancel" Width="80"
                    Style="{StaticResource DialogButton}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

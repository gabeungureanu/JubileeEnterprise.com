<UserControl x:Class="JubileeFlywheel.Views.ApiConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JubileeFlywheel.Views"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="{StaticResource BgPrimaryBrush}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Endpoints List -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="API Endpoints"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16"/>

                <ListBox x:Name="EndpointsList" Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="EndpointsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="0,2"
                                    Background="{StaticResource BgTertiaryBrush}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Url}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="4,0"
                                                 Fill="{Binding IsEnabled, Converter={StaticResource BoolToColorConverter}}"/>
                                        <Button Content="X" Width="24" Height="24"
                                                Padding="0" Margin="4,0,0,0"
                                                Click="DeleteEndpointButton_Click"
                                                Tag="{Binding}"
                                                ToolTip="Delete endpoint"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2" Content="+ Add Endpoint"
                        Margin="0,16,0,0"
                        Click="AddEndpointButton_Click"/>
            </Grid>
        </Border>

        <!-- Endpoint Editor -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid x:Name="EditorPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Endpoint Configuration"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16"/>

                <!-- Name -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Name" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="NameTextBox"/>
                </StackPanel>

                <!-- URL and Method -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Method" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="MethodComboBox" Width="100">
                            <ComboBoxItem Content="GET" IsSelected="True"/>
                            <ComboBoxItem Content="POST"/>
                            <ComboBoxItem Content="PUT"/>
                            <ComboBoxItem Content="PATCH"/>
                            <ComboBoxItem Content="DELETE"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="URL" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="UrlTextBox"/>
                    </StackPanel>
                </Grid>

                <!-- Refresh Interval -->
                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock Text="Auto-refresh Interval (seconds)"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="RefreshIntervalTextBox" Text="30" Width="100"
                             HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Headers -->
                <StackPanel Grid.Row="4" Margin="0,0,0,12">
                    <TextBlock Text="Headers (one per line: Header-Name: value)"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="HeadersTextBox" Height="80"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Body -->
                <StackPanel Grid.Row="5" Margin="0,0,0,12">
                    <TextBlock Text="Request Body (JSON)"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="BodyTextBox" Height="100"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" FontFamily="Consolas"/>
                </StackPanel>

                <!-- Test Result -->
                <Border Grid.Row="6" Background="{StaticResource BgTertiaryBrush}"
                        CornerRadius="4" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TestResultText"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas" FontSize="12"/>
                    </ScrollViewer>
                </Border>

                <!-- Test Button -->
                <Button Grid.Row="7" Content="Test Connection"
                        Margin="0,12,0,0"
                        Click="TestConnectionButton_Click"/>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="8" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancel" Margin="0,0,8,0"
                            Click="CancelButton_Click"/>
                    <Button Content="Save" Click="SaveButton_Click"/>
                </StackPanel>
                </Grid>

                <!-- Empty State -->
                <Border x:Name="EditorEmptyState">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Select an endpoint to edit"
                                   FontSize="18"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="or click 'Add Endpoint' to create a new one"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Resources>
        <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </UserControl.Resources>
</UserControl>

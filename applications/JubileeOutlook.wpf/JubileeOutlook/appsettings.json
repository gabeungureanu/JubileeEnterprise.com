{
  "AppSettings": {
    "Environment": "Production",
    "Version": "1.5.0"
  },
  "Api": {
    "InspireContinuum": {
      "BaseUrl": "https://inspirecontinuum.com/api",
      "Timeout": 30,
      "RetryCount": 3,
      "RetryDelayMs": 1000
    },
    "InspireCodex": {
      "BaseUrl": "https://inspirecodex.com/api",
      "Timeout": 30,
      "RetryCount": 3,
      "RetryDelayMs": 1000
    },
    "Auth": {
      "BaseUrl": "https://inspirecodex.com/api/auth",
      "Timeout": 30,
      "TokenRefreshBufferMinutes": 5
    },
    "RetryPolicy": {
      "MaxRetries": 3,
      "InitialDelayMs": 500,
      "MaxDelayMs": 30000,
      "EnableExponentialBackoff": true
    }
  },
  "Features": {
    "EnableDatabaseIntegration": true,
    "EnableOfflineMode": false,
    "EnableDebugLogging": false,
    "EnableTelemetry": true
  },
  "Storage": {
    "LocalDataPath": "%LOCALAPPDATA%\\JubileeOutlook",
    "CacheExpirationMinutes": 60,
    "MaxCacheSizeMb": 100
  }
}

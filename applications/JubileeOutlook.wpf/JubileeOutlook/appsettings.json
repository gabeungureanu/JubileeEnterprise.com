{
  "AppSettings": {
    "Environment": "Development",
    "Version": "1.5.0"
  },
  "OAuth2": {
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "http://localhost:8890/oauth2callback"
    },
    "Microsoft": {
      "ClientId": "",
      "TenantId": "common",
      "RedirectUri": "http://localhost:8891/oauth2callback"
    },
    "Yahoo": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "http://localhost:8892/oauth2callback"
    }
  },
  "Api": {
    "InspireContinuum": {
      "BaseUrl": "http://localhost:3101/api/v1",
      "Timeout": 30,
      "RetryCount": 3,
      "RetryDelayMs": 1000
    },
    "InspireCodex": {
      "BaseUrl": "http://localhost:3100/api/v1",
      "Timeout": 30,
      "RetryCount": 3,
      "RetryDelayMs": 1000
    },
    "Auth": {
      "BaseUrl": "http://localhost:3100/api/auth",
      "Timeout": 30,
      "TokenRefreshBufferMinutes": 5
    },
    "RetryPolicy": {
      "MaxRetries": 3,
      "InitialDelayMs": 500,
      "MaxDelayMs": 30000,
      "EnableExponentialBackoff": true
    }
  },
  "Features": {
    "EnableDatabaseIntegration": true,
    "EnableOfflineMode": false,
    "EnableDebugLogging": true,
    "EnableTelemetry": true
  },
  "Storage": {
    "LocalDataPath": "%LOCALAPPDATA%\\JubileeOutlook",
    "CacheExpirationMinutes": 60,
    "MaxCacheSizeMb": 100
  },
  "LocalCache": {
    "ConnectionString": "Host=localhost;Port=5432;Database=jubilee_outlook_cache;Username=jubilee_user;Password=Pass@123",
    "EnableOfflineMode": true,
    "SyncIntervalSeconds": 300,
    "MaxCacheAgeDays": 30,
    "MaxRetryAttempts": 3,
    "ConnectionPoolSize": 10
  }
}

<UserControl x:Class="JubileeOutlook.Views.PeopleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:JubileeOutlook.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{StaticResource PrimaryBackgroundBrush}">

    <UserControl.DataContext>
        <viewmodels:PeopleViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Folder Item Style - Using Jubilee Gold theme -->
        <Style x:Key="FolderItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldHighlightHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar Button Style -->
        <Style x:Key="PeopleToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- New Contact Button Style (Gold) -->
        <Style x:Key="NewContactButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GoldBrandBrush}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="12,12,12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldBrandHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#e5a94d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown Button Style (Gold) -->
        <Style x:Key="DropdownButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource GoldBrandBrush}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="0,4,4,0"
                                BorderBrush="#00000040" BorderThickness="1,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldBrandHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#e5a94d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Expander Style for Categories -->
        <Style x:Key="CategoryExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0" Padding="12,8" Cursor="Hand"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Arrow" Text="&#xe5cf;" FontFamily="{StaticResource MaterialIcons}"
                                                           FontSize="16" Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="24,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Toolbar/Ribbon -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar - Action Ribbon (tabs moved to MainWindow title bar) -->
        <Border Grid.Row="0" Background="{StaticResource RibbonBackgroundBrush}" BorderBrush="{StaticResource RibbonBorderBrush}" BorderThickness="0,1,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <!-- New Contact Button with Dropdown (Gold theme) -->
                <Grid Margin="4,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding NewContactCommand}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{StaticResource GoldBrandBrush}" Padding="12,6" CornerRadius="4,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xe7fe;" FontFamily="{StaticResource MaterialIcons}"
                                                   FontSize="16" Foreground="#000000" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="New contact" FontSize="13" Foreground="#000000"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldBrandHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#e5a94d"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ToggleButton x:Name="NewContactDropdownButton" Grid.Column="1" Style="{StaticResource DropdownButtonStyle}">
                        <TextBlock Text="&#xe5cf;" FontFamily="{StaticResource MaterialIcons}" FontSize="14" Foreground="#000000"/>
                    </ToggleButton>
                    <!-- Dropdown Popup -->
                    <Popup x:Name="NewContactDropdownPopup"
                           IsOpen="{Binding IsChecked, ElementName=NewContactDropdownButton}"
                           PlacementTarget="{Binding ElementName=NewContactDropdownButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{StaticResource TertiaryBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4">
                            <StackPanel MinWidth="180">
                                <!-- New Contact -->
                                <Button Command="{Binding NewContactCommand}"
                                        Click="DropdownMenuItem_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="12,8"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Left">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xe7fe;" FontFamily="{StaticResource MaterialIcons}"
                                                               FontSize="16" Foreground="{StaticResource SecondaryTextBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBlock Text="New contact" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Separator -->
                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="8,4"/>

                                <!-- Import Contacts -->
                                <Button Command="{Binding ImportContactsCommand}"
                                        Click="DropdownMenuItem_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="12,8"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Left">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xe2c4;" FontFamily="{StaticResource MaterialIcons}"
                                                               FontSize="16" Foreground="{StaticResource SecondaryTextBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBlock Text="Import contacts" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Export Contacts -->
                                <Button Command="{Binding ExportContactsCommand}"
                                        Click="DropdownMenuItem_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="12,8"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Left">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xe2c6;" FontFamily="{StaticResource MaterialIcons}"
                                                               FontSize="16" Foreground="{StaticResource SecondaryTextBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBlock Text="Export contacts" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Separator -->
                <Rectangle Width="1" Height="28" Fill="#444444" Margin="8,0"/>

                <!-- Edit Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}"
                        Command="{Binding EditContactCommand}"
                        IsEnabled="{Binding SelectedContact, Converter={StaticResource NullToBoolConverter}}"
                        ToolTip="Edit" Margin="4,0">
                    <TextBlock Text="&#xe150;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Delete Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}"
                        Command="{Binding DeleteContactCommand}"
                        IsEnabled="{Binding SelectedContact, Converter={StaticResource NullToBoolConverter}}"
                        ToolTip="Delete" Margin="4,0">
                    <TextBlock Text="&#xe872;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Height="28" Fill="#444444" Margin="8,0"/>

                <!-- Email Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}"
                        Command="{Binding EmailContactCommand}"
                        IsEnabled="{Binding SelectedContact, Converter={StaticResource NullToBoolConverter}}"
                        ToolTip="Email" Margin="4,0">
                    <TextBlock Text="&#xe158;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Chat Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}"
                        Command="{Binding ChatContactCommand}"
                        IsEnabled="{Binding SelectedContact, Converter={StaticResource NullToBoolConverter}}"
                        ToolTip="Chat" Margin="4,0">
                    <TextBlock Text="&#xe0b7;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Call Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}"
                        Command="{Binding CallContactCommand}"
                        IsEnabled="{Binding SelectedContact, Converter={StaticResource NullToBoolConverter}}"
                        ToolTip="Call" Margin="4,0">
                    <TextBlock Text="&#xe0cd;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Share as vCard Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}"
                        Command="{Binding ShareAsVCardCommand}"
                        IsEnabled="{Binding SelectedContact, Converter={StaticResource NullToBoolConverter}}"
                        ToolTip="Share as vCard" Margin="4,0">
                    <TextBlock Text="&#xe169;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Height="28" Fill="#444444" Margin="8,0"/>

                <!-- Add to Favorites Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}"
                        Command="{Binding AddToFavoritesCommand}"
                        IsEnabled="{Binding SelectedContact, Converter={StaticResource NullToBoolConverter}}"
                        ToolTip="Add to favorites" Margin="4,0">
                    <TextBlock Text="&#xe838;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Add Category Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding AddCategoryCommand}"
                        ToolTip="Add category" Margin="4,0">
                    <TextBlock Text="&#xe892;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Height="28" Fill="#444444" Margin="8,0"/>

                <!-- Import Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding ImportContactsCommand}"
                        ToolTip="Import" Margin="4,0">
                    <TextBlock Text="&#xe2c4;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Export Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding ExportContactsCommand}"
                        ToolTip="Export" Margin="4,0">
                    <TextBlock Text="&#xe2c6;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Separator (only visible in Deleted folder) -->
                <Rectangle Width="1" Height="28" Fill="#444444" Margin="8,0"
                           Visibility="{Binding IsInDeletedFolder, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Empty Deleted Folder Button (only visible in Deleted folder) -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding EmptyDeletedFolderCommand}"
                        ToolTip="Empty deleted folder" Margin="4,0"
                        Visibility="{Binding IsInDeletedFolder, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xe92b;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                    </StackPanel>
                </Button>

                <!-- Restore Button (only visible in Deleted folder with selection) -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding RestoreContactCommand}"
                        ToolTip="Restore contact" Margin="4,0"
                        Visibility="{Binding IsInDeletedFolder, Converter={StaticResource BoolToVisibilityConverter}}"
                        IsEnabled="{Binding SelectedContact, Converter={StaticResource NullToBoolConverter}}">
                    <TextBlock Text="&#xe929;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Bulk Actions Section (only visible when multiple contacts are selected) -->
                <Rectangle Width="1" Height="28" Fill="#444444" Margin="8,0"
                           Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Selection Count Indicator -->
                <Border Background="#3D3D5C" CornerRadius="4" Padding="8,4" Margin="4,0"
                        Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock FontSize="12" Foreground="{StaticResource GoldBrandBrush}">
                        <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                        <Run Text=" selected"/>
                    </TextBlock>
                </Border>

                <!-- Bulk Delete Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding BulkDeleteCommand}"
                        ToolTip="Delete selected contacts" Margin="4,0"
                        Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="&#xe872;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Bulk Add to Favorites Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding BulkAddToFavoritesCommand}"
                        ToolTip="Add selected to favorites" Margin="4,0"
                        Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="&#xe838;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Bulk Add Category Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding BulkAddCategoryCommand}"
                        ToolTip="Set category for selected" Margin="4,0"
                        Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="&#xe892;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>

                <!-- Bulk Export Button -->
                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding BulkExportCommand}"
                        ToolTip="Export selected contacts" Margin="4,0"
                        Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="&#xe2c6;" FontFamily="{StaticResource MaterialIcons}" FontSize="24"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar - Folders -->
                <ColumnDefinition Width="280"/>
                <!-- Main Content - Contacts List -->
                <ColumnDefinition Width="*" MinWidth="300"/>
                <!-- Contact Details Panel - Auto width so it collapses when hidden -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Account Header -->
                    <Expander Grid.Row="0" IsExpanded="True" Style="{StaticResource CategoryExpanderStyle}">
                        <Expander.Header>
                            <TextBlock Text="{Binding UserEmail}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"/>
                        </Expander.Header>
                        <StackPanel>
                            <!-- Folder List -->
                            <ListBox ItemsSource="{Binding Folders}"
                                     SelectedItem="{Binding SelectedFolder}"
                                     Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource FolderItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource MaterialIcons}"
                                                       FontSize="18" Foreground="{StaticResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Expander>

                    <!-- Categories Section -->
                    <Expander Grid.Row="1" IsExpanded="True" Style="{StaticResource CategoryExpanderStyle}"
                              VerticalAlignment="Top" Margin="0,8,0,0">
                        <Expander.Header>
                            <TextBlock Text="Categories" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <!-- Empty state placeholder -->
                            <TextBlock Text="When you create categories, they will appear here."
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" Padding="12,4"
                                       Visibility="{Binding Categories.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                            <!-- Categories list -->
                            <ListBox ItemsSource="{Binding Categories}"
                                     SelectedItem="{Binding SelectedCategory}"
                                     Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource FolderItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#3D3D5C" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding}" FontSize="10"
                                                           Foreground="{StaticResource GoldBrandBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding}" FontSize="13"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Border Grid.Column="1" Background="{StaticResource PrimaryBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Search Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Content -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Content Header with Sort -->
                    <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ContentHeader, FallbackValue='Your contacts'}"
                                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>

                            <!-- Sort Dropdown -->
                            <Grid Grid.Column="1">
                                <ToggleButton x:Name="SortDropdownButton"
                                              Background="Transparent" BorderThickness="0" Padding="8,4" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xe164;" FontFamily="{StaticResource MaterialIcons}"
                                                               FontSize="16" Foreground="{StaticResource SecondaryTextBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding SortOptionDisplayText}" FontSize="12"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="&#xe5cf;" FontFamily="{StaticResource MaterialIcons}"
                                                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- Sort Dropdown Popup -->
                                <Popup IsOpen="{Binding IsChecked, ElementName=SortDropdownButton}"
                                       PlacementTarget="{Binding ElementName=SortDropdownButton}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="{StaticResource TertiaryBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="4" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="8" ShadowDepth="2"/>
                                        </Border.Effect>
                                        <StackPanel MinWidth="160">
                                            <!-- Name A-Z -->
                                            <Button Command="{Binding SetSortOptionCommand}" CommandParameter="{x:Static viewmodels:ContactSortOption.NameAscending}"
                                                    Click="SortMenuItem_Click" Background="Transparent" BorderThickness="0"
                                                    Padding="12,8" Cursor="Hand" HorizontalContentAlignment="Left">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xe5d8;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                                                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                <TextBlock Text="Name (A-Z)" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- Name Z-A -->
                                            <Button Command="{Binding SetSortOptionCommand}" CommandParameter="{x:Static viewmodels:ContactSortOption.NameDescending}"
                                                    Click="SortMenuItem_Click" Background="Transparent" BorderThickness="0"
                                                    Padding="12,8" Cursor="Hand" HorizontalContentAlignment="Left">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xe5db;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                                                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                <TextBlock Text="Name (Z-A)" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- Separator -->
                                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="8,4"/>
                                            <!-- Company A-Z -->
                                            <Button Command="{Binding SetSortOptionCommand}" CommandParameter="{x:Static viewmodels:ContactSortOption.CompanyAscending}"
                                                    Click="SortMenuItem_Click" Background="Transparent" BorderThickness="0"
                                                    Padding="12,8" Cursor="Hand" HorizontalContentAlignment="Left">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xe0af;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                                                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                <TextBlock Text="Company (A-Z)" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- Company Z-A -->
                                            <Button Command="{Binding SetSortOptionCommand}" CommandParameter="{x:Static viewmodels:ContactSortOption.CompanyDescending}"
                                                    Click="SortMenuItem_Click" Background="Transparent" BorderThickness="0"
                                                    Padding="12,8" Cursor="Hand" HorizontalContentAlignment="Left">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xe0af;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                                                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                <TextBlock Text="Company (Z-A)" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- Separator -->
                                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="8,4"/>
                                            <!-- Date Added (Newest) -->
                                            <Button Command="{Binding SetSortOptionCommand}" CommandParameter="{x:Static viewmodels:ContactSortOption.DateAddedNewest}"
                                                    Click="SortMenuItem_Click" Background="Transparent" BorderThickness="0"
                                                    Padding="12,8" Cursor="Hand" HorizontalContentAlignment="Left">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xe8df;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                                                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                <TextBlock Text="Date Added (Newest)" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- Date Added (Oldest) -->
                                            <Button Command="{Binding SetSortOptionCommand}" CommandParameter="{x:Static viewmodels:ContactSortOption.DateAddedOldest}"
                                                    Click="SortMenuItem_Click" Background="Transparent" BorderThickness="0"
                                                    Padding="12,8" Cursor="Hand" HorizontalContentAlignment="Left">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xe8df;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                                                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                <TextBlock Text="Date Added (Oldest)" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Search Bar -->
                    <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="12,8">
                        <Border Background="#252525" CornerRadius="6" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Search Icon -->
                                <TextBlock Grid.Column="0" Text="&#xe8b6;" FontFamily="{StaticResource MaterialIcons}"
                                           FontSize="18" Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" Margin="4,0,8,0"/>
                                <!-- Search TextBox -->
                                <Grid Grid.Column="1">
                                    <TextBlock Text="Search contacts..." FontSize="13"
                                               Foreground="#666666" VerticalAlignment="Center"
                                               Visibility="{Binding SearchText, Converter={StaticResource InverseStringToVisibilityConverter}}"
                                               IsHitTestVisible="False"/>
                                    <TextBox x:Name="SearchTextBox"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource PrimaryTextBrush}"
                                             FontSize="13" VerticalAlignment="Center"
                                             CaretBrush="{StaticResource AccentBrush}"/>
                                </Grid>
                                <!-- Clear Button -->
                                <Button Grid.Column="2" x:Name="ClearSearchButton"
                                        Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}}"
                                        Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                                        Click="ClearSearchButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                <TextBlock Text="&#xe5cd;" FontFamily="{StaticResource MaterialIcons}"
                                                           FontSize="16" Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Contacts Content -->
                    <Grid Grid.Row="2">
                        <!-- Empty State (when no contacts) -->
                        <StackPanel Visibility="{Binding HasContacts, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Contact Book Illustration -->
                            <Border Width="120" Height="120" Margin="0,0,0,24">
                                <Grid>
                                    <!-- Book base -->
                                    <Border Background="#3D3D5C" CornerRadius="8" Width="100" Height="110"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="2"/>
                                        </Border.Effect>
                                    </Border>
                                    <!-- Book spine -->
                                    <Border Background="#5C5C8A" CornerRadius="8,0,0,8" Width="20" Height="110"
                                            HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <!-- Book pages effect -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="30,20,0,0">
                                        <Rectangle Width="3" Height="70" Fill="#666" RadiusX="1" RadiusY="1" Margin="0,0,4,0"/>
                                        <Rectangle Width="3" Height="70" Fill="#555" RadiusX="1" RadiusY="1" Margin="0,0,4,0"/>
                                        <Rectangle Width="3" Height="70" Fill="#444" RadiusX="1" RadiusY="1"/>
                                    </StackPanel>
                                    <!-- Contact avatar circle -->
                                    <Ellipse Width="40" Height="40" Fill="#FFB366"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0,0,15,15">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="5" ShadowDepth="1"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="&#xe7fd;" FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="24" Foreground="#8B5A00"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               Margin="0,0,23,21"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="You haven't added any contacts yet"
                                       FontSize="16" Foreground="{StaticResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

                            <Button Command="{Binding NewContactCommand}" Cursor="Hand" HorizontalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock x:Name="Link" Text="New contact" FontSize="14"
                                                   Foreground="{StaticResource GoldBrandBrush}" Cursor="Hand"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Link" Property="TextDecorations" Value="Underline"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Contacts List (when has contacts) -->
                        <ListBox x:Name="ContactsListBox"
                                 Visibility="{Binding HasContacts, Converter={StaticResource BoolToVisibilityConverter}}"
                                 ItemsSource="{Binding FilteredContacts}"
                                 SelectedItem="{Binding SelectedContact}"
                                 SelectionMode="Extended"
                                 SelectionChanged="ContactsListBox_SelectionChanged"
                                 Background="Transparent" BorderThickness="0"
                                 MouseDoubleClick="ContactsListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar (Shows profile picture if available, otherwise gold initials) -->
                                        <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0">
                                            <!-- Default Avatar with Initials (shown when no photo) -->
                                            <Ellipse Fill="{StaticResource GoldBrandBrush}"
                                                     Visibility="{Binding AvatarPath, Converter={StaticResource InverseStringToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Initials}"
                                                       FontSize="14" FontWeight="SemiBold" Foreground="#1E1E1E"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding AvatarPath, Converter={StaticResource InverseStringToVisibilityConverter}}"/>

                                            <!-- Profile Picture (shown when photo is uploaded) -->
                                            <Ellipse Visibility="{Binding AvatarPath, Converter={StaticResource StringToVisibilityConverter}}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>

                                        <!-- Contact Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center"/>
                                                <!-- Category Badge -->
                                                <Border Background="#3D3D5C" CornerRadius="3" Padding="6,2" Margin="8,0,0,0"
                                                        Visibility="{Binding Category, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Category}" FontSize="10"
                                                               Foreground="{StaticResource GoldBrandBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Email}" FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Contact Details Panel (Right Side) -->
            <Border Grid.Column="2" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1,0,0,0"
                    Width="380"
                    Visibility="{Binding SelectedContact, Converter={StaticResource NullToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24">
                        <!-- Contact Header with Avatar -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,16,0,24">
                            <!-- Large Avatar -->
                            <Grid Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <!-- Default Avatar with Initials -->
                                <Ellipse Fill="{StaticResource GoldBrandBrush}"
                                         Visibility="{Binding SelectedContact.AvatarPath, Converter={StaticResource InverseStringToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding SelectedContact.Initials}"
                                           FontSize="36" FontWeight="SemiBold" Foreground="#1E1E1E"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding SelectedContact.AvatarPath, Converter={StaticResource InverseStringToVisibilityConverter}}"/>
                                <!-- Profile Picture -->
                                <Ellipse Visibility="{Binding SelectedContact.AvatarPath, Converter={StaticResource StringToVisibilityConverter}}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding SelectedContact.AvatarPath}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <!-- Display Name -->
                            <TextBlock Text="{Binding SelectedContact.DisplayName}"
                                       FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

                            <!-- Job Title and Company -->
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="14" HorizontalAlignment="Center" TextAlignment="Center"
                                       Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}{0}{1}{2}">
                                                    <Binding Path="SelectedContact.JobTitle"/>
                                                    <Binding Path="SelectedContact.Company" Converter="{StaticResource StringToPrefixConverter}" ConverterParameter=" at "/>
                                                    <Binding Path="SelectedContact.Company"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Category Badge -->
                            <Border Background="#3D3D5C" CornerRadius="4" Padding="12,4" Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding SelectedContact.Category, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="{Binding SelectedContact.Category}" FontSize="12"
                                           Foreground="{StaticResource GoldBrandBrush}"/>
                            </Border>

                            <!-- Favorite Star -->
                            <TextBlock Text="&#xe838;" FontFamily="{StaticResource MaterialIcons}"
                                       FontSize="20" Foreground="{StaticResource GoldBrandBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"
                                       Visibility="{Binding SelectedContact.IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"
                                       ToolTip="Favorite contact"/>
                        </StackPanel>

                        <!-- Quick Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Button Style="{StaticResource PeopleToolbarButtonStyle}" Command="{Binding EmailContactCommand}"
                                    ToolTip="Send email" Margin="4,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xe158;" FontFamily="{StaticResource MaterialIcons}" FontSize="18"
                                               Foreground="{StaticResource GoldBrandBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Email" Margin="6,0,0,0" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PeopleToolbarButtonStyle}" Command="{Binding EditContactCommand}"
                                    ToolTip="Edit contact" Margin="4,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xe254;" FontFamily="{StaticResource MaterialIcons}" FontSize="18"
                                               Foreground="{StaticResource GoldBrandBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Edit" Margin="6,0,0,0" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Contact Information Sections -->
                        <StackPanel>
                            <!-- Email Section -->
                            <StackPanel Visibility="{Binding SelectedContact.Email, Converter={StaticResource StringToVisibilityConverter}}"
                                        Margin="0,0,0,16">
                                <TextBlock Text="EMAIL" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="&#xe158;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedContact.Email}" FontSize="14"
                                                   Foreground="{StaticResource GoldBrandBrush}" Cursor="Hand"/>
                                        <TextBlock Text="Work" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Personal Email -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding SelectedContact.PersonalEmail, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="&#xe158;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedContact.PersonalEmail}" FontSize="14"
                                                   Foreground="{StaticResource GoldBrandBrush}" Cursor="Hand"/>
                                        <TextBlock Text="Personal" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Phone Section -->
                            <StackPanel Visibility="{Binding SelectedContact.Phone, Converter={StaticResource StringToVisibilityConverter}}"
                                        Margin="0,0,0,16">
                                <TextBlock Text="PHONE" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="&#xe0cd;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedContact.Phone}" FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Work" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Mobile Phone -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding SelectedContact.MobilePhone, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="&#xe325;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedContact.MobilePhone}" FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Mobile" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Home Phone -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding SelectedContact.HomePhone, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="&#xe88a;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedContact.HomePhone}" FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Home" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Work Section -->
                            <StackPanel Margin="0,0,0,16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedContact.Company, Converter={StaticResource StringToBoolConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedContact.Department, Converter={StaticResource StringToBoolConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedContact.Office, Converter={StaticResource StringToBoolConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="WORK" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                            Visibility="{Binding SelectedContact.Company, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="&#xe0af;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedContact.Company}" FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Company" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding SelectedContact.Department, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="&#xe7ef;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedContact.Department}" FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Department" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding SelectedContact.Office, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="&#xe8b0;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedContact.Office}" FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Office" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Address Section -->
                            <StackPanel Visibility="{Binding SelectedContact.Address, Converter={StaticResource StringToVisibilityConverter}}"
                                        Margin="0,0,0,16">
                                <TextBlock Text="ADDRESS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="&#xe55f;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedContact.Address}" FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="14" Foreground="{StaticResource PrimaryTextBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}, {1} {2}">
                                                    <Binding Path="SelectedContact.City"/>
                                                    <Binding Path="SelectedContact.State"/>
                                                    <Binding Path="SelectedContact.PostalCode"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedContact.Country}" FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   Visibility="{Binding SelectedContact.Country, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Website Section -->
                            <StackPanel Visibility="{Binding SelectedContact.Website, Converter={StaticResource StringToVisibilityConverter}}"
                                        Margin="0,0,0,16">
                                <TextBlock Text="WEBSITE" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="&#xe894;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding SelectedContact.Website}" FontSize="14"
                                               Foreground="{StaticResource GoldBrandBrush}" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Birthday Section -->
                            <StackPanel Visibility="{Binding SelectedContact.Birthday, Converter={StaticResource NullToVisibilityConverter}}"
                                        Margin="0,0,0,16">
                                <TextBlock Text="BIRTHDAY" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="&#xe7e9;" FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding SelectedContact.Birthday, StringFormat='{}{0:MMMM d, yyyy}'}" FontSize="14"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Notes Section -->
                            <StackPanel Visibility="{Binding SelectedContact.Notes, Converter={StaticResource StringToVisibilityConverter}}"
                                        Margin="0,0,0,16">
                                <TextBlock Text="NOTES" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                                <Border Background="#252525" CornerRadius="4" Padding="12">
                                    <TextBlock Text="{Binding SelectedContact.Notes}" FontSize="13"
                                               Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

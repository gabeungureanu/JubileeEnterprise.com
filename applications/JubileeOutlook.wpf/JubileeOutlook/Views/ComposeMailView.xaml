<UserControl x:Class="JubileeOutlook.Views.ComposeMailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:JubileeOutlook.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="500"
             d:DataContext="{d:DesignInstance Type=viewmodels:ComposeMailViewModel}"
             Background="#1A1A1A">

    <!-- DataContext is set programmatically by MainWindow to ensure proper event binding -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Validation Error Banner -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Header with Send Button -->
            <RowDefinition Height="Auto"/> <!-- Row 2: From Field -->
            <RowDefinition Height="Auto"/> <!-- Row 3: To Field -->
            <RowDefinition Height="Auto"/> <!-- Row 4: Cc/Bcc Fields -->
            <RowDefinition Height="Auto"/> <!-- Row 5: Subject Field -->
            <RowDefinition Height="Auto"/> <!-- Row 6: Formatting Toolbar -->
            <RowDefinition Height="*"/>    <!-- Row 7: Message Body -->
            <RowDefinition Height="Auto"/> <!-- Row 8: Attachments -->
        </Grid.RowDefinitions>

        <!-- Validation Error Banner -->
        <Border Grid.Row="0" Background="#D32F2F" Padding="12,8" Visibility="{Binding ValidationError, Converter={StaticResource StringToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xe002;" FontFamily="{StaticResource MaterialIcons}" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ValidationError}" Foreground="White" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="9" Background="#80000000" Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibilityConverter}}" Panel.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xe863;" FontFamily="{StaticResource MaterialIcons}" FontSize="32" Foreground="{StaticResource GoldBrandBrush}" HorizontalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" CenterX="16" CenterY="16"/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                   From="0" To="360" Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock Text="Sending..." Foreground="White" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Header with Send Button -->
        <Border Grid.Row="1" Background="#252525" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Send Button with Send Icon -->
                <Button Grid.Column="0" Command="{Binding SendCommand}" Margin="0,0,12,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource GoldBrandBrush}"/>
                            <Setter Property="Foreground" Value="#000000"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="20,8"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               CornerRadius="4"
                                               Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xe163;" FontFamily="{StaticResource MaterialIcons}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                <TextBlock Text="Send" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#C9A961"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#B89850"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Draft Status Text -->
                <TextBlock Grid.Column="1" Text="{Binding DraftStatus}" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="8,0,0,0"/>

                <!-- Toolbar Icons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding AttachCommand}" ToolTip="Attach file" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                        <TextBlock Text="&#xe226;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                    </Button>
                    <Button x:Name="FormattingButton" ToolTip="Formatting" Click="FormattingButton_Click" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                        <TextBlock Text="&#xe8d2;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                    </Button>
                    <Button Command="{Binding SaveDraftCommand}" ToolTip="Save to Drafts" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                        <TextBlock Text="&#xe161;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                    </Button>
                    <Button Command="{Binding CancelCommand}" ToolTip="Discard" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                        <TextBlock Text="&#xe872;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                    </Button>
                    <Button Command="{Binding CancelCommand}" ToolTip="Close" Style="{StaticResource IconButtonStyle}">
                        <TextBlock Text="&#xe5cd;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- From Field (Editable TextBox) -->
        <Border Grid.Row="2" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="From:" FontSize="13" Foreground="#999999" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Text="{Binding From, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"
                         Background="Transparent"
                         Foreground="#EEEEEE"
                         BorderThickness="0"
                         Padding="0,4"
                         VerticalAlignment="Center"
                         CaretBrush="#0078D4">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            <TextBlock Text="Enter sender address"
                                                      Foreground="#666666"
                                                      FontSize="13"
                                                      IsHitTestVisible="False"
                                                      VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding From}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>

        <!-- To, Cc, Bcc Fields -->
        <Border Grid.Row="3" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="16,0">
            <StackPanel>
                <!-- To Field -->
                <Grid Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="To:" FontSize="13" Foreground="#999999" VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding To, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13"
                             Background="Transparent"
                             Foreground="#EEEEEE"
                             BorderThickness="0"
                             Padding="0,4"
                             VerticalAlignment="Center"
                             CaretBrush="#0078D4">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                <TextBlock Text="Enter recipients"
                                                          Foreground="#666666"
                                                          FontSize="13"
                                                          IsHitTestVisible="False"
                                                          VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding To}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Cc" Command="{Binding ShowCcFieldCommand}"
                                Visibility="{Binding ShowCc, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Style="{StaticResource LinkButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Bcc" Command="{Binding ShowBccFieldCommand}"
                                Visibility="{Binding ShowBcc, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Style="{StaticResource LinkButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Cc Field -->
                <Grid Margin="0,0,0,12" Visibility="{Binding ShowCc, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Cc:" FontSize="13" Foreground="#999999" VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding Cc, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13"
                             Background="Transparent"
                             Foreground="#EEEEEE"
                             BorderThickness="0"
                             Padding="0,4"
                             VerticalAlignment="Center"
                             CaretBrush="#0078D4"/>
                </Grid>

                <!-- Bcc Field -->
                <Grid Margin="0,0,0,12" Visibility="{Binding ShowBcc, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Bcc:" FontSize="13" Foreground="#999999" VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding Bcc, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13"
                             Background="Transparent"
                             Foreground="#EEEEEE"
                             BorderThickness="0"
                             Padding="0,4"
                             VerticalAlignment="Center"
                             CaretBrush="#0078D4"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Subject Field -->
        <Border Grid.Row="5" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Subject:" FontSize="13" Foreground="#999999" VerticalAlignment="Center"/>

                <TextBox Grid.Column="1"
                         Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"
                         Background="Transparent"
                         Foreground="#EEEEEE"
                         BorderThickness="0"
                         Padding="0,4"
                         VerticalAlignment="Center"
                         CaretBrush="#0078D4">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            <TextBlock Text="Add a subject"
                                                      Foreground="#666666"
                                                      FontSize="13"
                                                      IsHitTestVisible="False"
                                                      VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Subject}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>

        <!-- Attachments Section -->
        <Border Grid.Row="8" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="16,8"
                x:Name="AttachmentsSection"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Attachments:" FontSize="12" Foreground="#999999" Margin="0,0,0,8"/>
                <ItemsControl x:Name="AttachmentsList" ItemsSource="{Binding Attachments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#252525"
                                   BorderBrush="#444444"
                                   BorderThickness="1"
                                   CornerRadius="4"
                                   Padding="8,6"
                                   Margin="0,0,8,8"
                                   HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                              Text="&#xe226;"
                                              FontFamily="{StaticResource MaterialIcons}"
                                              FontSize="16"
                                              Foreground="#0078D4"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}"
                                                  FontSize="12"
                                                  Foreground="#EEEEEE"
                                                  TextTrimming="CharacterEllipsis"
                                                  MaxWidth="300"/>
                                        <TextBlock Text="{Binding FileSize}"
                                                  FontSize="10"
                                                  Foreground="#999999"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                           ToolTip="Remove attachment"
                                           Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           Style="{StaticResource IconButtonStyle}"
                                           Margin="8,0,0,0">
                                        <TextBlock Text="&#xe5cd;"
                                                  FontFamily="{StaticResource MaterialIcons}"
                                                  FontSize="14"
                                                  Foreground="#999999"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Message Body -->
        <Border Grid.Row="7" Padding="16">
            <RichTextBox x:Name="MessageBodyEditor"
                        Background="Transparent"
                        Foreground="#EEEEEE"
                        BorderThickness="0"
                        FontSize="13"
                        CaretBrush="#0078D4"
                        VerticalScrollBarVisibility="Auto"
                        AcceptsReturn="True">
                <FlowDocument>
                    <Paragraph>
                        <Run Text="" Foreground="#EEEEEE"/>
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
        </Border>

        <!-- Formatting Toolbar -->
        <Border x:Name="FormattingToolbar" Grid.Row="6" Background="#252525" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="12,8" Visibility="Visible">
            <StackPanel Orientation="Horizontal">
                <!-- Text Formatting -->
                <Button x:Name="BoldButton" ToolTip="Bold (Ctrl+B)" Click="BoldButton_Click" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#xe238;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                </Button>
                <Button x:Name="ItalicButton" ToolTip="Italic (Ctrl+I)" Click="ItalicButton_Click" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#xe23f;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                </Button>
                <Button x:Name="UnderlineButton" ToolTip="Underline (Ctrl+U)" Click="UnderlineButton_Click" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#xe249;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#444444" Margin="8,0"/>

                <!-- Text Alignment -->
                <Button x:Name="AlignLeftButton" ToolTip="Align Left" Click="AlignLeftButton_Click" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#xe236;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                </Button>
                <Button x:Name="AlignCenterButton" ToolTip="Align Center" Click="AlignCenterButton_Click" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#xe234;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                </Button>
                <Button x:Name="AlignRightButton" ToolTip="Align Right" Click="AlignRightButton_Click" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#xe237;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#444444" Margin="8,0"/>

                <!-- Lists -->
                <Button x:Name="BulletListButton" ToolTip="Bullet list" Click="BulletListButton_Click" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#xe241;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                </Button>
                <Button x:Name="NumberedListButton" ToolTip="Numbered list" Click="NumberedListButton_Click" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#xe242;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#444444" Margin="8,0"/>

                <!-- Insert Options -->
                <Button x:Name="InsertLinkButton" ToolTip="Insert link" Click="InsertLinkButton_Click" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#xe157;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                </Button>
                <Button x:Name="InsertImageButton" ToolTip="Insert image" Click="InsertImageButton_Click" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0">
                    <TextBlock Text="&#xe3f4;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#444444" Margin="8,0"/>

                <!-- Signature Dropdown -->
                <ToggleButton x:Name="SignatureDropdownButton" ToolTip="Insert Signature" Margin="0,0,4,0">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xe22b;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                                                <TextBlock Text="&#xe5cf;" FontFamily="{StaticResource MaterialIcons}" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#333333"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#333333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <!-- Signature Dropdown Popup -->
                <Popup IsOpen="{Binding IsChecked, ElementName=SignatureDropdownButton, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=SignatureDropdownButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="#252525" CornerRadius="4" BorderBrush="#444444" BorderThickness="1" Padding="4" MinWidth="180">
                        <StackPanel>
                            <!-- Available Signatures -->
                            <ItemsControl ItemsSource="{Binding AvailableSignatures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="SignatureMenuItem_Click"
                                                Command="{Binding DataContext.ChangeSignatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Left"
                                                Padding="12,8"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="&#xe73e;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                                   Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#EEEEEE" FontSize="12" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="2" Text="Default" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                                   Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Border" Property="Background" Value="#333333"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Separator -->
                            <Rectangle Height="1" Fill="#444444" Margin="8,4"/>

                            <!-- Insert Signature Button -->
                            <Button Click="SignatureMenuItem_Click"
                                    Command="{Binding InsertSignatureCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,8"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xe145;" FontFamily="{StaticResource MaterialIcons}" FontSize="14" Foreground="#0078D4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="Insert Signature" Foreground="#0078D4" FontSize="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#333333"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Manage Signatures Button -->
                            <Button Click="ManageSignaturesMenuItem_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,8"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xe8b8;" FontFamily="{StaticResource MaterialIcons}" FontSize="14" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="Manage Signatures..." Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#333333"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

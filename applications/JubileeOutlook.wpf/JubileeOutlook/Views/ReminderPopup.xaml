<Window x:Class="JubileeOutlook.Views.ReminderPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Reminder"
        Width="400" Height="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">

    <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="#D4A84B" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with bell icon -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Background="#D4A84B" CornerRadius="20" Width="40" Height="40" Margin="0,0,12,0">
                    <TextBlock Text="&#xe7f4;" FontFamily="{StaticResource MaterialIcons}"
                               FontSize="22" Foreground="#000000"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Reminder" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TimeUntilText" Text="Starting soon" FontSize="12" Foreground="#888888"/>
                </StackPanel>

                <!-- Close button -->
                <Button x:Name="CloseButton" Click="CloseButton_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="24" Height="24" Margin="80,0,0,0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <TextBlock Text="&#xe5cd;" FontFamily="{StaticResource MaterialIcons}"
                               FontSize="16" Foreground="#888888"/>
                </Button>
            </StackPanel>

            <!-- Event Subject -->
            <TextBlock Grid.Row="1" x:Name="SubjectText"
                       Text="Event Subject"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- Event Details -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <!-- Time -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="&#xe8b5;" FontFamily="{StaticResource MaterialIcons}"
                               FontSize="16" Foreground="#888888" Width="24"/>
                    <TextBlock x:Name="TimeText" Text="10:00 AM - 11:00 AM"
                               FontSize="13" Foreground="#CCCCCC"/>
                </StackPanel>

                <!-- Location (if any) -->
                <StackPanel x:Name="LocationPanel" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                    <TextBlock Text="&#xe55f;" FontFamily="{StaticResource MaterialIcons}"
                               FontSize="16" Foreground="#888888" Width="24"/>
                    <TextBlock x:Name="LocationText" Text="Location"
                               FontSize="13" Foreground="#CCCCCC"/>
                </StackPanel>
            </StackPanel>

            <!-- Snooze options -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Snooze for:" FontSize="12" Foreground="#888888"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SnoozeComboBox" Width="130" SelectedIndex="1" Height="28">
                    <ComboBox.Resources>
                        <!-- Dark theme style for ComboBoxItems in dropdown -->
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#2A2A2A"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#D4A84B"/>
                                                <Setter Property="Foreground" Value="#000000"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Resources>
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Background" Value="#2A2A2A"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#444444"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton x:Name="ToggleButton"
                                                          Background="{TemplateBinding Background}"
                                                          BorderBrush="{TemplateBinding BorderBrush}"
                                                          BorderThickness="{TemplateBinding BorderThickness}"
                                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                          Focusable="False"
                                                          ClickMode="Press">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="20"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter Grid.Column="0" Margin="6,2,0,2"
                                                                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0"
                                                                      Fill="#CCCCCC" HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="#3A3A3A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <ContentPresenter x:Name="ContentSite"
                                                              IsHitTestVisible="False"
                                                              Content="{TemplateBinding SelectionBoxItem}"
                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                              Margin="8,4,24,4"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Left"/>
                                            <Popup x:Name="Popup" Placement="Bottom"
                                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                                   AllowsTransparency="True" Focusable="False"
                                                   PopupAnimation="Slide">
                                                <Border x:Name="DropDownBorder"
                                                        Background="#2A2A2A"
                                                        BorderBrush="#444444"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        MinWidth="{TemplateBinding ActualWidth}"
                                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Style>
                    <ComboBoxItem Content="5 minutes" Tag="5"/>
                    <ComboBoxItem Content="10 minutes" Tag="10"/>
                    <ComboBoxItem Content="15 minutes" Tag="15"/>
                    <ComboBoxItem Content="30 minutes" Tag="30"/>
                    <ComboBoxItem Content="1 hour" Tag="60"/>
                    <ComboBoxItem Content="2 hours" Tag="120"/>
                </ComboBox>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DismissButton" Content="Dismiss" Click="DismissButton_Click"
                        Width="80" Height="32" Margin="0,0,8,0"
                        Background="#333333" Foreground="#FFFFFF" BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="12,6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="SnoozeButton" Content="Snooze" Click="SnoozeButton_Click"
                        Width="80" Height="32"
                        Background="#D4A84B" Foreground="#000000" BorderThickness="0"
                        Cursor="Hand" FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="12,6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#E5B95C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

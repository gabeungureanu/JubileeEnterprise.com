<UserControl x:Class="JubileeOutlook.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:JubileeOutlook.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{StaticResource PrimaryBackgroundBrush}">

    <UserControl.DataContext>
        <viewmodels:CalendarViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Header -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Date Navigation -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Previous Button -->
                    <Button Command="{Binding PreviousPeriodCommand}"
                            Style="{StaticResource RibbonSmallButtonStyle}"
                            Width="36" Height="36" Margin="0,0,8,0"
                            ToolTip="Previous">
                        <TextBlock Text="&#xe5cb;" FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="20" Foreground="#CCCCCC"/>
                    </Button>

                    <!-- Next Button -->
                    <Button Command="{Binding NextPeriodCommand}"
                            Style="{StaticResource RibbonSmallButtonStyle}"
                            Width="36" Height="36" Margin="0,0,16,0"
                            ToolTip="Next">
                        <TextBlock Text="&#xe5cc;" FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="20" Foreground="#CCCCCC"/>
                    </Button>

                    <!-- Today Button -->
                    <Button Command="{Binding GoToTodayCommand}"
                            Style="{StaticResource OutlookButtonStyle}"
                            Content="Today" Padding="16,6" Margin="0,0,24,0"/>

                    <!-- Date Range Display -->
                    <TextBlock Text="{Binding DateRangeText}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- View Selection Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <RadioButton Content="Day" GroupName="ViewMode"
                                 Command="{Binding SetViewModeCommand}" CommandParameter="Day"
                                 Style="{StaticResource RibbonTabButtonStyle}" Margin="0,0,4,0"/>
                    <RadioButton Content="Work Week" GroupName="ViewMode"
                                 Command="{Binding SetViewModeCommand}" CommandParameter="WorkWeek"
                                 Style="{StaticResource RibbonTabButtonStyle}" Margin="0,0,4,0"
                                 IsChecked="True"/>
                    <RadioButton Content="Week" GroupName="ViewMode"
                                 Command="{Binding SetViewModeCommand}" CommandParameter="Week"
                                 Style="{StaticResource RibbonTabButtonStyle}" Margin="0,0,4,0"/>
                    <RadioButton Content="Month" GroupName="ViewMode"
                                 Command="{Binding SetViewModeCommand}" CommandParameter="Month"
                                 Style="{StaticResource RibbonTabButtonStyle}"/>
                </StackPanel>

                <!-- New Event Button -->
                <Button Grid.Column="3" Command="{Binding NewEventCommand}"
                        Background="{StaticResource GoldBrandBrush}"
                        Foreground="#000000"
                        BorderThickness="0"
                        Padding="20,8" Height="36"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource GoldBrandBrush}"/>
                            <Setter Property="Foreground" Value="#000000"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{StaticResource GoldBrandHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#e5a94d"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xe145;" FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="New Event" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Calendar Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="#0A0A0A" BorderBrush="#333333" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <!-- Mini Calendar -->
                        <Border Background="#1A1A1A" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding MiniCalendarMonthYear}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                                <!-- Mini Calendar Grid -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Day Headers -->
                                    <UniformGrid Grid.Row="0" Rows="1" Columns="7" Margin="0,0,0,8">
                                        <TextBlock Text="Su" Style="{StaticResource MiniCalendarDayHeaderStyle}"/>
                                        <TextBlock Text="Mo" Style="{StaticResource MiniCalendarDayHeaderStyle}"/>
                                        <TextBlock Text="Tu" Style="{StaticResource MiniCalendarDayHeaderStyle}"/>
                                        <TextBlock Text="We" Style="{StaticResource MiniCalendarDayHeaderStyle}"/>
                                        <TextBlock Text="Th" Style="{StaticResource MiniCalendarDayHeaderStyle}"/>
                                        <TextBlock Text="Fr" Style="{StaticResource MiniCalendarDayHeaderStyle}"/>
                                        <TextBlock Text="Sa" Style="{StaticResource MiniCalendarDayHeaderStyle}"/>
                                    </UniformGrid>

                                    <!-- Calendar Days - Dynamic binding to MiniCalendarDays -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MiniCalendarDays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="5" Columns="7"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Converter={StaticResource MiniCalendarDayBackgroundConverter}}"
                                                        CornerRadius="2" Margin="1" Padding="2">
                                                    <TextBlock Text="{Binding Day}" FontSize="11" HorizontalAlignment="Center">
                                                        <TextBlock.Foreground>
                                                            <MultiBinding Converter="{StaticResource MiniCalendarDayForegroundConverter}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.SelectedDate" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- My Calendars Section -->
                        <StackPanel Margin="0,0,0,16">
                            <Button Command="{Binding AddCalendarCommand}"
                                    Style="{StaticResource OutlookButtonStyle}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xe145;" FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add Calendar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="My Calendars" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#888888" Margin="0,0,0,8"/>

                            <!-- Calendar List -->
                            <ItemsControl ItemsSource="{Binding Calendars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ToggleCalendarVisibilityCommand,
                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CalendarListItemStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Visibility Checkbox -->
                                                <Border Grid.Column="0" Width="16" Height="16"
                                                        Background="Transparent"
                                                        BorderBrush="{Binding Color}" BorderThickness="2"
                                                        CornerRadius="3" Margin="0,0,8,0">
                                                    <TextBlock Text="&#xe5ca;" FontFamily="{StaticResource MaterialIcons}"
                                                               FontSize="12" Foreground="{Binding Color}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </Border>

                                                <!-- Color Indicator -->
                                                <Ellipse Grid.Column="1" Width="12" Height="12"
                                                         Fill="{Binding Color}" Margin="0,0,8,0"/>

                                                <!-- Calendar Name -->
                                                <TextBlock Grid.Column="2" Text="{Binding Name}"
                                                           Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Main Calendar View -->
            <Border Grid.Column="1" Background="{StaticResource PrimaryBackgroundBrush}">
                <Grid>
                    <!-- Day View -->
                    <Grid Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Day}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Day Header -->
                        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="60,12,0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDate, StringFormat='{}{0:ddd}'}" FontSize="11" Foreground="#888888"
                                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedDate, StringFormat='{}{0:dd}'}" FontSize="24" FontWeight="Light"
                                           Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Time Grid -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Time Labels -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="12 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="1 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="2 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="3 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="4 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="5 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="6 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="7 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="8 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="9 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="10 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="11 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="12 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="1 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="2 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="3 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="4 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="5 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="6 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="7 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="8 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="9 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="10 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="11 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                </StackPanel>

                                <!-- Day Column with Events -->
                                <Border Grid.Column="1" Style="{StaticResource DayColumnStyle}">
                                    <Canvas>
                                        <ItemsControl>
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                    <Binding Path="Events"/>
                                                    <Binding Path="SelectedDate"/>
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="Canvas.Top" Value="{Binding StartTime, Converter={StaticResource EventTopPositionConverter}}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="{Binding Converter={StaticResource EventHeightConverter}}"
                                                            Style="{StaticResource CalendarEventBlockStyle}"
                                                            Background="{Binding EventColor}" Margin="4,0" MinWidth="200">
                                                        <StackPanel Margin="8,4">
                                                            <TextBlock Text="{Binding Subject}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding GetTimeRange}" FontSize="10" Foreground="#DDDDDD"/>
                                                            <TextBlock Text="{Binding Location}" FontSize="10" Foreground="#BBBBBB"
                                                                       Visibility="{Binding Location, Converter={StaticResource StringToVisibilityConverter}}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- Work Week View -->
                    <Grid Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=WorkWeek}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Day Headers - Dynamic binding to VisibleDays -->
                    <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,0,1">
                        <ItemsControl ItemsSource="{Binding VisibleDays}" Margin="60,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,12" Background="{Binding Converter={StaticResource IsTodayToBackgroundConverter}}">
                                        <TextBlock Text="{Binding Converter={StaticResource DateToDayOfWeekConverter}}"
                                                   FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4"
                                                   Foreground="{Binding Converter={StaticResource IsTodayToForegroundConverter}, ConverterParameter=header}"/>
                                        <TextBlock Text="{Binding Day}" FontSize="24" FontWeight="Light"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding Converter={StaticResource IsTodayToForegroundConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Time Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Time Labels -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="12 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="1 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="2 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="3 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="4 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="5 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="6 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="7 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="8 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="9 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="10 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="11 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="12 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="1 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="2 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="3 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="4 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="5 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="6 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="7 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="8 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="9 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="10 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                <TextBlock Text="11 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                            </StackPanel>

                            <!-- Day Column 1 (Monday) with Dynamic Events -->
                            <Border Grid.Column="1" Style="{StaticResource DayColumnStyle}">
                                <Canvas>
                                    <ItemsControl>
                                        <ItemsControl.ItemsSource>
                                            <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                <Binding Path="Events"/>
                                                <Binding Path="VisibleDays[0]"/>
                                            </MultiBinding>
                                        </ItemsControl.ItemsSource>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style>
                                                <Setter Property="Canvas.Top" Value="{Binding StartTime, Converter={StaticResource EventTopPositionConverter}}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="{Binding Converter={StaticResource EventHeightConverter}}"
                                                        Style="{StaticResource CalendarEventBlockStyle}"
                                                        Background="{Binding EventColor}" Margin="4,0" MinWidth="120">
                                                    <StackPanel Margin="6,4">
                                                        <TextBlock Text="{Binding Subject}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding GetTimeRange}" FontSize="9" Foreground="#DDDDDD"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Border>

                            <!-- Day Column 2 (Tuesday) with Dynamic Events -->
                            <Border Grid.Column="2" Style="{StaticResource DayColumnStyle}">
                                <Canvas>
                                    <ItemsControl>
                                        <ItemsControl.ItemsSource>
                                            <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                <Binding Path="Events"/>
                                                <Binding Path="VisibleDays[1]"/>
                                            </MultiBinding>
                                        </ItemsControl.ItemsSource>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style>
                                                <Setter Property="Canvas.Top" Value="{Binding StartTime, Converter={StaticResource EventTopPositionConverter}}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="{Binding Converter={StaticResource EventHeightConverter}}"
                                                        Style="{StaticResource CalendarEventBlockStyle}"
                                                        Background="{Binding EventColor}" Margin="4,0" MinWidth="120">
                                                    <StackPanel Margin="6,4">
                                                        <TextBlock Text="{Binding Subject}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding GetTimeRange}" FontSize="9" Foreground="#DDDDDD"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Border>

                            <!-- Day Column 3 (Wednesday) with Dynamic Events -->
                            <Border Grid.Column="3" Style="{StaticResource DayColumnStyle}">
                                <Canvas>
                                    <ItemsControl>
                                        <ItemsControl.ItemsSource>
                                            <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                <Binding Path="Events"/>
                                                <Binding Path="VisibleDays[2]"/>
                                            </MultiBinding>
                                        </ItemsControl.ItemsSource>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style>
                                                <Setter Property="Canvas.Top" Value="{Binding StartTime, Converter={StaticResource EventTopPositionConverter}}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="{Binding Converter={StaticResource EventHeightConverter}}"
                                                        Style="{StaticResource CalendarEventBlockStyle}"
                                                        Background="{Binding EventColor}" Margin="4,0" MinWidth="120">
                                                    <StackPanel Margin="6,4">
                                                        <TextBlock Text="{Binding Subject}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding GetTimeRange}" FontSize="9" Foreground="#DDDDDD"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Border>

                            <!-- Day Column 4 (Thursday) with Dynamic Events -->
                            <Border Grid.Column="4" Style="{StaticResource DayColumnStyle}">
                                <Canvas>
                                    <ItemsControl>
                                        <ItemsControl.ItemsSource>
                                            <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                <Binding Path="Events"/>
                                                <Binding Path="VisibleDays[3]"/>
                                            </MultiBinding>
                                        </ItemsControl.ItemsSource>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style>
                                                <Setter Property="Canvas.Top" Value="{Binding StartTime, Converter={StaticResource EventTopPositionConverter}}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="{Binding Converter={StaticResource EventHeightConverter}}"
                                                        Style="{StaticResource CalendarEventBlockStyle}"
                                                        Background="{Binding EventColor}" Margin="4,0" MinWidth="120">
                                                    <StackPanel Margin="6,4">
                                                        <TextBlock Text="{Binding Subject}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding GetTimeRange}" FontSize="9" Foreground="#DDDDDD"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Border>

                            <!-- Day Column 5 (Friday) with Dynamic Events -->
                            <Border Grid.Column="5" Style="{StaticResource DayColumnStyle}">
                                <Canvas>
                                    <ItemsControl>
                                        <ItemsControl.ItemsSource>
                                            <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                <Binding Path="Events"/>
                                                <Binding Path="VisibleDays[4]"/>
                                            </MultiBinding>
                                        </ItemsControl.ItemsSource>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style>
                                                <Setter Property="Canvas.Top" Value="{Binding StartTime, Converter={StaticResource EventTopPositionConverter}}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="{Binding Converter={StaticResource EventHeightConverter}}"
                                                        Style="{StaticResource CalendarEventBlockStyle}"
                                                        Background="{Binding EventColor}" Margin="4,0" MinWidth="120">
                                                    <StackPanel Margin="6,4">
                                                        <TextBlock Text="{Binding Subject}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding GetTimeRange}" FontSize="9" Foreground="#DDDDDD"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    </Grid>

                    <!-- Week View -->
                    <Grid Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Week}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Day Headers for 7 days - Dynamic binding to VisibleDays -->
                        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,0,1">
                            <ItemsControl ItemsSource="{Binding VisibleDays}" Margin="60,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,12" Background="{Binding Converter={StaticResource IsTodayToBackgroundConverter}}">
                                            <TextBlock Text="{Binding Converter={StaticResource DateToDayOfWeekConverter}}"
                                                       FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4"
                                                       Foreground="{Binding Converter={StaticResource IsTodayToForegroundConverter}, ConverterParameter=header}"/>
                                            <TextBlock Text="{Binding Day}" FontSize="24" FontWeight="Light"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{Binding Converter={StaticResource IsTodayToForegroundConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Time Grid with 7 columns -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Time Labels -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="12 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="1 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="2 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="3 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="4 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="5 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="6 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="7 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="8 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="9 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="10 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="11 AM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="12 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="1 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="2 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="3 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="4 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="5 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="6 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="7 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="8 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="9 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="10 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                    <TextBlock Text="11 PM" Style="{StaticResource TimeSlotLabelStyle}"/>
                                </StackPanel>

                                <!-- 7 Day Columns with Dynamic Events -->
                                <!-- Sunday -->
                                <Border Grid.Column="1" Style="{StaticResource DayColumnStyle}">
                                    <Canvas>
                                        <ItemsControl>
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                    <Binding Path="Events"/>
                                                    <Binding Path="VisibleDays[0]"/>
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="Canvas.Top" Value="{Binding StartTime, Converter={StaticResource EventTopPositionConverter}}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="{Binding Converter={StaticResource EventHeightConverter}}"
                                                            Style="{StaticResource CalendarEventBlockStyle}"
                                                            Background="{Binding EventColor}" Margin="2,0" MinWidth="80">
                                                        <StackPanel Margin="4,2">
                                                            <TextBlock Text="{Binding Subject}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding GetTimeRange}" FontSize="8" Foreground="#DDDDDD"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Border>
                                <!-- Monday -->
                                <Border Grid.Column="2" Style="{StaticResource DayColumnStyle}">
                                    <Canvas>
                                        <ItemsControl>
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                    <Binding Path="Events"/>
                                                    <Binding Path="VisibleDays[1]"/>
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="Canvas.Top" Value="{Binding StartTime, Converter={StaticResource EventTopPositionConverter}}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="{Binding Converter={StaticResource EventHeightConverter}}"
                                                            Style="{StaticResource CalendarEventBlockStyle}"
                                                            Background="{Binding EventColor}" Margin="2,0" MinWidth="80">
                                                        <StackPanel Margin="4,2">
                                                            <TextBlock Text="{Binding Subject}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding GetTimeRange}" FontSize="8" Foreground="#DDDDDD"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Border>
                                <!-- Tuesday -->
                                <Border Grid.Column="3" Style="{StaticResource DayColumnStyle}">
                                    <Canvas>
                                        <ItemsControl>
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                    <Binding Path="Events"/>
                                                    <Binding Path="VisibleDays[2]"/>
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="Canvas.Top" Value="{Binding StartTime, Converter={StaticResource EventTopPositionConverter}}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="{Binding Converter={StaticResource EventHeightConverter}}"
                                                            Style="{StaticResource CalendarEventBlockStyle}"
                                                            Background="{Binding EventColor}" Margin="2,0" MinWidth="80">
                                                        <StackPanel Margin="4,2">
                                                            <TextBlock Text="{Binding Subject}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding GetTimeRange}" FontSize="8" Foreground="#DDDDDD"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Border>
                                <!-- Wednesday -->
                                <Border Grid.Column="4" Style="{StaticResource DayColumnStyle}">
                                    <Canvas>
                                        <ItemsControl>
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                    <Binding Path="Events"/>
                                                    <Binding Path="VisibleDays[3]"/>
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="Canvas.Top" Value="{Binding StartTime, Converter={StaticResource EventTopPositionConverter}}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="{Binding Converter={StaticResource EventHeightConverter}}"
                                                            Style="{StaticResource CalendarEventBlockStyle}"
                                                            Background="{Binding EventColor}" Margin="2,0" MinWidth="80">
                                                        <StackPanel Margin="4,2">
                                                            <TextBlock Text="{Binding Subject}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding GetTimeRange}" FontSize="8" Foreground="#DDDDDD"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Border>
                                <!-- Thursday -->
                                <Border Grid.Column="5" Style="{StaticResource DayColumnStyle}">
                                    <Canvas>
                                        <ItemsControl>
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                    <Binding Path="Events"/>
                                                    <Binding Path="VisibleDays[4]"/>
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="Canvas.Top" Value="{Binding StartTime, Converter={StaticResource EventTopPositionConverter}}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="{Binding Converter={StaticResource EventHeightConverter}}"
                                                            Style="{StaticResource CalendarEventBlockStyle}"
                                                            Background="{Binding EventColor}" Margin="2,0" MinWidth="80">
                                                        <StackPanel Margin="4,2">
                                                            <TextBlock Text="{Binding Subject}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding GetTimeRange}" FontSize="8" Foreground="#DDDDDD"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Border>
                                <!-- Friday -->
                                <Border Grid.Column="6" Style="{StaticResource DayColumnStyle}">
                                    <Canvas>
                                        <ItemsControl>
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                    <Binding Path="Events"/>
                                                    <Binding Path="VisibleDays[5]"/>
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="Canvas.Top" Value="{Binding StartTime, Converter={StaticResource EventTopPositionConverter}}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="{Binding Converter={StaticResource EventHeightConverter}}"
                                                            Style="{StaticResource CalendarEventBlockStyle}"
                                                            Background="{Binding EventColor}" Margin="2,0" MinWidth="80">
                                                        <StackPanel Margin="4,2">
                                                            <TextBlock Text="{Binding Subject}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding GetTimeRange}" FontSize="8" Foreground="#DDDDDD"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Border>
                                <!-- Saturday -->
                                <Border Grid.Column="7" Style="{StaticResource DayColumnStyle}">
                                    <Canvas>
                                        <ItemsControl>
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                    <Binding Path="Events"/>
                                                    <Binding Path="VisibleDays[6]"/>
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="Canvas.Top" Value="{Binding StartTime, Converter={StaticResource EventTopPositionConverter}}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="{Binding Converter={StaticResource EventHeightConverter}}"
                                                            Style="{StaticResource CalendarEventBlockStyle}"
                                                            Background="{Binding EventColor}" Margin="2,0" MinWidth="80">
                                                        <StackPanel Margin="4,2">
                                                            <TextBlock Text="{Binding Subject}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding GetTimeRange}" FontSize="8" Foreground="#DDDDDD"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- Month View - Dynamic binding to MonthViewDays -->
                    <Grid Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Month}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Day of Week Headers -->
                                <UniformGrid Grid.Row="0" Rows="1" Columns="7" Margin="0,0,0,8">
                                    <TextBlock Text="SUNDAY" FontSize="10" Foreground="#888888" HorizontalAlignment="Center" Padding="8,4"/>
                                    <TextBlock Text="MONDAY" FontSize="10" Foreground="#888888" HorizontalAlignment="Center" Padding="8,4"/>
                                    <TextBlock Text="TUESDAY" FontSize="10" Foreground="#888888" HorizontalAlignment="Center" Padding="8,4"/>
                                    <TextBlock Text="WEDNESDAY" FontSize="10" Foreground="#888888" HorizontalAlignment="Center" Padding="8,4"/>
                                    <TextBlock Text="THURSDAY" FontSize="10" Foreground="#888888" HorizontalAlignment="Center" Padding="8,4"/>
                                    <TextBlock Text="FRIDAY" FontSize="10" Foreground="#888888" HorizontalAlignment="Center" Padding="8,4"/>
                                    <TextBlock Text="SATURDAY" FontSize="10" Foreground="#888888" HorizontalAlignment="Center" Padding="8,4"/>
                                </UniformGrid>

                                <!-- Calendar Grid (6 weeks x 7 days) - Dynamic with Events -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding MonthViewDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="6" Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Converter={StaticResource IsTodayToBackgroundConverter}}"
                                                    BorderBrush="#333333" BorderThickness="0.5" MinHeight="100">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Day Number -->
                                                    <TextBlock Grid.Row="0" Text="{Binding Day}" FontSize="14" Margin="8,8,8,4" VerticalAlignment="Top">
                                                        <TextBlock.Foreground>
                                                            <MultiBinding Converter="{StaticResource MiniCalendarDayForegroundConverter}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.SelectedDate" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>

                                                    <!-- Events List for this day -->
                                                    <ItemsControl Grid.Row="1" Margin="4,0,4,4">
                                                        <ItemsControl.ItemsSource>
                                                            <MultiBinding Converter="{StaticResource EventsByDateConverter}">
                                                                <Binding Path="DataContext.Events" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                <Binding/>
                                                            </MultiBinding>
                                                        </ItemsControl.ItemsSource>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding EventColor}" CornerRadius="2" Margin="0,1" Padding="4,2">
                                                                    <TextBlock Text="{Binding Subject}" FontSize="10" Foreground="White"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="JubileeOutlook.Views.NewEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:JubileeOutlook.ViewModels"
        mc:Ignorable="d"
        Title="New event"
        Height="750"
        Width="1100"
        MinHeight="650"
        MinWidth="950"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#1A1A1A"
        WindowStartupLocation="CenterOwner">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="80"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <viewmodels:NewEventViewModel/>
    </Window.DataContext>

    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Background="#1A1A1A" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding WindowTitle}"
                       FontSize="13"
                       Foreground="#CCCCCC"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>

            <!-- Window Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" Style="{StaticResource WindowButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                <Button Content="&#xE922;" Style="{StaticResource WindowButtonStyle}" Click="MaximizeButton_Click" ToolTip="Maximize"/>
                <Button Content="&#xE8BB;" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Tab Header -->
        <Border Grid.Row="1" Background="#252525" BorderBrush="#333333" BorderThickness="0,1,0,1" Padding="16,12">
            <TextBlock Text="Event" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Form -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#1A1A1A">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Width" Value="10"/>
                        <Setter Property="MinWidth" Value="10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Style>
                                                        <Style TargetType="Thumb">
                                                            <Setter Property="Background" Value="#3A3A3A"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="5"
                                                                                Margin="2,0"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#5A5A5A"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter Property="Background" Value="#6A6A6A"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Thumb.Style>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>
                <StackPanel Margin="20,16">

                    <!-- Toolbar Row -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <!-- Show as Status -->
                        <ComboBox ItemsSource="{Binding ShowAsStatusOptions}"
                                 SelectedItem="{Binding ShowAsStatus}"
                                 Margin="0,0,8,0">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Background" Value="#252525"/>
                                    <Setter Property="Foreground" Value="#EEEEEE"/>
                                    <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="MinWidth" Value="140"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Grid>
                                                    <ToggleButton x:Name="ToggleButton"
                                                                 Background="{TemplateBinding Background}"
                                                                 BorderBrush="{TemplateBinding BorderBrush}"
                                                                 BorderThickness="{TemplateBinding BorderThickness}"
                                                                 IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                 ClickMode="Press"
                                                                 Focusable="False">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border x:Name="border"
                                                                                   Background="{TemplateBinding Background}"
                                                                                   BorderBrush="{TemplateBinding BorderBrush}"
                                                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                                                   CornerRadius="4">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <ContentPresenter Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock Grid.Column="1" Text="&#xe5c5;" FontFamily="{StaticResource MaterialIcons}" FontSize="14" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <ContentPresenter x:Name="ContentSite"
                                                                     IsHitTestVisible="False"
                                                                     Content="{TemplateBinding SelectionBoxItem}"
                                                                     ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                     ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                     Margin="8,0,24,0"
                                                                     VerticalAlignment="Center"
                                                                     HorizontalAlignment="Left"/>
                                                    <Popup x:Name="Popup"
                                                          Placement="Bottom"
                                                          IsOpen="{TemplateBinding IsDropDownOpen}"
                                                          AllowsTransparency="True"
                                                          Focusable="False"
                                                          PopupAnimation="Slide">
                                                        <Border Background="#2b2b2b"
                                                               BorderBrush="#3a3a3a"
                                                               BorderThickness="1"
                                                               CornerRadius="6"
                                                               Padding="4"
                                                               MinWidth="{TemplateBinding ActualWidth}">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.5" Color="Black"/>
                                                            </Border.Effect>
                                                            <ItemsPresenter/>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="border"
                                                       Background="{TemplateBinding Background}"
                                                       Padding="{TemplateBinding Padding}"
                                                       CornerRadius="4">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#B8860B"/>
                                                        <Setter Property="Foreground" Value="#000000"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="4" Height="16" Fill="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Reminder Time -->
                        <ComboBox ItemsSource="{Binding ReminderOptions}"
                                 SelectedItem="{Binding SelectedReminder}"
                                 Margin="0,0,8,0">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Background" Value="#252525"/>
                                    <Setter Property="Foreground" Value="#EEEEEE"/>
                                    <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="MinWidth" Value="180"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Grid>
                                                    <ToggleButton x:Name="ToggleButton"
                                                                 Background="{TemplateBinding Background}"
                                                                 BorderBrush="{TemplateBinding BorderBrush}"
                                                                 BorderThickness="{TemplateBinding BorderThickness}"
                                                                 IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                 ClickMode="Press"
                                                                 Focusable="False">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border x:Name="border"
                                                                                   Background="{TemplateBinding Background}"
                                                                                   BorderBrush="{TemplateBinding BorderBrush}"
                                                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                                                   CornerRadius="4">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Grid.Column="0" Text="&#xe7f4;" FontFamily="{StaticResource MaterialIcons}" FontSize="16" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                                                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                                                                    <TextBlock Grid.Column="2" Text="&#xe5c5;" FontFamily="{StaticResource MaterialIcons}" FontSize="14" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <ContentPresenter x:Name="ContentSite"
                                                                     IsHitTestVisible="False"
                                                                     Content="{TemplateBinding SelectionBoxItem}"
                                                                     ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                     ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                     Margin="36,0,24,0"
                                                                     VerticalAlignment="Center"
                                                                     HorizontalAlignment="Left"/>
                                                    <Popup x:Name="Popup"
                                                          Placement="Bottom"
                                                          IsOpen="{TemplateBinding IsDropDownOpen}"
                                                          AllowsTransparency="True"
                                                          Focusable="False"
                                                          PopupAnimation="Slide">
                                                        <Border Background="#2b2b2b"
                                                               BorderBrush="#3a3a3a"
                                                               BorderThickness="1"
                                                               CornerRadius="6"
                                                               Padding="4"
                                                               MinWidth="{TemplateBinding ActualWidth}">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.5" Color="Black"/>
                                                            </Border.Effect>
                                                            <ItemsPresenter/>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="border"
                                                       Background="{TemplateBinding Background}"
                                                       Padding="{TemplateBinding Padding}"
                                                       CornerRadius="4">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xe5ca;" FontFamily="{StaticResource MaterialIcons}" FontSize="16" Foreground="#0078D4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Categorize -->
                        <ComboBox ItemsSource="{Binding CategoryOptions}"
                                 SelectedItem="{Binding SelectedCategory}"
                                 Margin="0,0,8,0">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Background" Value="#252525"/>
                                    <Setter Property="Foreground" Value="#EEEEEE"/>
                                    <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="MinWidth" Value="140"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Grid>
                                                    <ToggleButton x:Name="ToggleButton"
                                                                 Background="{TemplateBinding Background}"
                                                                 BorderBrush="{TemplateBinding BorderBrush}"
                                                                 BorderThickness="{TemplateBinding BorderThickness}"
                                                                 IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                 ClickMode="Press"
                                                                 Focusable="False">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border x:Name="border"
                                                                                   Background="{TemplateBinding Background}"
                                                                                   BorderBrush="{TemplateBinding BorderBrush}"
                                                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                                                   CornerRadius="4">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <ContentPresenter Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock Grid.Column="1" Text="&#xe5c5;" FontFamily="{StaticResource MaterialIcons}" FontSize="14" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <ContentPresenter x:Name="ContentSite"
                                                                     IsHitTestVisible="False"
                                                                     Content="{TemplateBinding SelectionBoxItem}"
                                                                     ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                     ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                     Margin="8,0,24,0"
                                                                     VerticalAlignment="Center"
                                                                     HorizontalAlignment="Left"/>
                                                    <Popup x:Name="Popup"
                                                          Placement="Bottom"
                                                          IsOpen="{TemplateBinding IsDropDownOpen}"
                                                          AllowsTransparency="True"
                                                          Focusable="False"
                                                          PopupAnimation="Slide">
                                                        <Border Background="#2b2b2b"
                                                               BorderBrush="#3a3a3a"
                                                               BorderThickness="1"
                                                               CornerRadius="6"
                                                               Padding="4"
                                                               MinWidth="{TemplateBinding ActualWidth}">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.5" Color="Black"/>
                                                            </Border.Effect>
                                                            <ItemsPresenter/>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="border"
                                                       Background="{TemplateBinding Background}"
                                                       Padding="{TemplateBinding Padding}"
                                                       CornerRadius="4">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xe892;" FontFamily="{StaticResource MaterialIcons}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{Binding Color}"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Private -->
                        <ToggleButton IsChecked="{Binding IsPrivate}" Style="{StaticResource EventToolbarToggleStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xe897;" FontFamily="{StaticResource MaterialIcons}" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Private" FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <!-- Save and Delete Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Click="SaveButton_Click"
                                Style="{StaticResource SaveButtonStyle}"
                                Width="80"
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xe161;" FontFamily="{StaticResource MaterialIcons}" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Save" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Delete Button (only shown in edit mode) -->
                        <Button Click="DeleteButton_Click"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="90">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#D32F2F"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#E53935"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#C62828"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xe872;" FontFamily="{StaticResource MaterialIcons}" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Delete" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Validation Error Message -->
                    <Border Background="#5A1A1A"
                            BorderBrush="#8B0000"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,8"
                            Margin="0,0,0,24"
                            Visibility="{Binding ValidationError, Converter={StaticResource StringToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xe002;"
                                      FontFamily="{StaticResource MaterialIcons}"
                                      FontSize="16"
                                      Foreground="#FF6B6B"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ValidationError}"
                                      FontSize="13"
                                      Foreground="#FF6B6B"
                                      VerticalAlignment="Center"
                                      TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Title -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xe25b;" FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="20"
                                   Foreground="#0078D4"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <Grid Grid.Column="1">
                            <TextBox Text="{Binding EventTitle, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15"
                                     Background="Transparent"
                                     Foreground="#EEEEEE"
                                     BorderThickness="0,0,0,1"
                                     BorderBrush="#3A3A3A"
                                     Padding="0,4"
                                     VerticalAlignment="Center"
                                     CaretBrush="#FFFFFF">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#0078D4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Text="Add a title"
                                      Foreground="#666666"
                                      FontSize="15"
                                      Padding="0,4"
                                      IsHitTestVisible="False"
                                      VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EventTitle}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <!-- Invite attendees -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xe7fd;" FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="20"
                                   Foreground="#666666"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <Grid Grid.Column="1">
                            <TextBox Text="{Binding Attendees, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13"
                                     Background="Transparent"
                                     Foreground="#EEEEEE"
                                     BorderThickness="0,0,0,1"
                                     BorderBrush="#3A3A3A"
                                     Padding="0,4"
                                     VerticalAlignment="Center"
                                     CaretBrush="#FFFFFF">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#0078D4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Text="Invite attendees"
                                      Foreground="#666666"
                                      FontSize="13"
                                      Padding="0,4"
                                      IsHitTestVisible="False"
                                      VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Attendees}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   Text="Optional"
                                   FontSize="12"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </Grid>

                    <!-- Date and Time Row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Clock Icon -->
                        <TextBlock Grid.Column="0"
                                   Text="&#xe192;" FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="20"
                                   Foreground="#666666"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <!-- Date Picker -->
                        <DatePicker Grid.Column="1"
                                   SelectedDate="{Binding EventDate}"
                                   Background="#252525"
                                   Foreground="#FFFFFF"
                                   BorderBrush="Transparent"
                                   BorderThickness="0"
                                   Padding="8,6"
                                   FontSize="13"
                                   Margin="0,0,8,0"
                                   CalendarStyle="{StaticResource DarkCalendarStyle}">
                            <DatePicker.Resources>
                                <Style TargetType="DatePickerTextBox">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="Background" Value="#252525"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CaretBrush" Value="#FFFFFF"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DatePickerTextBox">
                                                <Grid>
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderThickness="0">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                     Foreground="{TemplateBinding Foreground}"
                                                                     VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>

                        <!-- Start Time (hidden when All day is checked) -->
                        <ComboBox Grid.Column="2"
                                 ItemsSource="{Binding TimeOptions}"
                                 SelectedItem="{Binding StartTime}"
                                 Style="{StaticResource DarkComboBoxStyle}"
                                 Width="100"
                                 Margin="0,0,8,0"
                                 Visibility="{Binding IsAllDay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <TextBlock Grid.Column="3"
                                   Text="to"
                                   FontSize="13"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding IsAllDay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <!-- End Time (hidden when All day is checked) -->
                        <ComboBox Grid.Column="4"
                                 ItemsSource="{Binding TimeOptions}"
                                 SelectedItem="{Binding EndTime}"
                                 Style="{StaticResource DarkComboBoxStyle}"
                                 Width="100"
                                 Margin="0,0,12,0"
                                 Visibility="{Binding IsAllDay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <!-- All day toggle -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ToggleButton IsChecked="{Binding IsAllDay}"
                                         Style="{StaticResource ModernToggleSwitchStyle}"
                                         Margin="0,0,8,0"/>
                            <TextBlock Text="All day"
                                       FontSize="13"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Location -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xe55f;" FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="20"
                                   Foreground="#666666"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <Grid Grid.Column="1" Margin="0,0,12,0">
                            <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13"
                                     Background="Transparent"
                                     Foreground="#EEEEEE"
                                     BorderThickness="0,0,0,1"
                                     BorderBrush="#3A3A3A"
                                     Padding="0,4"
                                     VerticalAlignment="Center"
                                     CaretBrush="#FFFFFF">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#0078D4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Text="Search for a location"
                                      Foreground="#666666"
                                      FontSize="13"
                                      Padding="0,4"
                                      IsHitTestVisible="False"
                                      VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Location}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- In-person event toggle -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <ToggleButton IsChecked="{Binding IsInPerson}"
                                         Style="{StaticResource ModernToggleSwitchStyle}"
                                         Margin="0,0,8,0"/>
                            <TextBlock Text="In-person event"
                                       FontSize="13"
                                       Foreground="#CCCCCC"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Recurrence Section -->
                    <Border Padding="0,12,0,0" Margin="0,0,0,0">
                        <StackPanel>
                            <!-- Make recurring toggle -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xe040;" FontFamily="{StaticResource MaterialIcons}"
                                           FontSize="20" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ToggleButton IsChecked="{Binding IsRecurring}"
                                             Style="{StaticResource ModernToggleSwitchStyle}"
                                             Margin="0,0,8,0"/>
                                <TextBlock Text="Make recurring"
                                           FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Recurrence options (visible when IsRecurring = true) -->
                            <Border Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="#1E1E1E" CornerRadius="6" Padding="16,12" Margin="32,0,0,0">
                                <StackPanel>
                                    <!-- Recurrence Type -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Repeat" FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RecurrenceTypeOptions}"
                                                  SelectedItem="{Binding SelectedRecurrenceType}"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  Width="140" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <!-- Interval -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Every" FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding RecurrenceInterval, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="60" FontSize="13" Foreground="White" Background="#2A2A2A"
                                                 BorderBrush="#444444" BorderThickness="1" Padding="6,4"
                                                 HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="2" FontSize="13" Foreground="#888888"
                                                   VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="day(s)"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedRecurrenceType}" Value="Weekly">
                                                            <Setter Property="Text" Value="week(s)"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedRecurrenceType}" Value="Monthly">
                                                            <Setter Property="Text" Value="month(s)"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedRecurrenceType}" Value="Yearly">
                                                            <Setter Property="Text" Value="year(s)"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Days of Week (visible only for Weekly) -->
                                    <StackPanel Margin="0,0,0,10"
                                                Visibility="{Binding SelectedRecurrenceType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Weekly}">
                                        <TextBlock Text="On days" FontSize="13" Foreground="#AAAAAA" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding DaysOfWeekOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton IsChecked="{Binding IsSelected}" Content="{Binding Name}"
                                                                  Margin="0,0,4,0" Padding="8,4" Cursor="Hand">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="DayBd" Background="#2A2A2A" CornerRadius="4"
                                                                        BorderBrush="#444444" BorderThickness="1"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <TextBlock Text="{TemplateBinding Content}" FontSize="11"
                                                                               Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="DayBd" Property="Background" Value="#0078D4"/>
                                                                        <Setter TargetName="DayBd" Property="BorderBrush" Value="#0078D4"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="DayBd" Property="Background" Value="#333333"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- End condition -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ends" FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RecurrenceEndOptions}"
                                                  SelectedItem="{Binding RecurrenceEndOption}"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  Width="160" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <!-- End date picker (visible when "On date" selected) -->
                                    <Grid Margin="100,0,0,6"
                                          Visibility="{Binding RecurrenceEndOption, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='On date'}">
                                        <DatePicker SelectedDate="{Binding RecurrenceEndDate}"
                                                    Width="160" HorizontalAlignment="Left"
                                                    FontSize="13" Foreground="White" Background="#2A2A2A"
                                                    BorderBrush="#444444"/>
                                    </Grid>

                                    <!-- Occurrences input (visible when "After occurrences" selected) -->
                                    <StackPanel Orientation="Horizontal" Margin="100,0,0,0"
                                                Visibility="{Binding RecurrenceEndOption, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='After occurrences'}">
                                        <TextBox Text="{Binding RecurrenceOccurrences, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="60" FontSize="13" Foreground="White" Background="#2A2A2A"
                                                 BorderBrush="#444444" BorderThickness="1" Padding="6,4"/>
                                        <TextBlock Text="occurrence(s)" FontSize="13" Foreground="#888888"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Description Area -->
                    <Border Padding="0,20,0,0" Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Editor Area with Icon on Left -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Note Icon -->
                                <TextBlock Grid.Column="0"
                                           Text="&#xe24d;" FontFamily="{StaticResource MaterialIcons}"
                                           FontSize="20"
                                           Foreground="#666666"
                                           VerticalAlignment="Top"
                                           Margin="0,8,12,0"/>

                                <!-- Editor Area with lighter background -->
                                <Border Grid.Column="1"
                                        Background="#202020"
                                        CornerRadius="4"
                                        Padding="12"
                                        MinHeight="180">
                                <Grid>
                                    <RichTextBox x:Name="DescriptionRichTextBox"
                                                 AcceptsReturn="True"
                                                 Background="Transparent"
                                                 Foreground="#EEEEEE"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 FontSize="13"
                                                 CaretBrush="#FFFFFF"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextChanged="DescriptionRichTextBox_TextChanged">
                                        <RichTextBox.Resources>
                                            <Style TargetType="Paragraph">
                                                <Setter Property="Margin" Value="0,0,0,6"/>
                                            </Style>
                                        </RichTextBox.Resources>
                                        <RichTextBox.Style>
                                            <Style TargetType="RichTextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RichTextBox">
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                         VerticalAlignment="Top"
                                                                         Padding="0"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RichTextBox.Style>
                                        <FlowDocument>
                                            <Paragraph/>
                                        </FlowDocument>
                                    </RichTextBox>
                                    <TextBlock x:Name="DescriptionPlaceholder"
                                              Text="Add notes, links, or attachments"
                                              Foreground="#666666"
                                              FontSize="13"
                                              Padding="0"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Top"
                                              Visibility="Visible"/>
                                </Grid>
                                </Border>
                            </Grid>

                            <!-- Toolbar with darker background -->
                            <Border Grid.Row="1"
                                    Background="#181818"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,4,4"
                                    Padding="8,10"
                                    Margin="32,8,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button ToolTip="Attach file" Margin="0,0,6,0"
                                            Command="{Binding AddAttachmentCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Width" Value="32"/>
                                                <Setter Property="Height" Value="32"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#333333"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="&#xe226;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#888888"/>
                                    </Button>

                                    <Button ToolTip="Insert image" Margin="0,0,6,0"
                                            Command="{Binding InsertImageCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Width" Value="32"/>
                                                <Setter Property="Height" Value="32"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#333333"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="&#xe3f4;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#888888"/>
                                    </Button>

                                    <Button x:Name="MoreOptionsButton" ToolTip="More" Margin="0,0,0,0" Click="MoreOptionsButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Width" Value="32"/>
                                                <Setter Property="Height" Value="32"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#333333"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="&#xe5d4;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#888888"/>
                                    </Button>

                                    <!-- More Options Popup Menu -->
                                    <Popup x:Name="MoreOptionsPopup"
                                           PlacementTarget="{Binding ElementName=MoreOptionsButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Background="#2D2D2D"
                                                BorderBrush="#404040"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="4"
                                                Margin="8">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
                                            </Border.Effect>
                                            <StackPanel MinWidth="200">
                                                <!-- Text Formatting Section -->
                                                <TextBlock Text="Text Formatting"
                                                           FontFamily="{StaticResource RobotoMedium}"
                                                           FontSize="11"
                                                           Foreground="#888888"
                                                           Margin="12,8,12,4"/>

                                                <Button Style="{StaticResource MenuItemButtonStyle}" Click="MenuBold_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xe238;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC" Width="24"/>
                                                        <TextBlock Text="Bold" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <TextBlock Text="Ctrl+B" Foreground="#666666" VerticalAlignment="Center" Margin="40,0,0,0" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource MenuItemButtonStyle}" Click="MenuItalic_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xe23f;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC" Width="24"/>
                                                        <TextBlock Text="Italic" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <TextBlock Text="Ctrl+I" Foreground="#666666" VerticalAlignment="Center" Margin="40,0,0,0" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource MenuItemButtonStyle}" Click="MenuUnderline_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xe249;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC" Width="24"/>
                                                        <TextBlock Text="Underline" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <TextBlock Text="Ctrl+U" Foreground="#666666" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource MenuItemButtonStyle}" Click="MenuStrikethrough_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xe257;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC" Width="24"/>
                                                        <TextBlock Text="Strikethrough" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Separator -->
                                                <Border Height="1" Background="#404040" Margin="8,4"/>

                                                <!-- List Options Section -->
                                                <TextBlock Text="Lists"
                                                           FontFamily="{StaticResource RobotoMedium}"
                                                           FontSize="11"
                                                           Foreground="#888888"
                                                           Margin="12,8,12,4"/>

                                                <Button Style="{StaticResource MenuItemButtonStyle}" Click="MenuBulletedList_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xe241;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC" Width="24"/>
                                                        <TextBlock Text="Bulleted list" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource MenuItemButtonStyle}" Click="MenuNumberedList_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xe242;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC" Width="24"/>
                                                        <TextBlock Text="Numbered list" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource MenuItemButtonStyle}" Click="MenuChecklist_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xe065;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC" Width="24"/>
                                                        <TextBlock Text="Checklist" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Separator -->
                                                <Border Height="1" Background="#404040" Margin="8,4"/>

                                                <!-- Insert Options Section -->
                                                <TextBlock Text="Insert"
                                                           FontFamily="{StaticResource RobotoMedium}"
                                                           FontSize="11"
                                                           Foreground="#888888"
                                                           Margin="12,8,12,4"/>

                                                <Button Style="{StaticResource MenuItemButtonStyle}" Click="MenuInsertLink_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xe157;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC" Width="24"/>
                                                        <TextBlock Text="Insert link" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <TextBlock Text="Ctrl+K" Foreground="#666666" VerticalAlignment="Center" Margin="28,0,0,0" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource MenuItemButtonStyle}" Click="MenuInsertTable_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xf191;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC" Width="24"/>
                                                        <TextBlock Text="Insert table" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource MenuItemButtonStyle}" Click="MenuInsertLine_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xe925;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC" Width="24"/>
                                                        <TextBlock Text="Horizontal line" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Separator -->
                                                <Border Height="1" Background="#404040" Margin="8,4"/>

                                                <!-- Content Actions Section -->
                                                <Button Style="{StaticResource MenuItemButtonStyle}" Click="MenuClearFormatting_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xe239;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC" Width="24"/>
                                                        <TextBlock Text="Clear formatting" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource MenuItemButtonStyle}" Click="MenuSelectAll_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xe162;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC" Width="24"/>
                                                        <TextBlock Text="Select all" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <TextBlock Text="Ctrl+A" Foreground="#666666" VerticalAlignment="Center" Margin="32,0,0,0" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Border>

                            <!-- Images Loading Indicator (Row 3) -->
                            <Border Grid.Row="3" Background="#252525" CornerRadius="8" Margin="0,12,0,0" Padding="16"
                                    Visibility="{Binding IsLoadingImages, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Spinning indicator -->
                                    <Border Width="20" Height="20" Margin="0,0,10,0">
                                        <Border.RenderTransform>
                                            <RotateTransform x:Name="LoadingImagesSpinnerRotate" />
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingImages}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                                     From="0" To="360" Duration="0:0:1" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Ellipse Width="20" Height="20" StrokeThickness="3">
                                            <Ellipse.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#0078D4" Offset="0"/>
                                                    <GradientStop Color="Transparent" Offset="0.75"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Stroke>
                                        </Ellipse>
                                    </Border>
                                    <TextBlock Text="{Binding LoadingImagesMessage}" Foreground="#AAAAAA"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Images Gallery (Row 3) -->
                            <ItemsControl Grid.Row="3" ItemsSource="{Binding Images}" Margin="0,12,0,0">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Images.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#252525" CornerRadius="8" Margin="0,0,8,8" Padding="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Image Preview -->
                                                <Border Grid.Row="0" CornerRadius="6" ClipToBounds="True" MaxWidth="200" MaxHeight="150">
                                                    <Image Source="{Binding ImageSource}"
                                                           Stretch="Uniform"
                                                           MaxWidth="200"
                                                           MaxHeight="150"/>
                                                </Border>

                                                <!-- Image Name and Remove Button -->
                                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding EventImage.FileName}"
                                                               Foreground="#AAAAAA"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="160"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Remove Image Button -->
                                                    <Button Grid.Column="1" ToolTip="Remove image"
                                                            Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="Width" Value="22"/>
                                                                <Setter Property="Height" Value="22"/>
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="border"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    CornerRadius="4">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsPressed" Value="True">
                                                                                    <Setter TargetName="border" Property="Background" Value="#444444"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="&#xe5cd;" FontFamily="{StaticResource MaterialIcons}"
                                                                   FontSize="14" Foreground="#888888"/>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Attachments List (Row 4) -->
                            <ItemsControl Grid.Row="4" ItemsSource="{Binding Attachments}" Margin="0,12,0,0">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Attachments.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#252525" CornerRadius="6" Margin="0,0,0,6" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- File Icon -->
                                                <Border Grid.Column="0" Background="#333333" CornerRadius="4" Width="36" Height="36" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding FileIcon}" FontFamily="{StaticResource MaterialIcons}"
                                                               FontSize="18" Foreground="#888888"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- File Name and Size -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" Foreground="#EEEEEE" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                                                    <TextBlock Text="{Binding FileSizeFormatted}" Foreground="#888888" FontSize="11"/>
                                                </StackPanel>

                                                <!-- Remove Button -->
                                                <Button Grid.Column="3" ToolTip="Remove attachment"
                                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Width" Value="28"/>
                                                            <Setter Property="Height" Value="28"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="border"
                                                                                Background="{TemplateBinding Background}"
                                                                                CornerRadius="4">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="&#xe5cd;" FontFamily="{StaticResource MaterialIcons}"
                                                               FontSize="16" Foreground="#888888"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Right Panel - Calendar Preview -->
            <Border Grid.Column="1" Background="#252525" BorderBrush="#333333" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Date Header -->
                    <Border Grid.Row="0" Background="#2A2A2A" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                                    Command="{Binding PreviousDayCommand}">
                                <TextBlock Text="&#xe5cb;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC"/>
                            </Button>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Command="{Binding ToggleDatePickerCommand}" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="12,6"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding EventDate, StringFormat='ddd, yyyy, MMM dd'}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"/>
                                        <TextBlock Text="&#xe5c5;" FontFamily="{StaticResource MaterialIcons}"
                                                   FontSize="16" Foreground="#CCCCCC" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- Date Picker Popup -->
                                <Popup IsOpen="{Binding IsDatePickerOpen}"
                                       StaysOpen="False"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="#2A2A2A"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="4">
                                        <Calendar SelectedDate="{Binding EventDate, Mode=TwoWay}"
                                                  DisplayDate="{Binding EventDate}"
                                                  Style="{StaticResource DarkCalendarStyle}"/>
                                    </Border>
                                </Popup>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                                    Command="{Binding NextDayCommand}">
                                <TextBlock Text="&#xe5cc;" FontFamily="{StaticResource MaterialIcons}" FontSize="18" Foreground="#CCCCCC"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Time Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Width" Value="8"/>
                                <Setter Property="MinWidth" Value="8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Background="Transparent">
                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Style>
                                                                <Style TargetType="Thumb">
                                                                    <Setter Property="Background" Value="#3A3A3A"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Thumb">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        CornerRadius="4"
                                                                                        Margin="2,0"/>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#4A4A4A"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Thumb.Style>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Resources>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Hours Column - starts at 10px to show 12 AM fully -->
                            <ItemsControl Grid.Row="1" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Height="970"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Items>
                                    <!-- Hour markers in 12-hour AM/PM format -->
                                    <Grid Canvas.Top="0" Height="40">
                                        <TextBlock Text="12 AM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="40" Height="40">
                                        <TextBlock Text="1 AM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="80" Height="40">
                                        <TextBlock Text="2 AM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="120" Height="40">
                                        <TextBlock Text="3 AM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="160" Height="40">
                                        <TextBlock Text="4 AM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="200" Height="40">
                                        <TextBlock Text="5 AM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="240" Height="40">
                                        <TextBlock Text="6 AM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="280" Height="40">
                                        <TextBlock Text="7 AM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="320" Height="40">
                                        <TextBlock Text="8 AM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="360" Height="40">
                                        <TextBlock Text="9 AM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="400" Height="40">
                                        <TextBlock Text="10 AM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="440" Height="40">
                                        <TextBlock Text="11 AM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="480" Height="40">
                                        <TextBlock Text="12 PM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="520" Height="40">
                                        <TextBlock Text="1 PM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="560" Height="40">
                                        <TextBlock Text="2 PM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="600" Height="40">
                                        <TextBlock Text="3 PM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="640" Height="40">
                                        <TextBlock Text="4 PM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="680" Height="40">
                                        <TextBlock Text="5 PM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="720" Height="40">
                                        <TextBlock Text="6 PM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="760" Height="40">
                                        <TextBlock Text="7 PM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="800" Height="40">
                                        <TextBlock Text="8 PM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="840" Height="40">
                                        <TextBlock Text="9 PM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="880" Height="40">
                                        <TextBlock Text="10 PM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Grid Canvas.Top="920" Height="40">
                                        <TextBlock Text="11 PM" FontSize="11" Foreground="#666666" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                                        <Rectangle Height="1" Fill="#333333" Margin="45,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                </ItemsControl.Items>
                            </ItemsControl>

                            <!-- Event Block -->
                            <Canvas Grid.Row="1" Margin="45,10,0,0">
                                <Border Canvas.Top="{Binding EventTopPosition}"
                                        Width="230"
                                        Height="{Binding EventHeight}"
                                        Background="#4CAF50"
                                        CornerRadius="4"
                                        Padding="8,6">
                                    <!-- Time text -->
                                    <TextBlock Text="{Binding EventTimeRange}"
                                              FontSize="12"
                                              FontWeight="Medium"
                                              Foreground="#FFFFFF"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                                </Border>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

<Window x:Class="JubileeOutlook.Views.AuthenticationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JubileeOutlook - Sign In"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#000000">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Colors -->
            <Color x:Key="GoldColor">#FFD700</Color>
            <Color x:Key="GoldHoverColor">#FFDF40</Color>
            <SolidColorBrush x:Key="GoldBrush" Color="#FFD700"/>
            <SolidColorBrush x:Key="GoldHoverBrush" Color="#FFDF40"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0D0D0D"/>
            <SolidColorBrush x:Key="InputBorderBrush" Color="#333333"/>
            <SolidColorBrush x:Key="TextGrayBrush" Color="#808080"/>
            <SolidColorBrush x:Key="TextLightGrayBrush" Color="#B0B0B0"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#E53935"/>
            <SolidColorBrush x:Key="BlueBrush" Color="#0078D4"/>
            <SolidColorBrush x:Key="BlueHoverBrush" Color="#1084D9"/>

            <!-- Tab Button Style -->
            <Style x:Key="TabButtonStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextGrayBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoMedium}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0,0,0,2"
                                    BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Input TextBox Style -->
            <Style x:Key="AuthInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="CaretBrush" Value="#FFFFFF"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldHoverBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Password Box Style -->
            <Style x:Key="AuthPasswordStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="CaretBrush" Value="#FFFFFF"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldHoverBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Gold Button Style -->
            <Style x:Key="GoldPillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
                <Setter Property="Foreground" Value="#000000"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoMedium}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="32,12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="28"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource GoldHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E5C100"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#8B7500"/>
                                    <Setter Property="Foreground" Value="#4D4D4D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Blue Button Style (for Sync Tab) -->
            <Style x:Key="BluePillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoMedium}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="32,12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource BlueHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#006CBE"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#4D4D4D"/>
                                    <Setter Property="Foreground" Value="#808080"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Link Text Style -->
            <Style x:Key="GoldLinkStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="TextDecorations" Value="Underline"/>
                        <Setter Property="Foreground" Value="{StaticResource GoldHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Blue Link Style -->
            <Style x:Key="BlueLinkStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="TextDecorations" Value="Underline"/>
                        <Setter Property="Foreground" Value="{StaticResource BlueHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Checkbox Style -->
            <Style x:Key="GoldCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextLightGrayBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="checkBorder"
                                        Width="20"
                                        Height="20"
                                        Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,10,0">
                                    <TextBlock x:Name="checkMark"
                                               Text="&#xe5ca;"
                                               FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="16"
                                               Foreground="{StaticResource GoldBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                    <Setter TargetName="checkBorder" Property="Background" Value="#1A1A00"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Password Toggle Button Style (no hover background) -->
            <Style x:Key="PasswordToggleButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Window Control Button Style -->
            <Style x:Key="WindowControlButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#333333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Email Provider Icon Style -->
            <Style x:Key="ProviderIconBorderStyle" TargetType="Border">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Margin" Value="6,0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <!-- Dark Theme ComboBox Toggle Button -->
            <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Border"
                            Grid.ColumnSpan="2"
                            Background="#0D0D0D"
                            BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="1"
                            CornerRadius="8"/>
                    <Border Grid.Column="0"
                            Background="Transparent"
                            CornerRadius="8,0,0,8"/>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          Fill="{StaticResource GoldBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M0,0 L4,4 L8,0 Z"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource GoldHoverBrush}"/>
                        <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource GoldHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource GoldHoverBrush}"/>
                        <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- Dark Theme ComboBox TextBox -->
            <ControlTemplate x:Key="DarkComboBoxTextBox" TargetType="TextBox">
                <Border x:Name="PART_ContentHost"
                        Focusable="False"
                        Background="Transparent"/>
            </ControlTemplate>

            <!-- Dark Theme ComboBox Style -->
            <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="#0D0D0D"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              Template="{StaticResource DarkComboBoxToggleButton}"
                                              Grid.Column="2"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="16,0,32,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <TextBox x:Name="PART_EditableTextBox"
                                         Style="{x:Null}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center"
                                         Margin="16,0,32,0"
                                         Focusable="True"
                                         Background="Transparent"
                                         Foreground="#FFFFFF"
                                         CaretBrush="#FFFFFF"
                                         BorderThickness="0"
                                         FontFamily="{StaticResource RobotoRegular}"
                                         FontSize="14"
                                         Visibility="Hidden"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid x:Name="DropDown"
                                          SnapsToDevicePixels="True"
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border x:Name="DropDownBorder"
                                                Background="#0D0D0D"
                                                BorderBrush="{StaticResource GoldBrush}"
                                                BorderThickness="1"
                                                CornerRadius="0,0,8,8"
                                                Margin="0,-1,0,0">
                                            <ScrollViewer Margin="4,6,4,6"
                                                          SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True"
                                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                                </Trigger>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter Property="IsTabStop" Value="False"/>
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#0D0D0D"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="0"
                                                CornerRadius="4">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2A2A00"/>
                                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1A1A00"/>
                                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Themed Scrollbar Thumb Style -->
            <Style x:Key="GoldScrollBarThumb" TargetType="Thumb">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="thumbBorder"
                                    Background="#4D4D4D"
                                    CornerRadius="3"
                                    Margin="1"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="thumbBorder" Property="Background" Value="#FFD700"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="thumbBorder" Property="Background" Value="#FFDF40"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Themed Vertical ScrollBar Style -->
            <Style x:Key="GoldScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Border Background="#1A1A1A" CornerRadius="4"/>
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource GoldScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Themed ScrollViewer Style for Auth Card -->
            <Style x:Key="GoldScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollContentPresenter Grid.Column="0"
                                                        Margin="{TemplateBinding Padding}"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Column="1"
                                           Style="{StaticResource GoldScrollBarStyle}"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                           Margin="4,0,0,0"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Window Chrome for proper resize behavior -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Main Layout -->
    <Grid Background="#000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="#0D0D0D"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <!-- App Title on Left -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <TextBlock Text="Jubilee"
                               FontFamily="{StaticResource RobotoMedium}"
                               FontSize="14"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Outlook"
                               FontFamily="{StaticResource RobotoMedium}"
                               FontSize="14"
                               Foreground="{StaticResource GoldBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Controls on Right -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowControlButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize">
                        <TextBlock Text="&#xe15b;"
                                   FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="18"
                                   Foreground="#808080"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="MaximizeRestoreButton_Click"
                            ToolTip="Restore">
                        <TextBlock x:Name="MaximizeRestoreIcon"
                                   Text="&#xe5d1;"
                                   FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="18"
                                   Foreground="#808080"/>
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <TextBlock Text="&#xe5cd;"
                                   FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="18"
                                   Foreground="#808080"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Background="#000000">

        <!-- Loading Overlay (covers entire content area when preparing MainWindow) -->
        <Border x:Name="PreparingMainWindowOverlay"
                Background="#000000"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <!-- Spinner animation -->
                <Border Width="60" Height="60"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="#FFD700"/>
                    </Border.Effect>
                    <Border x:Name="SpinnerBorder"
                            Width="60" Height="60"
                            BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="3"
                            CornerRadius="30">
                        <Border.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" CenterX="30" CenterY="30"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="SpinnerRotation"
                                            Storyboard.TargetProperty="Angle"
                                            From="0" To="360"
                                            Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <!-- Inner circle for visual effect -->
                        <Ellipse Width="20" Height="20"
                                 Fill="{StaticResource GoldBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="0,-2,0,0"/>
                    </Border>
                </Border>
                <TextBlock x:Name="PreparingStatusText"
                           Text="Preparing your mailbox..."
                           Foreground="#FFFFFF"
                           FontFamily="{StaticResource RobotoMedium}"
                           FontSize="18"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="This will only take a moment"
                           Foreground="{StaticResource TextGrayBrush}"
                           FontFamily="{StaticResource RobotoRegular}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Centered Authentication Card -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource GoldBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Width="480"
                MaxHeight="780"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.4" Color="#FFD700"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tab Header (Hidden - reserved for future use) -->
                <Border Grid.Row="0"
                        Background="#0D0D0D"
                        CornerRadius="16,16,0,0"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,5">
                        <RadioButton x:Name="SyncEmailTab"
                                     Content="Sync Existing Email"
                                     Style="{StaticResource TabButtonStyle}"
                                     IsChecked="True"
                                     Checked="SyncEmailTab_Checked"
                                     GroupName="AuthTabs"/>
                        <RadioButton x:Name="LoginEmailTab"
                                     Content="Login Email"
                                     Style="{StaticResource TabButtonStyle}"
                                     Checked="LoginEmailTab_Checked"
                                     GroupName="AuthTabs"/>
                    </StackPanel>
                </Border>

                <!-- Tab Content -->
                <ScrollViewer Grid.Row="1"
                              Style="{StaticResource GoldScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="40,30,40,35">

                        <!-- ==================== SYNC EXISTING EMAIL TAB ==================== -->
                        <StackPanel x:Name="SyncEmailPanel" Visibility="Visible">

                            <!-- Jubilee Avatar with Gold Glow (matches Login Email avatar style) -->
                            <Border Width="100" Height="100"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="#FFD700"/>
                                </Border.Effect>
                                <Ellipse Width="100" Height="100"
                                         Stroke="{StaticResource GoldBrush}"
                                         StrokeThickness="2">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/Resources/Icons/jubilee-profile.png"
                                                    Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Border>

                            <!-- Title -->
                            <TextBlock Text="Add all your email accounts"
                                       FontFamily="{StaticResource RobotoMedium}"
                                       FontSize="24"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>

                            <!-- Subtitle -->
                            <TextBlock Text="Sync your existing email accounts with JubileeOutlook"
                                       FontFamily="{StaticResource RobotoRegular}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextGrayBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,0,0,25"/>

                            <!-- Email Provider Icons Row - Gold Theme -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,15">
                                <!-- Outlook Icon -->
                                <Border Width="44" Height="44" CornerRadius="8" Margin="6,0"
                                        Background="#1A1A00" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1"
                                        ToolTip="Microsoft 365" Cursor="Hand">
                                    <TextBlock Text="&#xe158;"
                                               FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="24"
                                               Foreground="{StaticResource GoldBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <!-- Gmail Icon -->
                                <Border Width="44" Height="44" CornerRadius="8" Margin="6,0"
                                        Background="#1A1A00" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1"
                                        ToolTip="Gmail" Cursor="Hand">
                                    <TextBlock Text="M"
                                               FontFamily="{StaticResource RobotoMedium}"
                                               FontSize="20"
                                               Foreground="{StaticResource GoldBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <!-- Yahoo Icon -->
                                <Border Width="44" Height="44" CornerRadius="8" Margin="6,0"
                                        Background="#1A1A00" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1"
                                        ToolTip="Yahoo" Cursor="Hand">
                                    <TextBlock Text="Y!"
                                               FontFamily="{StaticResource RobotoMedium}"
                                               FontSize="18"
                                               Foreground="{StaticResource GoldBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <!-- iCloud Icon -->
                                <Border Width="44" Height="44" CornerRadius="8" Margin="6,0"
                                        Background="#1A1A00" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1"
                                        ToolTip="iCloud" Cursor="Hand">
                                    <TextBlock Text="&#xe2c3;"
                                               FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="24"
                                               Foreground="{StaticResource GoldBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <!-- Generic Email Icon -->
                                <Border Width="44" Height="44" CornerRadius="8" Margin="6,0"
                                        Background="#1A1A00" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1"
                                        ToolTip="IMAP/POP" Cursor="Hand">
                                    <TextBlock Text="&#xe0e1;"
                                               FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="24"
                                               Foreground="{StaticResource GoldBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Description - 2 lines -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,5">
                                <TextBlock Text="JubileeOutlook supports Microsoft 365, Gmail,"
                                           FontFamily="{StaticResource RobotoRegular}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextGrayBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock Text="Yahoo, iCloud, IMAP, and POP."
                                           FontFamily="{StaticResource RobotoRegular}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextGrayBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>

                            <!-- Learn More Link - Gold Theme -->
                            <TextBlock x:Name="LearnMoreLink"
                                       Text="Learn More"
                                       Style="{StaticResource GoldLinkStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,30"
                                       MouseLeftButtonUp="LearnMoreLink_Click"/>

                            <!-- Suggested accounts label -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Suggested accounts"
                                           FontFamily="{StaticResource RobotoRegular}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextLightGrayBrush}"/>
                                <TextBlock Text=" &#xe88e;"
                                           FontFamily="{StaticResource MaterialIcons}"
                                           FontSize="14"
                                           Foreground="{StaticResource TextGrayBrush}"
                                           VerticalAlignment="Center"
                                           ToolTip="Email accounts detected on this device"
                                           Cursor="Help"/>
                            </StackPanel>

                            <!-- Email Dropdown - Dark Theme with detected accounts -->
                            <ComboBox x:Name="SyncEmailComboBox"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                      IsEditable="True"
                                      Margin="0,0,0,6"
                                      SelectionChanged="SyncEmailComboBox_SelectionChanged"/>

                            <!-- No account link - Gold Theme -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,30">
                                <TextBlock Text="No account? "
                                           FontFamily="{StaticResource RobotoRegular}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextGrayBrush}"/>
                                <TextBlock x:Name="CreateOutlookAccountLink"
                                           Text="Create a JubileeOutlook account"
                                           Style="{StaticResource GoldLinkStyle}"
                                           MouseLeftButtonUp="CreateOutlookAccountLink_Click"/>
                            </StackPanel>

                            <!-- Continue Button - Gold Theme (matches Login Email style) -->
                            <Button x:Name="SyncContinueButton"
                                    Content="Continue"
                                    Style="{StaticResource GoldPillButtonStyle}"
                                    Click="SyncContinueButton_Click"
                                    Height="46"
                                    HorizontalAlignment="Stretch"/>

                            <!-- Sync Loading Indicator -->
                            <StackPanel x:Name="SyncLoadingPanel"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        Margin="0,20,0,0">
                                <ProgressBar IsIndeterminate="True"
                                             Height="3"
                                             Width="200"
                                             Margin="0,0,0,10"
                                             Background="#333333"
                                             Foreground="{StaticResource GoldBrush}"/>
                                <TextBlock x:Name="SyncStatusText"
                                           Text="Connecting..."
                                           Foreground="{StaticResource TextLightGrayBrush}"
                                           FontFamily="{StaticResource RobotoRegular}"
                                           FontSize="13"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Footer (matches Login Email tab) -->
                            <TextBlock Text="© 2026 Jubilee Software, Inc."
                                       Foreground="#404040"
                                       FontFamily="{StaticResource RobotoRegular}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,35,0,0"/>
                        </StackPanel>

                        <!-- ==================== LOGIN EMAIL TAB ==================== -->
                        <StackPanel x:Name="LoginEmailPanel" Visibility="Collapsed">

                            <!-- Avatar with Glow -->
                            <Border Width="100" Height="100"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="#FFD700"/>
                                </Border.Effect>
                                <Ellipse Width="100" Height="100"
                                         Stroke="{StaticResource GoldBrush}"
                                         StrokeThickness="2">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/Resources/Icons/jubilee-profile.png"
                                                    Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Border>

                            <!-- Branding: JubileeOutlook -->
                            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Run Text="Jubilee" FontFamily="{StaticResource RobotoMedium}"
                                     FontSize="32" Foreground="#FFFFFF"/>
                                <Run Text="Outlook" FontFamily="{StaticResource RobotoLight}"
                                     FontSize="32" Foreground="{StaticResource GoldBrush}"/>
                            </TextBlock>

                            <!-- Subtitle - changes based on current panel -->
                            <TextBlock x:Name="SubtitleText"
                                       Text="Sign in to sync your email across devices"
                                       Foreground="{StaticResource TextGrayBrush}"
                                       FontFamily="{StaticResource RobotoRegular}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,0,0,20"/>

                            <!-- Navigation Link - changes based on current panel -->
                            <StackPanel x:Name="SignUpLinkPanel"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,30">
                                <TextBlock Text="Don't have an account? "
                                           Foreground="{StaticResource TextGrayBrush}"
                                           FontFamily="{StaticResource RobotoRegular}"
                                           FontSize="13"/>
                                <TextBlock x:Name="SignUpLink"
                                           Text="Sign Up."
                                           Style="{StaticResource GoldLinkStyle}"
                                           MouseLeftButtonUp="SignUpLink_Click"/>
                            </StackPanel>

                            <!-- Sign In Panel -->
                            <StackPanel x:Name="SignInPanel">
                                <!-- Email Field with Placeholder -->
                                <Grid Margin="0,0,0,6">
                                    <TextBox x:Name="EmailTextBox"
                                             Style="{StaticResource AuthInputStyle}"
                                             KeyDown="Input_KeyDown"
                                             TextChanged="EmailTextBox_TextChanged"
                                             GotFocus="EmailTextBox_GotFocus"
                                             LostFocus="EmailTextBox_LostFocus"/>
                                    <TextBlock x:Name="EmailPlaceholder"
                                               Text="Email"
                                               Foreground="#606060"
                                               FontFamily="{StaticResource RobotoRegular}"
                                               FontSize="14"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="18,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="EmailErrorText"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontSize="11"
                                           Margin="4,0,0,10"
                                           Visibility="Collapsed"/>

                                <!-- Password Field with Placeholder and Toggle -->
                                <Grid Margin="0,0,0,6">
                                    <PasswordBox x:Name="PasswordBox"
                                                 Style="{StaticResource AuthPasswordStyle}"
                                                 KeyDown="Input_KeyDown"
                                                 PasswordChanged="PasswordBox_PasswordChanged"
                                                 GotFocus="PasswordBox_GotFocus"
                                                 LostFocus="PasswordBox_LostFocus"/>
                                    <TextBox x:Name="PasswordTextBox"
                                             Style="{StaticResource AuthInputStyle}"
                                             Visibility="Collapsed"
                                             KeyDown="Input_KeyDown"
                                             GotFocus="PasswordTextBox_GotFocus"
                                             LostFocus="PasswordTextBox_LostFocus"/>
                                    <TextBlock x:Name="PasswordPlaceholder"
                                               Text="Password"
                                               Foreground="#606060"
                                               FontFamily="{StaticResource RobotoRegular}"
                                               FontSize="14"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="18,0,0,0"/>
                                    <Button x:Name="TogglePasswordButton"
                                            Style="{StaticResource PasswordToggleButtonStyle}"
                                            Click="TogglePassword_Click"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            Width="32" Height="32">
                                        <TextBlock x:Name="PasswordVisibilityIcon"
                                                   Text="&#xe8f4;"
                                                   FontFamily="{StaticResource MaterialIcons}"
                                                   FontSize="20"
                                                   Foreground="#606060"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="PasswordErrorText"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontSize="11"
                                           Margin="4,0,0,10"
                                           Visibility="Collapsed"/>

                                <!-- Remember Me & Forgot Password Row -->
                                <Grid Margin="0,8,0,30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox x:Name="RememberMeCheckBox"
                                              Content="Keep me signed in"
                                              IsChecked="True"
                                              Style="{StaticResource GoldCheckBoxStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               x:Name="ForgotPasswordLink"
                                               Text="Forgot Password?"
                                               Style="{StaticResource GoldLinkStyle}"
                                               MouseLeftButtonUp="ForgotPassword_Click"/>
                                </Grid>

                                <!-- Sign In Button -->
                                <Button x:Name="SignInButton"
                                        Content="Sign In"
                                        Style="{StaticResource GoldPillButtonStyle}"
                                        Click="SignInButton_Click"
                                        Height="46"
                                        HorizontalAlignment="Stretch"/>

                                <!-- Loading Indicator -->
                                <StackPanel x:Name="LoadingPanel"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Center"
                                            Margin="0,20,0,0">
                                    <TextBlock Text="Signing in..."
                                               Foreground="{StaticResource TextLightGrayBrush}"
                                               FontFamily="{StaticResource RobotoRegular}"
                                               FontSize="13"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Sign Up Panel (Initially Hidden) -->
                            <StackPanel x:Name="SignUpPanel" Visibility="Collapsed">
                                <!-- Full Name Field with Placeholder -->
                                <Grid Margin="0,0,0,6">
                                    <TextBox x:Name="FullNameTextBox"
                                             Style="{StaticResource AuthInputStyle}"
                                             KeyDown="Input_KeyDown"
                                             TextChanged="FullNameTextBox_TextChanged"
                                             GotFocus="FullNameTextBox_GotFocus"
                                             LostFocus="FullNameTextBox_LostFocus"/>
                                    <TextBlock x:Name="FullNamePlaceholder"
                                               Text="Full Name"
                                               Foreground="#606060"
                                               FontFamily="{StaticResource RobotoRegular}"
                                               FontSize="14"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="18,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="FullNameErrorText"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontFamily="{StaticResource RobotoRegular}"
                                           FontSize="11"
                                           Margin="4,2,0,8"
                                           Visibility="Collapsed"/>

                                <!-- Email Field with Placeholder -->
                                <Grid Margin="0,0,0,6">
                                    <TextBox x:Name="SignUpEmailTextBox"
                                             Style="{StaticResource AuthInputStyle}"
                                             KeyDown="Input_KeyDown"
                                             TextChanged="SignUpEmailTextBox_TextChanged"
                                             GotFocus="SignUpEmailTextBox_GotFocus"
                                             LostFocus="SignUpEmailTextBox_LostFocus"/>
                                    <TextBlock x:Name="SignUpEmailPlaceholder"
                                               Text="Email"
                                               Foreground="#606060"
                                               FontFamily="{StaticResource RobotoRegular}"
                                               FontSize="14"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="18,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="SignUpEmailErrorText"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontFamily="{StaticResource RobotoRegular}"
                                           FontSize="11"
                                           Margin="4,2,0,8"
                                           Visibility="Collapsed"/>

                                <!-- Password Field with Placeholder and Toggle -->
                                <Grid Margin="0,0,0,6">
                                    <PasswordBox x:Name="SignUpPasswordBox"
                                                 Style="{StaticResource AuthPasswordStyle}"
                                                 KeyDown="Input_KeyDown"
                                                 PasswordChanged="SignUpPasswordBox_PasswordChanged"
                                                 GotFocus="SignUpPasswordBox_GotFocus"
                                                 LostFocus="SignUpPasswordBox_LostFocus"/>
                                    <TextBox x:Name="SignUpPasswordTextBox"
                                             Style="{StaticResource AuthInputStyle}"
                                             Visibility="Collapsed"
                                             KeyDown="Input_KeyDown"
                                             TextChanged="SignUpPasswordTextBox_TextChanged"/>
                                    <TextBlock x:Name="SignUpPasswordPlaceholder"
                                               Text="Password"
                                               Foreground="#606060"
                                               FontFamily="{StaticResource RobotoRegular}"
                                               FontSize="14"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="18,0,0,0"/>
                                    <Button x:Name="ToggleSignUpPasswordButton"
                                            Style="{StaticResource PasswordToggleButtonStyle}"
                                            Click="ToggleSignUpPassword_Click"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            Width="32" Height="32">
                                        <TextBlock x:Name="SignUpPasswordVisibilityIcon"
                                                   Text="&#xe8f4;"
                                                   FontFamily="{StaticResource MaterialIcons}"
                                                   FontSize="20"
                                                   Foreground="#606060"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="SignUpPasswordErrorText"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontFamily="{StaticResource RobotoRegular}"
                                           FontSize="11"
                                           Margin="4,2,0,8"
                                           Visibility="Collapsed"/>

                                <!-- Confirm Password Field with Placeholder and Toggle -->
                                <Grid Margin="0,0,0,6">
                                    <PasswordBox x:Name="ConfirmPasswordBox"
                                                 Style="{StaticResource AuthPasswordStyle}"
                                                 KeyDown="Input_KeyDown"
                                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                                 GotFocus="ConfirmPasswordBox_GotFocus"
                                                 LostFocus="ConfirmPasswordBox_LostFocus"/>
                                    <TextBox x:Name="ConfirmPasswordTextBox"
                                             Style="{StaticResource AuthInputStyle}"
                                             Visibility="Collapsed"
                                             KeyDown="Input_KeyDown"
                                             TextChanged="ConfirmPasswordTextBox_TextChanged"/>
                                    <TextBlock x:Name="ConfirmPasswordPlaceholder"
                                               Text="Confirm Password"
                                               Foreground="#606060"
                                               FontFamily="{StaticResource RobotoRegular}"
                                               FontSize="14"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="18,0,0,0"/>
                                    <Button x:Name="ToggleConfirmPasswordButton"
                                            Style="{StaticResource PasswordToggleButtonStyle}"
                                            Click="ToggleConfirmPassword_Click"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            Width="32" Height="32">
                                        <TextBlock x:Name="ConfirmPasswordVisibilityIcon"
                                                   Text="&#xe8f4;"
                                                   FontFamily="{StaticResource MaterialIcons}"
                                                   FontSize="20"
                                                   Foreground="#606060"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="ConfirmPasswordErrorText"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontFamily="{StaticResource RobotoRegular}"
                                           FontSize="11"
                                           Margin="4,2,0,12"
                                           Visibility="Collapsed"/>

                                <!-- Newsletter Checkbox -->
                                <CheckBox x:Name="NewsletterCheckBox"
                                          Content="Subscribe to newsletter"
                                          IsChecked="False"
                                          Style="{StaticResource GoldCheckBoxStyle}"
                                          Margin="0,8,0,25"/>

                                <!-- Sign Up Button -->
                                <Button x:Name="SignUpButton"
                                        Content="Sign Up"
                                        Style="{StaticResource GoldPillButtonStyle}"
                                        Click="SignUpButton_Click"
                                        Height="46"
                                        HorizontalAlignment="Stretch"/>

                                <!-- Sign Up Loading Indicator -->
                                <StackPanel x:Name="SignUpLoadingPanel"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Center"
                                            Margin="0,20,0,0">
                                    <TextBlock Text="Creating account..."
                                               Foreground="{StaticResource TextLightGrayBrush}"
                                               FontFamily="{StaticResource RobotoRegular}"
                                               FontSize="13"/>
                                </StackPanel>

                                <!-- Back to Sign In | Sync Existing -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,20,0,0">
                                    <TextBlock Text="Already have an account? "
                                               Foreground="{StaticResource TextGrayBrush}"
                                               FontFamily="{StaticResource RobotoRegular}"
                                               FontSize="13"/>
                                    <TextBlock Text="Sign In"
                                               Style="{StaticResource GoldLinkStyle}"
                                               MouseLeftButtonUp="BackToSignIn_Click"/>
                                    <TextBlock Text=" | "
                                               Foreground="{StaticResource TextGrayBrush}"
                                               FontFamily="{StaticResource RobotoRegular}"
                                               FontSize="13"/>
                                    <TextBlock Text="Sync Existing"
                                               Style="{StaticResource GoldLinkStyle}"
                                               MouseLeftButtonUp="GoToSyncExisting_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Forgot Password Panel (Initially Hidden) -->
                            <StackPanel x:Name="ForgotPasswordPanel" Visibility="Collapsed">
                                <TextBlock Text="Enter your email address and we'll send you a link to reset your password."
                                           Foreground="{StaticResource TextGrayBrush}"
                                           FontFamily="{StaticResource RobotoRegular}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,0,0,25"/>

                                <!-- Email Field -->
                                <TextBox x:Name="ForgotEmailTextBox"
                                         Style="{StaticResource AuthInputStyle}"
                                         Margin="0,0,0,25"
                                         KeyDown="Input_KeyDown"/>

                                <!-- Send Reset Link Button -->
                                <Button x:Name="SendResetButton"
                                        Content="Send Reset Link"
                                        Style="{StaticResource GoldPillButtonStyle}"
                                        Click="SendResetButton_Click"
                                        Height="46"
                                        HorizontalAlignment="Stretch"/>

                                <!-- Back to Sign In -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,20,0,0">
                                    <TextBlock x:Name="BackFromForgotLink"
                                               Text="Back to Sign In"
                                               Style="{StaticResource GoldLinkStyle}"
                                               MouseLeftButtonUp="BackToSignIn_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Footer -->
                            <TextBlock Text="© 2026 Jubilee Software, Inc."
                                       Foreground="#404040"
                                       FontFamily="{StaticResource RobotoRegular}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,35,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>

<Window x:Class="JubileeOutlook.Views.AuthenticationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JubileeOutlook - Sign In"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#000000">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Colors -->
            <Color x:Key="GoldColor">#FFD700</Color>
            <Color x:Key="GoldHoverColor">#FFDF40</Color>
            <SolidColorBrush x:Key="GoldBrush" Color="#FFD700"/>
            <SolidColorBrush x:Key="GoldHoverBrush" Color="#FFDF40"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0D0D0D"/>
            <SolidColorBrush x:Key="InputBorderBrush" Color="#333333"/>
            <SolidColorBrush x:Key="TextGrayBrush" Color="#808080"/>
            <SolidColorBrush x:Key="TextLightGrayBrush" Color="#B0B0B0"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#E53935"/>

            <!-- Input TextBox Style -->
            <Style x:Key="AuthInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="CaretBrush" Value="#FFFFFF"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldHoverBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Password Box Style -->
            <Style x:Key="AuthPasswordStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="CaretBrush" Value="#FFFFFF"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldHoverBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Gold Button Style -->
            <Style x:Key="GoldPillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
                <Setter Property="Foreground" Value="#000000"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoMedium}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="40,16"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="28"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource GoldHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E5C100"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#8B7500"/>
                                    <Setter Property="Foreground" Value="#4D4D4D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Link Text Style -->
            <Style x:Key="GoldLinkStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="TextDecorations" Value="Underline"/>
                        <Setter Property="Foreground" Value="{StaticResource GoldHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Checkbox Style -->
            <Style x:Key="GoldCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextLightGrayBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="checkBorder"
                                        Width="20"
                                        Height="20"
                                        Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,10,0">
                                    <TextBlock x:Name="checkMark"
                                               Text="&#xe5ca;"
                                               FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="16"
                                               Foreground="{StaticResource GoldBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                    <Setter TargetName="checkBorder" Property="Background" Value="#1A1A00"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Window Control Button Style -->
            <Style x:Key="WindowControlButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#333333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Window Chrome for proper resize behavior -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Main Layout -->
    <Grid Background="#000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="#0D0D0D"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <!-- App Title on Left -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <TextBlock Text="Jubilee"
                               FontFamily="{StaticResource RobotoMedium}"
                               FontSize="14"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Outlook"
                               FontFamily="{StaticResource RobotoMedium}"
                               FontSize="14"
                               Foreground="{StaticResource GoldBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Controls on Right -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowControlButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize">
                        <TextBlock Text="&#xe15b;"
                                   FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="18"
                                   Foreground="#808080"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="MaximizeRestoreButton_Click"
                            ToolTip="Restore">
                        <TextBlock x:Name="MaximizeRestoreIcon"
                                   Text="&#xe5d1;"
                                   FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="18"
                                   Foreground="#808080"/>
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <TextBlock Text="&#xe5cd;"
                                   FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="18"
                                   Foreground="#808080"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Background="#000000">

        <!-- Centered Authentication Card -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource GoldBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="40,35">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.4" Color="#FFD700"/>
            </Border.Effect>

            <StackPanel>
                <!-- Avatar with Glow -->
                <Border Width="100" Height="100"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="#FFD700"/>
                    </Border.Effect>
                    <Ellipse Width="100" Height="100"
                             Stroke="{StaticResource GoldBrush}"
                             StrokeThickness="2">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Resources/Icons/jubilee-profile.png"
                                        Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Border>

                <!-- Branding: JubileeOutlook -->
                <TextBlock HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Run Text="Jubilee" FontFamily="{StaticResource RobotoMedium}"
                         FontSize="32" Foreground="#FFFFFF" FontStyle="Italic"/>
                    <Run Text="Outlook" FontFamily="{StaticResource RobotoLight}"
                         FontSize="32" Foreground="{StaticResource GoldBrush}" FontStyle="Italic"/>
                </TextBlock>

                <!-- Subtitle -->
                <TextBlock Text="Sign in to sync your email across devices"
                           Foreground="{StaticResource TextGrayBrush}"
                           FontFamily="{StaticResource RobotoRegular}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Sign Up Link -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,30">
                    <TextBlock Text="Don't have an account? "
                               Foreground="{StaticResource TextGrayBrush}"
                               FontFamily="{StaticResource RobotoRegular}"
                               FontSize="13"/>
                    <TextBlock x:Name="SignUpLink"
                               Text="Sign Up."
                               Style="{StaticResource GoldLinkStyle}"
                               MouseLeftButtonUp="SignUpLink_Click"/>
                </StackPanel>

                <!-- Sign In Panel -->
                <StackPanel x:Name="SignInPanel">
                    <!-- Email Field -->
                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource AuthInputStyle}"
                             Margin="0,0,0,6"
                             KeyDown="Input_KeyDown"
                             TextChanged="EmailTextBox_TextChanged"/>
                    <TextBlock x:Name="EmailErrorText"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="11"
                               Margin="4,0,0,10"
                               Visibility="Collapsed"/>

                    <!-- Password Field with Toggle -->
                    <Grid Margin="0,0,0,6">
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource AuthPasswordStyle}"
                                     KeyDown="Input_KeyDown"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBox x:Name="PasswordTextBox"
                                 Style="{StaticResource AuthInputStyle}"
                                 Visibility="Collapsed"
                                 KeyDown="Input_KeyDown"/>
                        <Button x:Name="TogglePasswordButton"
                                Click="TogglePassword_Click"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Width="32" Height="32">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <TextBlock x:Name="PasswordIcon"
                                                   Text="&#xe8f4;"
                                                   FontFamily="{StaticResource MaterialIcons}"
                                                   FontSize="20"
                                                   Foreground="#606060"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PasswordIcon" Property="Foreground" Value="#909090"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="PasswordErrorText"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="11"
                               Margin="4,0,0,10"
                               Visibility="Collapsed"/>

                    <!-- Remember Me & Forgot Password Row -->
                    <Grid Margin="0,8,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="RememberMeCheckBox"
                                  Content="Keep me signed in"
                                  IsChecked="True"
                                  Style="{StaticResource GoldCheckBoxStyle}"/>

                        <TextBlock Grid.Column="1"
                                   x:Name="ForgotPasswordLink"
                                   Text="Forgot Password?"
                                   Style="{StaticResource GoldLinkStyle}"
                                   MouseLeftButtonUp="ForgotPassword_Click"/>
                    </Grid>

                    <!-- Sign In Button -->
                    <Button x:Name="SignInButton"
                            Content="Sign In"
                            Style="{StaticResource GoldPillButtonStyle}"
                            Click="SignInButton_Click"
                            Height="56"
                            HorizontalAlignment="Stretch"/>

                    <!-- Loading Indicator -->
                    <StackPanel x:Name="LoadingPanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <TextBlock Text="Signing in..."
                                   Foreground="{StaticResource TextLightGrayBrush}"
                                   FontFamily="{StaticResource RobotoRegular}"
                                   FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <!-- Sign Up Panel (Initially Hidden) -->
                <StackPanel x:Name="SignUpPanel" Visibility="Collapsed">
                    <!-- Full Name Field -->
                    <TextBox x:Name="FullNameTextBox"
                             Style="{StaticResource AuthInputStyle}"
                             Margin="0,0,0,6"
                             KeyDown="Input_KeyDown"
                             TextChanged="FullNameTextBox_TextChanged"/>
                    <TextBlock x:Name="FullNameErrorText"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="11"
                               Margin="4,0,0,10"
                               Visibility="Collapsed"/>

                    <!-- Email Field -->
                    <TextBox x:Name="SignUpEmailTextBox"
                             Style="{StaticResource AuthInputStyle}"
                             Margin="0,0,0,6"
                             KeyDown="Input_KeyDown"
                             TextChanged="SignUpEmailTextBox_TextChanged"/>
                    <TextBlock x:Name="SignUpEmailErrorText"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="11"
                               Margin="4,0,0,10"
                               Visibility="Collapsed"/>

                    <!-- Password Field -->
                    <PasswordBox x:Name="SignUpPasswordBox"
                                 Style="{StaticResource AuthPasswordStyle}"
                                 Margin="0,0,0,6"
                                 KeyDown="Input_KeyDown"
                                 PasswordChanged="SignUpPasswordBox_PasswordChanged"/>
                    <TextBlock x:Name="SignUpPasswordErrorText"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="11"
                               Margin="4,0,0,10"
                               Visibility="Collapsed"/>

                    <!-- Confirm Password Field -->
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Style="{StaticResource AuthPasswordStyle}"
                                 Margin="0,0,0,6"
                                 KeyDown="Input_KeyDown"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                    <TextBlock x:Name="ConfirmPasswordErrorText"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="11"
                               Margin="4,0,0,15"
                               Visibility="Collapsed"/>

                    <!-- Newsletter Checkbox -->
                    <CheckBox x:Name="NewsletterCheckBox"
                              Content="Subscribe to newsletter"
                              IsChecked="True"
                              Style="{StaticResource GoldCheckBoxStyle}"
                              Margin="0,0,0,25"/>

                    <!-- Sign Up Button -->
                    <Button x:Name="SignUpButton"
                            Content="Create Account"
                            Style="{StaticResource GoldPillButtonStyle}"
                            Click="SignUpButton_Click"
                            Height="56"
                            HorizontalAlignment="Stretch"/>

                    <!-- Back to Sign In -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <TextBlock Text="Already have an account? "
                                   Foreground="{StaticResource TextGrayBrush}"
                                   FontFamily="{StaticResource RobotoRegular}"
                                   FontSize="13"/>
                        <TextBlock x:Name="BackToSignInLink"
                                   Text="Sign In."
                                   Style="{StaticResource GoldLinkStyle}"
                                   MouseLeftButtonUp="BackToSignIn_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Forgot Password Panel (Initially Hidden) -->
                <StackPanel x:Name="ForgotPasswordPanel" Visibility="Collapsed">
                    <TextBlock Text="Enter your email address and we'll send you a link to reset your password."
                               Foreground="{StaticResource TextGrayBrush}"
                               FontFamily="{StaticResource RobotoRegular}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,25"/>

                    <!-- Email Field -->
                    <TextBox x:Name="ForgotEmailTextBox"
                             Style="{StaticResource AuthInputStyle}"
                             Margin="0,0,0,25"
                             KeyDown="Input_KeyDown"/>

                    <!-- Send Reset Link Button -->
                    <Button x:Name="SendResetButton"
                            Content="Send Reset Link"
                            Style="{StaticResource GoldPillButtonStyle}"
                            Click="SendResetButton_Click"
                            Height="56"
                            HorizontalAlignment="Stretch"/>

                    <!-- Back to Sign In -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <TextBlock x:Name="BackFromForgotLink"
                                   Text="Back to Sign In"
                                   Style="{StaticResource GoldLinkStyle}"
                                   MouseLeftButtonUp="BackToSignIn_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Footer -->
                <TextBlock Text="© 2025 Jubilee Software, Inc."
                           Foreground="#404040"
                           FontFamily="{StaticResource RobotoRegular}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,35,0,0"/>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>

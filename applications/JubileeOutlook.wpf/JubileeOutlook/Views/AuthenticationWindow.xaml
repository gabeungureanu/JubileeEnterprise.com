<Window x:Class="JubileeOutlook.Views.AuthenticationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JubileeOutlook - Sign In"
        Width="500"
        Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Password Box Style -->
            <Style x:Key="AuthPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="#252525"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#404040"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,14"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="CaretBrush" Value="#FFFFFF"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldBrandBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#505050"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- TextBox Style -->
            <Style x:Key="AuthTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#252525"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#404040"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,14"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="CaretBrush" Value="#FFFFFF"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldBrandBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#505050"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Gold Button Style -->
            <Style x:Key="GoldButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GoldBrandBrush}"/>
                <Setter Property="Foreground" Value="#000000"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoMedium}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="24,14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="25"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource GoldBrandHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E5A84D"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#666666"/>
                                    <Setter Property="Foreground" Value="#999999"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Link Button Style -->
            <Style x:Key="LinkButtonStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GoldBrandBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="TextDecorations" Value="Underline"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- CheckBox Style -->
            <Style x:Key="AuthCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="checkBorder"
                                        Width="20"
                                        Height="20"
                                        Background="#252525"
                                        BorderBrush="#404040"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,10,0">
                                    <TextBlock x:Name="checkMark"
                                               Text="&#xe5ca;"
                                               FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="16"
                                               Foreground="{StaticResource GoldBrandBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource GoldBrandBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="checkBorder" Property="BorderBrush" Value="#505050"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Main Container with Gold Border -->
    <Border Background="#1A1A1A"
            BorderBrush="{StaticResource GoldBrandBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Window Controls (Close, Minimize) -->
            <Grid Grid.Row="0" Margin="10,10,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Draggable Area -->
                <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                <!-- Window Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Click="MinimizeButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="32" Height="32"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                    <TextBlock Text="&#xe15b;"
                                               FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="18"
                                               Foreground="#808080"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#333333"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Click="CloseButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="32" Height="32"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                    <TextBlock Text="&#xe5cd;"
                                               FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="18"
                                               Foreground="#808080"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#E53935"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="50,10,50,40">

                    <!-- Logo/Avatar -->
                    <Ellipse Width="90" Height="90"
                             Stroke="{StaticResource GoldBrandBrush}"
                             StrokeThickness="2"
                             HorizontalAlignment="Center"
                             Margin="0,20,0,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Resources/Icons/jubilee-profile.png"
                                        Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Branding -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock HorizontalAlignment="Center">
                            <Run Text="Jubilee" FontFamily="{StaticResource RobotoMedium}"
                                 FontSize="28" Foreground="{StaticResource GoldBrandBrush}" FontStyle="Italic"/>
                            <Run Text="Outlook" FontFamily="{StaticResource RobotoLight}"
                                 FontSize="28" Foreground="#FFFFFF" FontStyle="Italic"/>
                        </TextBlock>
                        <TextBlock Text="Sign in to sync your email across devices"
                                   Foreground="#808080"
                                   FontFamily="{StaticResource RobotoRegular}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Sign Up Link -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,15,0,25">
                        <TextBlock Text="Don't have an account? "
                                   Foreground="#808080"
                                   FontFamily="{StaticResource RobotoRegular}"
                                   FontSize="13"/>
                        <TextBlock x:Name="SignUpLink"
                                   Text="Sign Up."
                                   Style="{StaticResource LinkButtonStyle}"
                                   MouseLeftButtonUp="SignUpLink_Click"/>
                    </StackPanel>

                    <!-- Sign In Panel -->
                    <StackPanel x:Name="SignInPanel">
                        <!-- Email Field -->
                        <TextBox x:Name="EmailTextBox"
                                 Style="{StaticResource AuthTextBoxStyle}"
                                 Tag="Email address"
                                 Margin="0,0,0,12"
                                 KeyDown="Input_KeyDown"/>

                        <!-- Password Field with Toggle -->
                        <Grid Margin="0,0,0,12">
                            <PasswordBox x:Name="PasswordBox"
                                         Style="{StaticResource AuthPasswordBoxStyle}"
                                         KeyDown="Input_KeyDown"/>
                            <Button x:Name="TogglePasswordButton"
                                    Click="TogglePassword_Click"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Width="32" Height="32">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <TextBlock x:Name="PasswordIcon"
                                                       Text="&#xe8f4;"
                                                       FontFamily="{StaticResource MaterialIcons}"
                                                       FontSize="20"
                                                       Foreground="#808080"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Remember Me & Forgot Password -->
                        <Grid Margin="0,5,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="RememberMeCheckBox"
                                      Content="Keep me signed in"
                                      IsChecked="True"
                                      Style="{StaticResource AuthCheckBoxStyle}"/>

                            <TextBlock Grid.Column="1"
                                       x:Name="ForgotPasswordLink"
                                       Text="Forgot Password?"
                                       Style="{StaticResource LinkButtonStyle}"
                                       MouseLeftButtonUp="ForgotPassword_Click"/>
                        </Grid>

                        <!-- Sign In Button -->
                        <Button x:Name="SignInButton"
                                Content="Sign In"
                                Style="{StaticResource GoldButtonStyle}"
                                Click="SignInButton_Click"
                                Height="50"/>

                        <!-- Loading Indicator -->
                        <StackPanel x:Name="LoadingPanel"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0">
                            <TextBlock Text="Signing in..."
                                       Foreground="#CCCCCC"
                                       FontFamily="{StaticResource RobotoRegular}"
                                       FontSize="13"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Sign Up Panel (Initially Hidden) -->
                    <StackPanel x:Name="SignUpPanel" Visibility="Collapsed">
                        <!-- Full Name Field -->
                        <TextBox x:Name="FullNameTextBox"
                                 Style="{StaticResource AuthTextBoxStyle}"
                                 Tag="Full Name"
                                 Margin="0,0,0,12"
                                 KeyDown="Input_KeyDown"/>

                        <!-- Email Field -->
                        <TextBox x:Name="SignUpEmailTextBox"
                                 Style="{StaticResource AuthTextBoxStyle}"
                                 Tag="Email address"
                                 Margin="0,0,0,12"
                                 KeyDown="Input_KeyDown"/>

                        <!-- Password Field -->
                        <PasswordBox x:Name="SignUpPasswordBox"
                                     Style="{StaticResource AuthPasswordBoxStyle}"
                                     Margin="0,0,0,12"
                                     KeyDown="Input_KeyDown"/>

                        <!-- Confirm Password Field -->
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Style="{StaticResource AuthPasswordBoxStyle}"
                                     Margin="0,0,0,15"
                                     KeyDown="Input_KeyDown"/>

                        <!-- Newsletter Checkbox -->
                        <CheckBox x:Name="NewsletterCheckBox"
                                  Content="Subscribe to newsletter"
                                  IsChecked="True"
                                  Style="{StaticResource AuthCheckBoxStyle}"
                                  Margin="0,0,0,25"/>

                        <!-- Sign Up Button -->
                        <Button x:Name="SignUpButton"
                                Content="Create Account"
                                Style="{StaticResource GoldButtonStyle}"
                                Click="SignUpButton_Click"
                                Height="50"/>

                        <!-- Back to Sign In -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0">
                            <TextBlock Text="Already have an account? "
                                       Foreground="#808080"
                                       FontFamily="{StaticResource RobotoRegular}"
                                       FontSize="13"/>
                            <TextBlock x:Name="BackToSignInLink"
                                       Text="Sign In."
                                       Style="{StaticResource LinkButtonStyle}"
                                       MouseLeftButtonUp="BackToSignIn_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Forgot Password Panel (Initially Hidden) -->
                    <StackPanel x:Name="ForgotPasswordPanel" Visibility="Collapsed">
                        <TextBlock Text="Enter your email address and we'll send you a link to reset your password."
                                   Foreground="#808080"
                                   FontFamily="{StaticResource RobotoRegular}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20"/>

                        <!-- Email Field -->
                        <TextBox x:Name="ForgotEmailTextBox"
                                 Style="{StaticResource AuthTextBoxStyle}"
                                 Tag="Email address"
                                 Margin="0,0,0,25"
                                 KeyDown="Input_KeyDown"/>

                        <!-- Send Reset Link Button -->
                        <Button x:Name="SendResetButton"
                                Content="Send Reset Link"
                                Style="{StaticResource GoldButtonStyle}"
                                Click="SendResetButton_Click"
                                Height="50"/>

                        <!-- Back to Sign In -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0">
                            <TextBlock x:Name="BackFromForgotLink"
                                       Text="Back to Sign In"
                                       Style="{StaticResource LinkButtonStyle}"
                                       MouseLeftButtonUp="BackToSignIn_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer -->
                    <TextBlock Text="&#x00A9; 2025 Jubilee Software, Inc."
                               Foreground="#505050"
                               FontFamily="{StaticResource RobotoRegular}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

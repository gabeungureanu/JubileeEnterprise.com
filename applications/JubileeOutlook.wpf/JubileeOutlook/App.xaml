<Application x:Class="JubileeOutlook.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JubileeOutlook"
             xmlns:helpers="clr-namespace:JubileeOutlook.Helpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent Ribbon Theme (load first) -->
                <ResourceDictionary Source="pack://application:,,,/Fluent;component/Themes/Generic.xaml"/>
                <!-- Dark Theme (override Fluent with dark colors) -->
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <helpers:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <helpers:ReadToWeightConverter x:Key="ReadToWeightConverter"/>
            <helpers:ListToStringConverter x:Key="ListToStringConverter"/>
            <helpers:FileSizeConverter x:Key="FileSizeConverter"/>
            <helpers:AppModuleToBoolConverter x:Key="AppModuleToBoolConverter"/>
            <helpers:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
            <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <helpers:EventTopPositionConverter x:Key="EventTopPositionConverter"/>
            <helpers:EventsByDateConverter x:Key="EventsByDateConverter"/>
            <helpers:IsTodayConverter x:Key="IsTodayConverter"/>
            <helpers:IsTodayToBackgroundConverter x:Key="IsTodayToBackgroundConverter"/>
            <helpers:IsTodayToForegroundConverter x:Key="IsTodayToForegroundConverter"/>
            <helpers:AddDaysConverter x:Key="AddDaysConverter"/>
            <helpers:DateToDayOfWeekConverter x:Key="DateToDayOfWeekConverter"/>
            <helpers:DateToDayNumberConverter x:Key="DateToDayNumberConverter"/>
            <helpers:IsCurrentMonthConverter x:Key="IsCurrentMonthConverter"/>
            <helpers:MiniCalendarDayForegroundConverter x:Key="MiniCalendarDayForegroundConverter"/>
            <helpers:MiniCalendarDayBackgroundConverter x:Key="MiniCalendarDayBackgroundConverter"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>

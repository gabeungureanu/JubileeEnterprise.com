<Application x:Class="JubileeMusic.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:JubileeMusic.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
            <converters:PlayPauseConverter x:Key="PlayPauseConverter"/>
            <converters:EnumToIntConverter x:Key="EnumToIntConverter"/>
            <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Suno-inspired dark theme color values (internal use only) -->
    <Color x:Key="PrimaryBackgroundColorValue">#0D0D0D</Color>
    <Color x:Key="SecondaryBackgroundColorValue">#1A1A1A</Color>
    <Color x:Key="TertiaryBackgroundColorValue">#262626</Color>
    <Color x:Key="CardBackgroundColorValue">#1F1F1F</Color>

    <Color x:Key="PrimaryTextColorValue">#FFFFFF</Color>
    <Color x:Key="SecondaryTextColorValue">#A0A0A0</Color>
    <Color x:Key="MutedTextColorValue">#666666</Color>

    <Color x:Key="AccentColorValue">#8B5CF6</Color>
    <Color x:Key="AccentHoverColorValue">#A78BFA</Color>
    <Color x:Key="AccentPressedColorValue">#7C3AED</Color>

    <Color x:Key="SuccessColorValue">#22C55E</Color>
    <Color x:Key="WarningColorValue">#F59E0B</Color>
    <Color x:Key="ErrorColorValue">#EF4444</Color>

    <Color x:Key="BorderColorValue">#333333</Color>
    <Color x:Key="DividerColorValue">#2A2A2A</Color>

    <!-- Named Brushes for internal style usage -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColorValue}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColorValue}"/>
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="{StaticResource TertiaryBackgroundColorValue}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColorValue}"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColorValue}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColorValue}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColorValue}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColorValue}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColorValue}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColorValue}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColorValue}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColorValue}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColorValue}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColorValue}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColorValue}"/>

    <!-- Convenience brush aliases matching view naming conventions -->
    <SolidColorBrush x:Key="BackgroundColor" Color="{StaticResource PrimaryBackgroundColorValue}"/>
    <SolidColorBrush x:Key="SurfaceColor" Color="{StaticResource SecondaryBackgroundColorValue}"/>
    <SolidColorBrush x:Key="TextColor" Color="{StaticResource PrimaryTextColorValue}"/>
    <SolidColorBrush x:Key="TextSecondaryColor" Color="{StaticResource SecondaryTextColorValue}"/>
    <SolidColorBrush x:Key="TextMutedColor" Color="{StaticResource MutedTextColorValue}"/>
    <SolidColorBrush x:Key="AccentColor" Color="{StaticResource AccentColorValue}"/>
    <SolidColorBrush x:Key="SuccessColor" Color="{StaticResource SuccessColorValue}"/>
    <SolidColorBrush x:Key="WarningColor" Color="{StaticResource WarningColorValue}"/>
    <SolidColorBrush x:Key="ErrorColor" Color="{StaticResource ErrorColorValue}"/>

</ResourceDictionary>

<UserControl x:Class="JubileeMusic.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource BackgroundColor}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Browser Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="&#x2190;"
                            Command="{Binding GoBackCommand}"
                            ToolTip="Go Back"
                            Width="32" Height="32" Margin="2"
                            Style="{StaticResource ModernButtonStyle}"/>
                    <Button Content="&#x2192;"
                            Command="{Binding GoForwardCommand}"
                            ToolTip="Go Forward"
                            Width="32" Height="32" Margin="2"
                            Style="{StaticResource ModernButtonStyle}"/>
                    <Button Content="&#x21BB;"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh"
                            Width="32" Height="32" Margin="2"
                            Style="{StaticResource ModernButtonStyle}"/>
                    <Button Content="&#x2302;"
                            Command="{Binding NavigateToSunoCommand}"
                            ToolTip="Go to Suno Home"
                            Width="32" Height="32" Margin="2"
                            Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>

                <!-- URL Display -->
                <Border Grid.Column="1"
                        Background="{DynamicResource BackgroundColor}"
                        CornerRadius="4"
                        Margin="8,0"
                        Padding="8,4">
                    <TextBlock Text="{Binding CurrentUrl}"
                               Foreground="{DynamicResource TextSecondaryColor}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Create"
                            Command="{Binding NavigateToCreateCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Width="80" Margin="4"/>
                    <Button Content="Login"
                            Command="{Binding AutoLoginCommand}"
                            Visibility="{Binding ShowLoginPrompt, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource ModernButtonStyle}"
                            Width="80" Margin="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 Browser -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WebView"
                          Source="https://suno.com"/>

            <!-- Loading Overlay -->
            <Border Background="#80000000"
                    Visibility="{Binding IsNavigating, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200" Height="4"
                                 Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource TextColor}"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Error Overlay -->
            <Border Background="#80000000"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource SurfaceColor}"
                        CornerRadius="8"
                        Padding="24"
                        MaxWidth="400"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Error"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ErrorColor}"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextColor}"
                                   Margin="0,8,0,16"/>
                        <Button Content="Dismiss"
                                Style="{StaticResource ModernButtonStyle}"
                                HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>

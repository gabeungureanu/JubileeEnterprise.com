<UserControl x:Class="JubileeMusic.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:local="clr-namespace:JubileeMusic.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource BackgroundColor}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Browser Toolbar (ultra compact) -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}" Padding="2,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="&#x2190;"
                            Command="{Binding GoBackCommand}"
                            ToolTip="Go Back"
                            Width="20" Height="20" Margin="1,0"
                            FontSize="10"
                            Style="{StaticResource ModernButtonStyle}"/>
                    <Button Content="&#x2192;"
                            Command="{Binding GoForwardCommand}"
                            ToolTip="Go Forward"
                            Width="20" Height="20" Margin="1,0"
                            FontSize="10"
                            Style="{StaticResource ModernButtonStyle}"/>
                    <Button Content="&#x21BB;"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh"
                            Width="20" Height="20" Margin="1,0"
                            FontSize="10"
                            Style="{StaticResource ModernButtonStyle}"/>
                    <Button Content="&#x2302;"
                            Command="{Binding NavigateToSunoCommand}"
                            ToolTip="Go to Suno Home"
                            Width="20" Height="20" Margin="1,0"
                            FontSize="10"
                            Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>

                <!-- Spacer (URL and Login removed but column kept for layout) -->
            </Grid>
        </Border>

        <!-- Main Content Area with ChatGPT Panel, WebView, and Creator Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ChatGptPanelColumn" Width="0"/>
                <ColumnDefinition x:Name="ChatGptSplitterColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="CreatorSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="CreatorPanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ChatGPT Panel (Left Side) -->
            <Border x:Name="ChatGptPanel"
                    Grid.Column="0"
                    Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ChatGPT Panel Header (X button only) -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BackgroundColor}"
                            Padding="6,3">
                        <Grid>
                            <Button HorizontalAlignment="Right"
                                    Content="&#x2715;"
                                    Command="{Binding ToggleChatGptPanelCommand}"
                                    ToolTip="Close ChatGPT Panel"
                                    Width="18" Height="18"
                                    FontSize="10"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondaryColor}"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- ChatGPT WebView -->
                    <wv2:WebView2 x:Name="ChatGptWebView"
                                  Grid.Row="1"/>
                </Grid>
            </Border>

            <!-- Resizable Splitter for ChatGPT Panel -->
            <GridSplitter x:Name="ChatGptSplitter"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          Cursor="SizeWE"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          DragCompleted="ChatGptSplitter_DragCompleted"/>

            <!-- WebView2 Browser (center - Suno) -->
            <Grid Grid.Column="2">
                <wv2:WebView2 x:Name="WebView"/>

                <!-- Loading Overlay -->
                <Border Background="#80000000"
                        Visibility="{Binding IsNavigating, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="200" Height="4"
                                     Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource TextColor}"
                                   Margin="0,16,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Error Overlay -->
                <Border Background="#80000000"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource SurfaceColor}"
                            CornerRadius="8"
                            Padding="24"
                            MaxWidth="400"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Error"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ErrorColor}"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}"
                                       Margin="0,8,0,16"/>
                            <Button Content="Dismiss"
                                    Command="{Binding DismissErrorCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- Creator Panel Splitter (for resizing panel width) -->
            <GridSplitter x:Name="CreatorPanelSplitter"
                          Grid.Column="3"
                          Width="5"
                          Background="#808080"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Cursor="SizeWE"
                          ShowsPreview="False"/>

            <!-- Creator Panel (Right Side - Pushes Content) -->
            <Border x:Name="CreatorPanel"
                    Grid.Column="4"
                    Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Panel Header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BackgroundColor}"
                            Padding="6,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Create Song"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="&#x2715;"
                                    Command="{Binding ToggleCreatorPanelCommand}"
                                    ToolTip="Close Panel"
                                    Width="18" Height="18"
                                    FontSize="10"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondaryColor}"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Panel Content -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="16">
                        <StackPanel>
                            <!-- Title Field (Optional) -->
                            <TextBlock Text="Title (Optional)"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="TitleTextBox"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Background="{DynamicResource BackgroundColor}"
                                     Foreground="{DynamicResource TextColor}"
                                     CaretBrush="{DynamicResource TextColor}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,8"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     GotFocus="TextBox_GotFocus"
                                     Margin="0,0,0,16"/>

                            <!-- Styles Field -->
                            <TextBlock Text="Styles"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="StylesTextBox"
                                     Text="{Binding MusicStyle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Background="{DynamicResource BackgroundColor}"
                                     Foreground="{DynamicResource TextColor}"
                                     CaretBrush="{DynamicResource TextColor}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,8"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="60"
                                     MaxHeight="120"
                                     GotFocus="TextBox_GotFocus"
                                     Margin="0,0,0,4"/>
                            <TextBlock Text="e.g., pop, rock ballad, acoustic folk, electronic"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedColor}"
                                       Margin="0,0,0,16"
                                       TextWrapping="Wrap"/>

                            <!-- Lyrics Field -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Lyrics"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Instrumental"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryColor}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <CheckBox IsChecked="{Binding IsInstrumental}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <!-- Resizable Lyrics Container -->
                            <Grid x:Name="LyricsContainer" Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="LyricsRowDefinition" Height="200" MinHeight="100"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBox x:Name="LyricsTextBox"
                                         Grid.Row="0"
                                         Text="{Binding Lyrics, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         Background="{DynamicResource BackgroundColor}"
                                         Foreground="{DynamicResource TextColor}"
                                         CaretBrush="{DynamicResource TextColor}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1"
                                         Padding="10,8"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Visible"
                                         HorizontalScrollBarVisibility="Disabled"
                                         GotFocus="TextBox_GotFocus">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstrumental}" Value="True">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Resize Gripper -->
                                <Thumb x:Name="LyricsResizeGripper"
                                       Grid.Row="1"
                                       Height="12"
                                       Cursor="SizeNS"
                                       DragDelta="LyricsResizeGripper_DragDelta"
                                       Background="Transparent">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Border Background="#808080"
                                                        Height="3"
                                                        Width="40"
                                                        CornerRadius="1.5"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                            <TextBlock Text="Enter your song lyrics or check Instrumental for no vocals. Drag the bar below the text area to resize."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedColor}"
                                       Margin="0,0,0,16"
                                       TextWrapping="Wrap"/>

                            <!-- Vocal Gender Field -->
                            <TextBlock Text="Vocal Gender"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="VocalGenderTextBox"
                                     Text="{Binding VocalGender, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Background="{DynamicResource BackgroundColor}"
                                     Foreground="{DynamicResource TextColor}"
                                     CaretBrush="{DynamicResource TextColor}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,8"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     GotFocus="TextBox_GotFocus"
                                     Margin="0,0,0,4"/>
                            <TextBlock Text="Male or Female - will auto-select in Suno"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedColor}"
                                       Margin="0,0,0,16"
                                       TextWrapping="Wrap"/>

                            <!-- Weirdness Field -->
                            <TextBlock Text="Weirdness"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="WeirdnessTextBox"
                                     Text="{Binding Weirdness, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Background="{DynamicResource BackgroundColor}"
                                     Foreground="{DynamicResource TextColor}"
                                     CaretBrush="{DynamicResource TextColor}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,8"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     GotFocus="TextBox_GotFocus"
                                     Margin="0,0,0,4"/>
                            <TextBlock Text="0-100% - sets the Weirdness slider in Suno"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedColor}"
                                       Margin="0,0,0,16"
                                       TextWrapping="Wrap"/>

                            <!-- Style Influence Field -->
                            <TextBlock Text="Style Influence"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="StyleInfluenceTextBox"
                                     Text="{Binding StyleInfluence, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Background="{DynamicResource BackgroundColor}"
                                     Foreground="{DynamicResource TextColor}"
                                     CaretBrush="{DynamicResource TextColor}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,8"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     GotFocus="TextBox_GotFocus"
                                     Margin="0,0,0,4"/>
                            <TextBlock Text="0-100% - sets the Style Influence slider in Suno"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedColor}"
                                       Margin="0,0,0,16"
                                       TextWrapping="Wrap"/>

                            <!-- Workspace Field -->
                            <TextBlock Text="Workspace"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="WorkspaceTextBox"
                                     Text="{Binding Workspace, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Background="{DynamicResource BackgroundColor}"
                                     Foreground="{DynamicResource TextColor}"
                                     CaretBrush="{DynamicResource TextColor}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,8"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     GotFocus="TextBox_GotFocus"
                                     Margin="0,0,0,4"/>
                            <TextBlock Text="Select or create a workspace to save your song"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedColor}"
                                       Margin="0,0,0,16"
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Panel Footer with Action Buttons -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource BackgroundColor}"
                            Padding="16,12">
                        <StackPanel>
                            <Button Content="Insert"
                                    Command="{Binding InsertIntoCreateFormCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Height="40"
                                    FontSize="14"
                                    Margin="0,0,0,8"/>
                            <Button Content="Reset"
                                    Command="{Binding ClearCreatorFieldsCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Height="36"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

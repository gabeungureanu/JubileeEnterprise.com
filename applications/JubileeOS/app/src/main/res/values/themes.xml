<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main JubileeOS Theme - Dark OLED Black -->
    <style name="Theme.JubileeOS" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorPrimary">#00D4FF</item>
        <item name="android:colorAccent">#FFD700</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!--
    Splash Screen Theme - JubileeTablet.com Branding
    For API < 31, uses standard Material theme with black background
    The system splash screen is minimal on older Android versions
    -->
    <style name="Theme.JubileeOS.Splash" parent="android:Theme.Material.NoActionBar">
        <!-- Window must be completely black -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- No title bar or action bar -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>

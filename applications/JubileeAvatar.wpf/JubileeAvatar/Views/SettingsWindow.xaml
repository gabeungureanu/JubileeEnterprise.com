<Window x:Class="JubileeAvatar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - Jubilee Avatar"
        Height="600" Width="500"
        Background="#0D1B2A"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Settings"
                   Foreground="#ECF0F1"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- API Keys Section -->
                <Border Background="#1B2838" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="API Keys"
                                   Foreground="#ECF0F1"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="OpenAI API Key"
                                   Foreground="#95A5A6"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="OpenAIKeyBox"
                                     Background="#2C3E50"
                                     Foreground="#ECF0F1"
                                     Padding="10,8"
                                     Margin="0,0,0,10"/>

                        <TextBlock Text="ElevenLabs API Key"
                                   Foreground="#95A5A6"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="ElevenLabsKeyBox"
                                     Background="#2C3E50"
                                     Foreground="#ECF0F1"
                                     Padding="10,8"
                                     Margin="0,0,0,10"/>

                        <TextBlock Text="D-ID API Key"
                                   Foreground="#95A5A6"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="DIDKeyBox"
                                     Background="#2C3E50"
                                     Foreground="#ECF0F1"
                                     Padding="10,8"
                                     Margin="0,0,0,10"/>

                        <TextBlock Text="HeyGen API Key (Optional)"
                                   Foreground="#95A5A6"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="HeyGenKeyBox"
                                     Background="#2C3E50"
                                     Foreground="#ECF0F1"
                                     Padding="10,8"/>
                    </StackPanel>
                </Border>

                <!-- Backend Settings -->
                <Border Background="#1B2838" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Backend Settings"
                                   Foreground="#ECF0F1"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Backend URL"
                                   Foreground="#95A5A6"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="BackendUrlBox"
                                 Background="#2C3E50"
                                 Foreground="#ECF0F1"
                                 Padding="10,8"
                                 Text="http://localhost:3950"
                                 Margin="0,0,0,10"/>

                        <CheckBox x:Name="UseWebSocketCheck"
                                  Content="Use WebSocket Connection"
                                  Foreground="#ECF0F1"
                                  IsChecked="True"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Timeout (seconds)"
                                   Foreground="#95A5A6"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TimeoutBox"
                                 Background="#2C3E50"
                                 Foreground="#ECF0F1"
                                 Padding="10,8"
                                 Text="30"
                                 Width="100"
                                 HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Avatar Settings -->
                <Border Background="#1B2838" CornerRadius="10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Avatar Settings"
                                   Foreground="#ECF0F1"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Avatar Provider"
                                   Foreground="#95A5A6"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="AvatarProviderCombo"
                                  Background="#2C3E50"
                                  Foreground="#ECF0F1"
                                  Padding="10,8"
                                  Margin="0,0,0,10">
                            <ComboBoxItem Content="D-ID" IsSelected="True"/>
                            <ComboBoxItem Content="HeyGen"/>
                        </ComboBox>

                        <TextBlock Text="Avatar ID"
                                   Foreground="#95A5A6"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="AvatarIdBox"
                                 Background="#2C3E50"
                                 Foreground="#ECF0F1"
                                 Padding="10,8"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="ElevenLabs Voice ID"
                                   Foreground="#95A5A6"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="VoiceIdBox"
                                 Background="#2C3E50"
                                 Foreground="#ECF0F1"
                                 Padding="10,8"
                                 Text="21m00Tcm4TlvDq8ikWAM"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Background="#34495E"
                    Foreground="White"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton"
                    Content="Save"
                    Background="#3498DB"
                    Foreground="White"
                    Padding="20,10"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

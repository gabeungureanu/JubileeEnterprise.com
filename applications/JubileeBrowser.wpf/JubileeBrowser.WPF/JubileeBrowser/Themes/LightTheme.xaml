<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Light Theme Colors ===== -->

    <!-- Primary Background Colors -->
    <Color x:Key="BgPrimaryColor">#f5f5f7</Color>
    <Color x:Key="BgSecondaryColor">#ffffff</Color>
    <Color x:Key="BgTertiaryColor">#e8e8ed</Color>
    <Color x:Key="BgCardColor">#ffffff</Color>
    <Color x:Key="BgTitleBarColor">#f0f0f5</Color>
    <Color x:Key="BgHoverColor">#e0e0e5</Color>
    <Color x:Key="BgActiveColor">#d0d0d8</Color>
    <Color x:Key="BgPressedColor">#c0c0c8</Color>
    <Color x:Key="BgInputColor">#ffffff</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#1a1a2e</Color>
    <Color x:Key="TextSecondaryColor">#5c5c6e</Color>
    <Color x:Key="TextMutedColor">#8a8a9a</Color>
    <Color x:Key="TextPlaceholderColor">#9a9aaa</Color>

    <!-- Accent Colors - Darker gold for better contrast on light backgrounds -->
    <Color x:Key="AccentColor">#dc3545</Color>
    <Color x:Key="JubileeAccentColor">#B8860B</Color>
    <Color x:Key="JubileeAccentHoverColor">#D4A017</Color>
    <Color x:Key="JubileeAccentPressedColor">#9A7209</Color>
    <Color x:Key="FocusBorderColor">#0078D4</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderColor">#d0d0d8</Color>
    <Color x:Key="BorderLightColor">#e0e0e8</Color>
    <Color x:Key="BorderDarkColor">#b0b0b8</Color>

    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#28a745</Color>
    <Color x:Key="WarningColor">#ffc107</Color>
    <Color x:Key="ErrorColor">#dc3545</Color>
    <Color x:Key="InfoColor">#17a2b8</Color>

    <!-- ===== SolidColorBrushes ===== -->

    <!-- Background Brushes -->
    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}"/>
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}"/>
    <SolidColorBrush x:Key="BgTertiaryBrush" Color="{StaticResource BgTertiaryColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgTitleBarBrush" Color="{StaticResource BgTitleBarColor}"/>
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}"/>
    <SolidColorBrush x:Key="BgActiveBrush" Color="{StaticResource BgActiveColor}"/>
    <SolidColorBrush x:Key="BgPressedBrush" Color="{StaticResource BgPressedColor}"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}"/>

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="{StaticResource TextPlaceholderColor}"/>

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="JubileeAccentBrush" Color="{StaticResource JubileeAccentColor}"/>
    <SolidColorBrush x:Key="JubileeAccentHoverBrush" Color="{StaticResource JubileeAccentHoverColor}"/>
    <SolidColorBrush x:Key="JubileeAccentPressedBrush" Color="{StaticResource JubileeAccentPressedColor}"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorderColor}"/>

    <!-- Border Brushes -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}"/>

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- Dialog-specific colors -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="DialogTitleBarBrush" Color="#f5f5f7"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#d0d0d8"/>
    <SolidColorBrush x:Key="DialogFooterBrush" Color="#f0f0f5"/>

    <!-- Button-specific colors -->
    <SolidColorBrush x:Key="ButtonSecondaryBgBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonSecondaryFgBrush" Color="#5c5c6e"/>
    <SolidColorBrush x:Key="ButtonSecondaryBorderBrush" Color="#c0c0c8"/>
    <SolidColorBrush x:Key="ButtonSecondaryHoverBgBrush" Color="#e8e8ed"/>

</ResourceDictionary>

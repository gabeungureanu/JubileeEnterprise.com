<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Dark Theme Colors ===== -->

    <!-- Primary Background Colors -->
    <Color x:Key="BgPrimaryColor">#1a1a2e</Color>
    <Color x:Key="BgSecondaryColor">#16213e</Color>
    <Color x:Key="BgTertiaryColor">#0f3460</Color>
    <Color x:Key="BgCardColor">#1c1c33</Color>
    <Color x:Key="BgTitleBarColor">#20203a</Color>
    <Color x:Key="BgHoverColor">#2a2a4e</Color>
    <Color x:Key="BgActiveColor">#3a3a5e</Color>
    <Color x:Key="BgPressedColor">#4a4a6e</Color>
    <Color x:Key="BgInputColor">#2a2a4e</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#ffffff</Color>
    <Color x:Key="TextSecondaryColor">#a0a0a0</Color>
    <Color x:Key="TextMutedColor">#6a6a7a</Color>
    <Color x:Key="TextPlaceholderColor">#9A9AAD</Color>

    <!-- Accent Colors -->
    <Color x:Key="AccentColor">#e94560</Color>
    <Color x:Key="JubileeAccentColor">#E6AC00</Color>
    <Color x:Key="JubileeAccentHoverColor">#F5C518</Color>
    <Color x:Key="JubileeAccentPressedColor">#CC9800</Color>
    <Color x:Key="FocusBorderColor">#5AC8FA</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderColor">#2a2a4e</Color>
    <Color x:Key="BorderLightColor">#3a3a5e</Color>
    <Color x:Key="BorderDarkColor">#1a1a2e</Color>

    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="WarningColor">#FF9800</Color>
    <Color x:Key="ErrorColor">#f44336</Color>
    <Color x:Key="InfoColor">#2196F3</Color>

    <!-- ===== SolidColorBrushes ===== -->

    <!-- Background Brushes -->
    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}"/>
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}"/>
    <SolidColorBrush x:Key="BgTertiaryBrush" Color="{StaticResource BgTertiaryColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgTitleBarBrush" Color="{StaticResource BgTitleBarColor}"/>
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}"/>
    <SolidColorBrush x:Key="BgActiveBrush" Color="{StaticResource BgActiveColor}"/>
    <SolidColorBrush x:Key="BgPressedBrush" Color="{StaticResource BgPressedColor}"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}"/>

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="{StaticResource TextPlaceholderColor}"/>

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="JubileeAccentBrush" Color="{StaticResource JubileeAccentColor}"/>
    <SolidColorBrush x:Key="JubileeAccentHoverBrush" Color="{StaticResource JubileeAccentHoverColor}"/>
    <SolidColorBrush x:Key="JubileeAccentPressedBrush" Color="{StaticResource JubileeAccentPressedColor}"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorderColor}"/>

    <!-- Border Brushes -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}"/>

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- Dialog-specific colors -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#1c1c33"/>
    <SolidColorBrush x:Key="DialogTitleBarBrush" Color="#20203a"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#2c2c4a"/>
    <SolidColorBrush x:Key="DialogFooterBrush" Color="#1a1a2e"/>

    <!-- Button-specific colors -->
    <SolidColorBrush x:Key="ButtonSecondaryBgBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonSecondaryFgBrush" Color="#C0C0D0"/>
    <SolidColorBrush x:Key="ButtonSecondaryBorderBrush" Color="#3a3a52"/>
    <SolidColorBrush x:Key="ButtonSecondaryHoverBgBrush" Color="#2a2a44"/>

</ResourceDictionary>

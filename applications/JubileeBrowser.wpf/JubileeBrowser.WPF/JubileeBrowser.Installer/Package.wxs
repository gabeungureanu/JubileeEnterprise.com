<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Jubilee Browser"
           Manufacturer="Jubilee Software, Inc."
           Version="8.0.8.0"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
           Compressed="yes"
           InstallerVersion="500"
           Scope="perMachine">

    <SummaryInformation Description="Jubilee Browser - A secure, family-friendly web browser by Jubilee Software, Inc." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Jubilee Browser is already installed."
                  AllowSameVersionUpgrades="no"
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Add/Remove Programs Icon -->
    <Icon Id="ProductIcon" SourceFile="$(var.SourceDir)Resources\Icons\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPHELPLINK" Value="https://jubileebrowser.com/support" />
    <Property Id="ARPURLINFOABOUT" Value="https://jubileebrowser.com" />
    <Property Id="ARPURLUPDATEINFO" Value="https://jubileebrowser.com/download.html" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Jubilee Browser">
        <Component Id="Shortcuts" Guid="12345678-1234-1234-1234-123456789ABC">
          <RegistryValue Root="HKCU" Key="Software\JubileeBrowser" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          <Shortcut Id="DesktopShortcut"
                    Name="Jubilee Browser"
                    Directory="DesktopFolder"
                    Target="[INSTALLFOLDER]JubileeBrowser.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.ico"
                    IconIndex="0" />
          <Shortcut Id="StartMenuShortcut"
                    Name="Jubilee Browser"
                    Directory="ProgramMenuFolder"
                    Target="[INSTALLFOLDER]JubileeBrowser.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.ico"
                    IconIndex="0" />
        </Component>

        <!-- Windows Default Apps Registration -->
        <Component Id="DefaultAppsRegistration" Guid="AABBCCDD-1234-5678-9ABC-DEF012345678">
          <RegistryKey Root="HKLM" Key="SOFTWARE\JubileeBrowser">
            <RegistryValue Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" />
          </RegistryKey>

          <!-- Register as a Windows Application in Default Apps -->
          <RegistryValue Root="HKLM" Key="SOFTWARE\RegisteredApplications" Name="JubileeBrowser" Type="string" Value="SOFTWARE\JubileeBrowser\Capabilities" KeyPath="yes" />

          <!-- Application Capabilities -->
          <RegistryKey Root="HKLM" Key="SOFTWARE\JubileeBrowser\Capabilities">
            <RegistryValue Name="ApplicationName" Type="string" Value="Jubilee Browser" />
            <RegistryValue Name="ApplicationDescription" Type="string" Value="A secure, family-friendly web browser by Jubilee Software, Inc." />
            <RegistryValue Name="ApplicationIcon" Type="string" Value="[INSTALLFOLDER]JubileeBrowser.exe,0" />
          </RegistryKey>

          <!-- URL Associations -->
          <RegistryKey Root="HKLM" Key="SOFTWARE\JubileeBrowser\Capabilities\URLAssociations">
            <RegistryValue Name="http" Type="string" Value="JubileeBrowserURL" />
            <RegistryValue Name="https" Type="string" Value="JubileeBrowserURL" />
            <RegistryValue Name="ftp" Type="string" Value="JubileeBrowserURL" />
          </RegistryKey>

          <!-- File Associations -->
          <RegistryKey Root="HKLM" Key="SOFTWARE\JubileeBrowser\Capabilities\FileAssociations">
            <RegistryValue Name=".htm" Type="string" Value="JubileeBrowserHTML" />
            <RegistryValue Name=".html" Type="string" Value="JubileeBrowserHTML" />
            <RegistryValue Name=".shtml" Type="string" Value="JubileeBrowserHTML" />
            <RegistryValue Name=".xht" Type="string" Value="JubileeBrowserHTML" />
            <RegistryValue Name=".xhtml" Type="string" Value="JubileeBrowserHTML" />
            <RegistryValue Name=".webp" Type="string" Value="JubileeBrowserHTML" />
            <RegistryValue Name=".svg" Type="string" Value="JubileeBrowserHTML" />
            <RegistryValue Name=".pdf" Type="string" Value="JubileeBrowserPDF" />
          </RegistryKey>

          <!-- ProgID for URL Handler -->
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\JubileeBrowserURL">
            <RegistryValue Type="string" Value="Jubilee Browser URL" />
            <RegistryValue Name="FriendlyTypeName" Type="string" Value="Jubilee Browser URL" />
            <RegistryValue Name="URL Protocol" Type="string" Value="" />
            <RegistryValue Name="EditFlags" Type="integer" Value="2" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\JubileeBrowserURL\DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]JubileeBrowser.exe,0" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\JubileeBrowserURL\shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]JubileeBrowser.exe&quot; &quot;%1&quot;" />
          </RegistryKey>

          <!-- ProgID for HTML files -->
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\JubileeBrowserHTML">
            <RegistryValue Type="string" Value="Jubilee Browser HTML Document" />
            <RegistryValue Name="FriendlyTypeName" Type="string" Value="Jubilee Browser HTML Document" />
            <RegistryValue Name="EditFlags" Type="integer" Value="2" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\JubileeBrowserHTML\DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]JubileeBrowser.exe,0" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\JubileeBrowserHTML\shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]JubileeBrowser.exe&quot; &quot;%1&quot;" />
          </RegistryKey>

          <!-- ProgID for PDF files -->
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\JubileeBrowserPDF">
            <RegistryValue Type="string" Value="Jubilee Browser PDF Document" />
            <RegistryValue Name="FriendlyTypeName" Type="string" Value="Jubilee Browser PDF Document" />
            <RegistryValue Name="EditFlags" Type="integer" Value="2" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\JubileeBrowserPDF\DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]JubileeBrowser.exe,0" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\JubileeBrowserPDF\shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]JubileeBrowser.exe&quot; &quot;%1&quot;" />
          </RegistryKey>

          <!-- Application Registration in App Paths -->
          <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\JubileeBrowser.exe">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]JubileeBrowser.exe" />
            <RegistryValue Name="Path" Type="string" Value="[INSTALLFOLDER]" />
          </RegistryKey>

          <!-- Start Menu Internet Registration (for browser selection) -->
          <RegistryKey Root="HKLM" Key="SOFTWARE\Clients\StartMenuInternet\JubileeBrowser">
            <RegistryValue Type="string" Value="Jubilee Browser" />
            <RegistryValue Name="LocalizedString" Type="string" Value="Jubilee Browser" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Clients\StartMenuInternet\JubileeBrowser\Capabilities">
            <RegistryValue Name="ApplicationName" Type="string" Value="Jubilee Browser" />
            <RegistryValue Name="ApplicationDescription" Type="string" Value="A secure, family-friendly web browser by Jubilee Software, Inc." />
            <RegistryValue Name="ApplicationIcon" Type="string" Value="[INSTALLFOLDER]JubileeBrowser.exe,0" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Clients\StartMenuInternet\JubileeBrowser\Capabilities\URLAssociations">
            <RegistryValue Name="http" Type="string" Value="JubileeBrowserURL" />
            <RegistryValue Name="https" Type="string" Value="JubileeBrowserURL" />
            <RegistryValue Name="ftp" Type="string" Value="JubileeBrowserURL" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Clients\StartMenuInternet\JubileeBrowser\Capabilities\FileAssociations">
            <RegistryValue Name=".htm" Type="string" Value="JubileeBrowserHTML" />
            <RegistryValue Name=".html" Type="string" Value="JubileeBrowserHTML" />
            <RegistryValue Name=".shtml" Type="string" Value="JubileeBrowserHTML" />
            <RegistryValue Name=".xht" Type="string" Value="JubileeBrowserHTML" />
            <RegistryValue Name=".xhtml" Type="string" Value="JubileeBrowserHTML" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Clients\StartMenuInternet\JubileeBrowser\Capabilities\StartMenu">
            <RegistryValue Name="StartMenuInternet" Type="string" Value="JubileeBrowser" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Clients\StartMenuInternet\JubileeBrowser\DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]JubileeBrowser.exe,0" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Clients\StartMenuInternet\JubileeBrowser\InstallInfo">
            <RegistryValue Name="IconsVisible" Type="integer" Value="1" />
            <RegistryValue Name="ShowIconsCommand" Type="string" Value="&quot;[INSTALLFOLDER]JubileeBrowser.exe&quot; --show-icons" />
            <RegistryValue Name="HideIconsCommand" Type="string" Value="&quot;[INSTALLFOLDER]JubileeBrowser.exe&quot; --hide-icons" />
            <RegistryValue Name="ReinstallCommand" Type="string" Value="&quot;[INSTALLFOLDER]JubileeBrowser.exe&quot; --make-default-browser" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Clients\StartMenuInternet\JubileeBrowser\shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]JubileeBrowser.exe&quot;" />
          </RegistryKey>

          <!-- Register in RegisteredApplications for StartMenuInternet -->
          <RegistryValue Root="HKLM" Key="SOFTWARE\RegisteredApplications" Name="JubileeBrowser.StartMenuInternet" Type="string" Value="SOFTWARE\Clients\StartMenuInternet\JubileeBrowser\Capabilities" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.SourceDir)Resources\Icons\icon.ico" />

    <Feature Id="MainFeature" Title="Jubilee Browser" Level="1">
      <ComponentRef Id="Shortcuts" />
      <ComponentRef Id="DefaultAppsRegistration" />
      <ComponentGroupRef Id="HarvestedFiles" />
    </Feature>

    <!-- License Agreement UI with custom sky blue banners -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />

    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Auto-launch Jubilee Browser after installation -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Jubilee Browser" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#JubileeBrowser.exe]" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_X64" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize" Condition="NOT Installed AND WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1" />
    </InstallExecuteSequence>

  </Package>
</Wix>
